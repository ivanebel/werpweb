<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1600px]">
      <%
        const rangeLabel = `${h.formatDate(range.from)} – ${h.formatDate(range.to)}`;
        const paymentLabel = (value) => t(h.humanize(value));
      %>

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= t('POS sales') %></h1>
          <p class="page-subtitle"><%= t('Manage completed sales from your shops. POS sales are reporting records and do not change inventory.') %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/pos/performance" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'chart', className: 'h-4 w-4' }) %>
            <%= t('Sales performance') %>
          </a>
          <a href="/pos/sales/new" class="btn btn-primary btn-sm">
            <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
            <%= t('New POS sale') %>
          </a>
        </div>
      </div>

      <form method="GET" action="/pos/sales" class="card mb-5 p-4 md:p-5">
        <div class="grid grid-cols-1 items-end gap-3 sm:grid-cols-2 xl:grid-cols-12">
          <div class="xl:col-span-2">
            <label for="from" class="form-label"><%= t('From') %></label>
            <input id="from" type="date" name="from" value="<%= range.from %>" class="form-input">
          </div>
          <div class="xl:col-span-2">
            <label for="to" class="form-label"><%= t('To') %></label>
            <input id="to" type="date" name="to" value="<%= range.to %>" class="form-input">
          </div>
          <div class="xl:col-span-3">
            <label for="pos" class="form-label"><%= t('Point of sale') %></label>
            <select id="pos" name="pos" class="form-select">
              <option value=""><%= t('All points of sale') %></option>
              <% locations.forEach(location => { %>
                <option value="<%= location.id %>" <%= Number(posId) === Number(location.id) ? 'selected' : '' %>><%= location.code %> · <%= location.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="xl:col-span-3">
            <label for="ticket_type" class="form-label"><%= t('Ticket type') %></label>
            <select id="ticket_type" name="ticket_type" class="form-select">
              <option value=""><%= t('All ticket types') %></option>
              <% ticketTypes.forEach(type => { %>
                <option value="<%= type %>" <%= activeTicketType === type ? 'selected' : '' %>><%= t(type) %></option>
              <% }) %>
            </select>
          </div>
          <div class="xl:col-span-2">
            <label for="q" class="form-label"><%= t('Search') %></label>
            <input id="q" type="search" name="q" value="<%= search %>" class="form-input" placeholder="<%= t('Ticket, customer or shop…') %>">
          </div>
          <div class="flex flex-wrap items-center gap-2 sm:col-span-2 xl:col-span-12">
            <button type="submit" class="btn btn-primary">
              <%- include('/partials/icon', { name: 'filter', className: 'h-4 w-4' }) %>
              <%= t('Apply') %>
            </button>
            <a href="/pos/sales" class="btn btn-secondary"><%= t('Reset') %></a>
            <span class="basis-full text-xs text-gray-400 xl:basis-auto"><%= rangeLabel %></span>
          </div>
        </div>
      </form>

      <div class="mb-5 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="card p-5">
          <p class="stat-label"><%= t('Revenue') %></p>
          <p class="mt-1 stat-value"><%= money(stats.revenue) %></p>
          <p class="mt-1 text-xs text-gray-400"><%= t('Tax included') %></p>
        </div>
        <div class="card p-5">
          <p class="stat-label"><%= t('Tickets') %></p>
          <p class="mt-1 stat-value"><%= h.formatNumber(stats.tickets, 0) %></p>
          <p class="mt-1 text-xs text-gray-400"><%= t('Completed sales') %></p>
        </div>
        <div class="card p-5">
          <p class="stat-label"><%= t('Units sold') %></p>
          <p class="mt-1 stat-value"><%= h.formatQty(stats.units) %></p>
          <p class="mt-1 text-xs text-gray-400"><%= t('Line quantities') %></p>
        </div>
        <div class="card p-5">
          <p class="stat-label"><%= t('Average ticket') %></p>
          <p class="mt-1 stat-value"><%= money(stats.avgTicket) %></p>
          <p class="mt-1 text-xs text-gray-400"><%= t('Revenue per ticket') %></p>
        </div>
      </div>

      <div class="card overflow-hidden">
        <div class="table-wrap">
          <table class="table-base min-w-[740px]">
            <thead>
              <tr>
                <th class="table-th"><%= t('Ticket') %></th>
                <th class="table-th hidden xl:table-cell"><%= t('Point of sale') %></th>
                <th class="table-th"><%= t('Date') %></th>
                <th class="table-th"><%= t('Type') %></th>
                <th class="table-th hidden 2xl:table-cell"><%= t('Customer') %></th>
                <th class="table-th hidden xl:table-cell"><%= t('Payment') %></th>
                <th class="table-th hidden text-right xl:table-cell"><%= t('Items') %></th>
                <th class="table-th hidden text-right xl:table-cell"><%= t('Units') %></th>
                <th class="table-th text-right"><%= t('Total') %></th>
                <th class="table-th text-right"><%= t('Actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(sale => { %>
                <tr class="table-row">
                  <td class="table-td whitespace-nowrap">
                    <a href="/pos/sales/<%= sale.id %>" class="link font-medium"><%= sale.ticket_number %></a>
                    <p class="mt-0.5 max-w-[220px] truncate text-xs text-gray-400 xl:hidden"><%= sale.pos_code %> · <%= sale.pos_name %></p>
                    <% if (sale.notes) { %><p class="mt-0.5 max-w-[220px] truncate text-xs text-gray-400"><%= sale.notes %></p><% } %>
                  </td>
                  <td class="table-td hidden xl:table-cell">
                    <p class="font-medium text-gray-800 dark:text-gray-200"><%= sale.pos_name %></p>
                    <p class="mt-0.5 text-xs text-gray-400"><%= sale.pos_code %></p>
                  </td>
                  <td class="table-td whitespace-nowrap text-gray-500 dark:text-gray-400"><%= h.formatDate(sale.sale_date) %></td>
                  <td class="table-td whitespace-nowrap"><span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-700 dark:bg-brand-500/15 dark:text-brand-300"><%= t(sale.ticket_type) %></span></td>
                  <td class="table-td hidden text-gray-500 dark:text-gray-400 2xl:table-cell"><%= sale.customer_name || t('Walk-in customer') %></td>
                  <td class="table-td hidden text-gray-500 dark:text-gray-400 xl:table-cell"><%= paymentLabel(sale.payment_method) %></td>
                  <td class="table-td hidden text-right xl:table-cell"><%= h.formatNumber(sale.item_count, 0) %></td>
                  <td class="table-td hidden text-right xl:table-cell"><%= h.formatQty(sale.units) %></td>
                  <td class="table-td whitespace-nowrap text-right font-medium"><%= money(sale.total) %></td>
                  <td class="table-td whitespace-nowrap">
                    <div class="flex items-center justify-end gap-1">
                      <a href="/pos/sales/<%= sale.id %>" class="btn-icon" title="<%= t('View') %>">
                        <%- include('/partials/icon', { name: 'eye', className: 'h-4 w-4' }) %>
                      </a>
                      <a href="/pos/sales/<%= sale.id %>/edit" class="btn-icon" title="<%= t('Edit') %>">
                        <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %>
                      </a>
                      <form method="POST" action="/pos/sales/<%= sale.id %>/delete" class="inline" data-confirm="<%= t('Delete this POS sale? This cannot be undone.') %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-icon text-error-500 hover:bg-error-50 dark:text-error-400 dark:hover:bg-error-500/10" title="<%= t('Delete') %>">
                          <%- include('/partials/icon', { name: 'trash', className: 'h-4 w-4' }) %>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!rows.length) { %>
                <tr>
                  <td colspan="10" class="px-5 py-16 text-center">
                    <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400 dark:bg-gray-800">
                      <%- include('/partials/icon', { name: 'receipt', className: 'h-6 w-6' }) %>
                    </span>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-300"><%= t('No POS sales found') %></p>
                    <p class="mt-1 text-sm text-gray-400"><%= t('Record your first POS sale or adjust the filters.') %></p>
                    <a href="/pos/sales/new" class="btn btn-primary btn-sm mt-4"><%= t('New POS sale') %></a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <%- include('/partials/pagination', { basePath: '/pos/sales', pagination }) %>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
