<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1100px]">
      <%
        const errorList = Object.values(errors || {});
        const backUrl = mode === 'edit' ? `/pos/locations/${row.id}` : '/pos/locations';
      %>

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= mode === 'create' ? t('New point of sale') : t('Edit point of sale') %></h1>
          <p class="page-subtitle"><%= mode === 'create' ? t('Add a shop to the POS reporting module.') : row.name %></p>
        </div>
        <a href="<%= backUrl %>" class="btn btn-secondary btn-sm">
          <%- include('/partials/icon', { name: 'arrow-left', className: 'h-4 w-4' }) %>
          <%= t('Back') %>
        </a>
      </div>

      <% if (errorList.length) { %>
        <div class="mb-5 rounded-xl border border-error-200 bg-error-50 p-4 dark:border-error-500/30 dark:bg-error-500/10">
          <div class="flex items-start gap-3">
            <span class="mt-0.5 text-error-500"><%- include('/partials/icon', { name: 'exclamation-triangle', className: 'h-5 w-5' }) %></span>
            <div>
              <p class="text-sm font-semibold text-error-700 dark:text-error-400"><%= t('Please review the point of sale:') %></p>
              <ul class="mt-1 list-inside list-disc text-sm text-error-600 dark:text-error-400">
                <% errorList.forEach(message => { %><li><%= message %></li><% }) %>
              </ul>
            </div>
          </div>
        </div>
      <% } %>

      <form method="POST" action="<%= action %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="card">
          <div class="card-header">
            <h2 class="card-title"><%= t('Shop details') %></h2>
            <span class="text-xs text-gray-400"><%= t('Used on POS reports and tickets') %></span>
          </div>
          <div class="grid grid-cols-1 gap-5 p-5 md:grid-cols-2 md:p-6">
            <div>
              <label for="code" class="form-label"><%= t('Code') %> <span class="text-error-500">*</span></label>
              <input id="code" name="code" value="<%= row.code || '' %>" maxlength="20" class="form-input font-mono uppercase" placeholder="OAK-01" required>
              <p class="form-help"><%= t('A short unique code for this point of sale.') %></p>
              <% if (errors.code) { %><p class="form-error"><%= errors.code %></p><% } %>
            </div>
            <div>
              <label for="name" class="form-label"><%= t('Name') %> <span class="text-error-500">*</span></label>
              <input id="name" name="name" value="<%= row.name || '' %>" maxlength="120" class="form-input" placeholder="<%= t('e.g. Uptown Oakland') %>" required>
              <% if (errors.name) { %><p class="form-error"><%= errors.name %></p><% } %>
            </div>
            <div class="md:col-span-2">
              <label for="address_line1" class="form-label"><%= t('Address') %></label>
              <input id="address_line1" name="address_line1" value="<%= row.address_line1 || '' %>" maxlength="190" class="form-input" placeholder="<%= t('Street address') %>">
            </div>
            <div>
              <label for="city" class="form-label"><%= t('City') %></label>
              <input id="city" name="city" value="<%= row.city || '' %>" maxlength="100" class="form-input">
            </div>
            <div>
              <label for="state" class="form-label"><%= t('State') %></label>
              <input id="state" name="state" value="<%= row.state || '' %>" maxlength="100" class="form-input">
            </div>
            <div>
              <label for="postal_code" class="form-label"><%= t('Postal code') %></label>
              <input id="postal_code" name="postal_code" value="<%= row.postal_code || '' %>" maxlength="20" class="form-input">
            </div>
            <div>
              <label for="phone" class="form-label"><%= t('Phone') %></label>
              <input id="phone" name="phone" value="<%= row.phone || '' %>" maxlength="40" class="form-input">
            </div>
            <div>
              <label for="status" class="form-label"><%= t('Status') %></label>
              <select id="status" name="status" class="form-select">
                <option value="active" <%= (row.status || 'active') === 'active' ? 'selected' : '' %>><%= t('Active') %></option>
                <option value="inactive" <%= row.status === 'inactive' ? 'selected' : '' %>><%= t('Inactive') %></option>
              </select>
            </div>
            <div class="md:col-span-2">
              <label for="notes" class="form-label"><%= t('Notes') %></label>
              <textarea id="notes" name="notes" rows="3" maxlength="5000" class="form-textarea" placeholder="<%= t('Optional internal notes about this shop') %>"><%= row.notes || '' %></textarea>
            </div>
          </div>
        </div>

        <div class="mt-5 flex items-center justify-end gap-2">
          <a href="<%= backUrl %>" class="btn btn-secondary"><%= t('Cancel') %></a>
          <button type="submit" class="btn btn-primary">
            <%- include('/partials/icon', { name: 'check', className: 'h-4 w-4' }) %>
            <%= mode === 'create' ? t('Create point of sale') : t('Save changes') %>
          </button>
        </div>
      </form>
    </div>
  </main>
  <%- include('/layouts/footer') %>
