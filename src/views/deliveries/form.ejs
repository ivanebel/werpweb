<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1300px]">
      <%
        const backUrl = mode === 'edit' ? `/deliveries/${delivery.id}` : '/deliveries';
        const formErrors = errors._form || [];
        const submittedIds = Array.isArray(row.so_item_id) ? row.so_item_id.map(String) : null;
        const submittedQtys = Array.isArray(row.item_quantity) ? row.item_quantity : [];
        const submittedPallets = Array.isArray(row.slip_pallets) ? row.slip_pallets : [];
        const submittedBoxes = Array.isArray(row.slip_boxes) ? row.slip_boxes : [];
        const submittedUnits = Array.isArray(row.slip_units) ? row.slip_units : [];
        const submittedWeights = Array.isArray(row.slip_weight_kg) ? row.slip_weight_kg : [];
        const pageNumber = mode === 'edit' ? (delivery.packing_slip_no || delivery.delivery_no) : null;
        const packingSlipValue = mode === 'edit'
          ? (delivery.packing_slip_no || t('Not assigned'))
          : (nextPackingSlip || t('Not assigned'));
        const assignedCai = mode === 'edit' ? delivery.cai_number : (activeCai ? activeCai.cai_number : null);
        const legacyCarrierValue = row.legacy_carrier || (!row.carrier_id && row.carrier ? row.carrier : '');
      %>

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= mode === 'create' ? t('New delivery') : t('Edit {number}', { number: pageNumber }) %></h1>
          <p class="page-subtitle">
            <%= mode === 'create' ? t('Ship items from sales order') : t('Update packing details for') %>
            <span class="font-medium text-gray-700 dark:text-gray-300"><%= order.order_no %></span>
          </p>
        </div>
        <a href="<%= backUrl %>" class="btn btn-secondary btn-sm">
          <%- include('/partials/icon', { name: 'arrow-left', className: 'h-4 w-4' }) %> Back
        </a>
      </div>

      <% if (formErrors.length) { %>
        <div class="mb-5 rounded-xl border border-error-200 bg-error-50 p-4 dark:border-error-500/30 dark:bg-error-500/10">
          <div class="flex items-start gap-3">
            <span class="mt-0.5 text-error-500"><%- include('/partials/icon', { name: 'exclamation-triangle', className: 'h-5 w-5' }) %></span>
            <div>
              <p class="text-sm font-semibold text-error-700 dark:text-error-400">Please review the delivery:</p>
              <ul class="mt-1 list-inside list-disc text-sm text-error-600 dark:text-error-400">
                <% formErrors.forEach(message => { %><li><%= message %></li><% }) %>
              </ul>
            </div>
          </div>
        </div>
      <% } %>

      <% if (mode === 'create' && !activeCai) { %>
        <div class="mb-5 flex flex-col gap-3 rounded-xl border border-warning-200 bg-warning-50 p-4 text-sm text-warning-700 dark:border-warning-500/30 dark:bg-warning-500/10 dark:text-warning-300 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0"><%- include('/partials/icon', { name: 'exclamation-triangle', className: 'h-5 w-5' }) %></span>
            <p><%= t('No active CAI authorization with available packing slips. Ask an administrator to add or activate one before creating a delivery.') %></p>
          </div>
          <% if (currentUser && currentUser.role === 'admin') { %>
            <a href="/deliveries/cai" class="btn btn-secondary btn-sm shrink-0"><%= t('Manage CAI') %></a>
          <% } %>
        </div>
      <% } %>

      <form method="POST" action="<%= action %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="sales_order_id" value="<%= order.id %>">

        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Delivery details</h2>
            <span class="font-mono text-xs text-gray-400"><%= mode === 'edit' ? packingSlipValue : (nextPackingSlip || t('Not assigned')) %></span>
          </div>
          <div class="grid grid-cols-1 gap-5 p-5 md:grid-cols-4 md:p-6">
            <div class="md:col-span-2">
              <label for="delivery_date" class="form-label">Delivery date <span class="text-error-500">*</span></label>
              <input id="delivery_date" type="date" name="delivery_date" value="<%= String(row.delivery_date || '').slice(0, 10) %>" class="form-input" required>
            </div>
            <div class="md:col-span-2">
              <label class="form-label">Sales order</label>
              <div class="flex h-11 items-center rounded-lg border border-gray-200 bg-gray-50 px-4 text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                <a href="/sales-orders/<%= order.id %>" class="link"><%= order.order_no %></a>
                <span class="ml-2 text-gray-400">·</span>
                <span class="ml-2 truncate"><%= order.customer_name || t('Sales order') %></span>
              </div>
              <div class="mt-2 grid grid-cols-1 gap-1 text-xs text-gray-500 dark:text-gray-400 sm:grid-cols-2">
                <p><span class="font-medium text-gray-600 dark:text-gray-300"><%= t('Customer order no.') %>:</span> <%= order.customer_order_no || '—' %></p>
                <p><span class="font-medium text-gray-600 dark:text-gray-300"><%= t('Destination warehouse') %>:</span> <%= order.warehouse_name ? `${order.warehouse_name}${order.warehouse_code ? ` (${order.warehouse_code})` : ''}` : '—' %></p>
                <% if (order.docking_station) { %><p><span class="font-medium text-gray-600 dark:text-gray-300"><%= t('Docking station') %>:</span> <%= order.docking_station %></p><% } %>
                <% if (order.reception_at) { %><p><span class="font-medium text-gray-600 dark:text-gray-300"><%= t('Reception date & time') %>:</span> <%= h.formatDateTime(order.reception_at) %></p><% } %>
              </div>
            </div>
            <div class="md:col-span-2">
              <label for="carrier_id" class="form-label"><%= t('Carrier / transport') %></label>
              <select id="carrier_id" name="carrier_id" class="form-select">
                <option value=""><%= t('Select carrier') %></option>
                <% carriers.forEach(carrier => { %>
                  <option value="<%= carrier.id %>"
                          data-driver-name="<%= carrier.driver_name || '' %>"
                          data-driver-id="<%= carrier.driver_id || '' %>"
                          data-license-plate="<%= carrier.license_plate || '' %>"
                          <%= String(row.carrier_id || '') === String(carrier.id) ? 'selected' : '' %>>
                    <%= carrier.company_name %><%= carrier.status !== 'active' ? ` (${t('Inactive')})` : '' %>
                  </option>
                <% }) %>
              </select>
              <input type="hidden" name="legacy_carrier" value="<%= legacyCarrierValue %>">
              <p class="form-help">
                <% if (row.carrier && !row.carrier_id) { %><%= t('Current carrier') %>: <span class="font-medium"><%= row.carrier %></span><% } %>
                <% if (currentUser && ['admin', 'manager'].includes(currentUser.role)) { %>
                  <a href="/carriers" class="link"><%= t('Manage carriers') %></a>
                <% } %>
              </p>
              <% if (!carriers.length) { %>
                <p class="form-help text-warning-600 dark:text-warning-400"><%= t('No carriers configured. Add a carrier to print transport details.') %></p>
              <% } %>
            </div>
            <div class="md:col-span-2">
              <label for="tracking_number" class="form-label">Tracking number</label>
              <input id="tracking_number" name="tracking_number" type="text" value="<%= row.tracking_number || '' %>" class="form-input" placeholder="Optional">
            </div>
            <div class="md:col-span-2">
              <label for="carrier_driver_name" class="form-label"><%= t('Driver name') %></label>
              <input id="carrier_driver_name" name="carrier_driver_name" type="text" maxlength="120" value="<%= row.carrier_driver_name || '' %>" class="form-input">
            </div>
            <div>
              <label for="carrier_driver_id" class="form-label"><%= t('Driver ID / DNI') %></label>
              <input id="carrier_driver_id" name="carrier_driver_id" type="text" maxlength="40" value="<%= row.carrier_driver_id || '' %>" class="form-input" placeholder="DNI">
            </div>
            <div>
              <label for="carrier_license_plate" class="form-label"><%= t('License plate') %></label>
              <input id="carrier_license_plate" name="carrier_license_plate" type="text" maxlength="20" value="<%= row.carrier_license_plate || '' %>" class="form-input" placeholder="AB123CD">
            </div>
            <div>
              <label for="cot" class="form-label"><%= t('COT') %></label>
              <input id="cot" name="cot" type="text" maxlength="80" value="<%= row.cot || '' %>" class="form-input" placeholder="<%= t('Optional merchandise code') %>">
              <p class="form-help"><%= t('Optional code required for some merchandise.') %></p>
            </div>
            <div>
              <label class="form-label"><%= t('Packing slip number') %></label>
              <div class="flex h-11 items-center rounded-lg border border-gray-200 bg-gray-50 px-4 text-sm dark:border-gray-700 dark:bg-gray-800">
                <span class="font-mono <%= packingSlipValue === t('Not assigned') ? 'text-gray-400' : 'text-gray-700 dark:text-gray-300' %>"><%= packingSlipValue %></span>
              </div>
              <p class="form-help">
                <% if (assignedCai) { %>
                  CAI: <span class="font-mono"><%= assignedCai %></span>
                <% } else if (mode === 'create') { %>
                  <span class="text-error-600 dark:text-error-400"><%= t('No active CAI authorization') %></span>
                <% } else { %>
                  <%= t('Not assigned') %>
                <% } %>
              </p>
            </div>
            <div class="md:col-span-4">
              <label for="notes" class="form-label">Notes</label>
              <input id="notes" name="notes" type="text" value="<%= row.notes || '' %>" class="form-input" placeholder="Packing instructions, reference…">
            </div>
          </div>
        </div>

        <div class="card mt-5">
          <div class="card-header">
            <div>
              <h2 class="card-title">Items to ship</h2>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">Enter the quantity for each line. Leave at zero to skip a line.</p>
              <p class="mt-0.5 text-xs text-gray-400"><%= t('Packing quantities are prefilled from product packaging data. Adjust them if needed.') %></p>
            </div>
            <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
              <%= h.pluralize(items.length, 'line') %>
            </span>
          </div>
          <div class="table-wrap">
            <table class="table-base min-w-[1000px]">
              <thead>
                <tr>
                  <th class="table-th">Item</th>
                  <th class="table-th text-right">Ordered</th>
                  <th class="table-th text-right">Delivered</th>
                  <th class="table-th text-right">Reserved</th>
                  <th class="table-th text-right">Available</th>
                  <th class="table-th w-32 text-right">Ship qty</th>
                </tr>
              </thead>
              <tbody>
                <% items.forEach((item, index) => {
                  const maxQty = Number(item.quantity) - Number(item.delivered_qty) - Number(item.reserved || 0) + Number(item.current_qty || 0);
                  let qtyValue;
                  let pos = -1;
                  if (submittedIds) {
                    pos = submittedIds.indexOf(String(item.so_item_id));
                    qtyValue = pos >= 0 ? submittedQtys[pos] : '0';
                  } else if (mode === 'edit' && Number(item.current_qty) > 0) {
                    qtyValue = item.current_qty;
                  } else {
                    qtyValue = Math.max(0, Number(maxQty.toFixed(3)));
                  }
                  const defaults = packingDefaults(qtyValue, item);
                  const submittedValue = (list, fallback) => {
                    if (!submittedIds || pos < 0) return fallback;
                    const raw = list[pos];
                    return raw !== undefined && raw !== null && String(raw).trim() !== '' ? raw : fallback;
                  };
                  let packValues;
                  if (submittedIds && pos >= 0) {
                    packValues = {
                      pallets: submittedValue(submittedPallets, defaults.pallets),
                      boxes: submittedValue(submittedBoxes, defaults.boxes),
                      units: submittedValue(submittedUnits, defaults.units),
                      weight: submittedValue(submittedWeights, defaults.weight),
                    };
                  } else if (mode === 'edit' && Number(item.current_qty) > 0) {
                    packValues = {
                      pallets: item.current_pallets !== null && item.current_pallets !== undefined ? item.current_pallets : defaults.pallets,
                      boxes: item.current_boxes !== null && item.current_boxes !== undefined ? item.current_boxes : defaults.boxes,
                      units: item.current_units !== null && item.current_units !== undefined ? item.current_units : defaults.units,
                      weight: item.current_weight !== null && item.current_weight !== undefined ? item.current_weight : defaults.weight,
                    };
                  } else {
                    packValues = defaults;
                  }
                %>
                  <tr class="table-row">
                    <td class="table-td">
                      <input type="hidden" name="so_item_id" value="<%= item.so_item_id %>">
                      <p class="font-medium text-gray-800 dark:text-gray-200"><%= item.name %></p>
                      <p class="text-xs text-gray-400"><%= item.sku %> · <%= item.unit %></p>
                    </td>
                    <td class="table-td text-right"><%= h.formatQty(item.quantity) %></td>
                    <td class="table-td text-right"><%= h.formatQty(item.delivered_qty) %></td>
                    <td class="table-td text-right text-gray-500 dark:text-gray-400"><%= h.formatQty(item.reserved || 0) %></td>
                    <td class="table-td text-right font-medium <%= maxQty > 0 ? 'text-gray-800 dark:text-gray-200' : 'text-gray-400' %>">
                      <%= h.formatQty(Math.max(0, maxQty)) %> <span class="text-xs font-normal text-gray-400"><%= item.unit %></span>
                    </td>
                    <td class="table-td">
                      <input id="item_qty_<%= index %>" name="item_quantity" type="number" min="0" max="<%= Math.max(0, maxQty) %>" step="0.001" value="<%= qtyValue %>" class="form-input text-right" aria-label="<%= t('Quantity to ship for {item}', { item: item.name }) %>">
                    </td>
                  </tr>
                  <tr class="bg-gray-50/70 dark:bg-white/[0.02]">
                    <td colspan="6" class="px-4 pb-4 pt-0">
                      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 xl:grid-cols-[repeat(4,minmax(0,1fr))_auto]"
                           data-packing-row
                           data-qty-input="item_qty_<%= index %>"
                           data-units-per-pack="<%= Number(item.units_per_pack) || 0 %>"
                           data-packs-per-pallet="<%= Number(item.packs_per_pallet) || 0 %>"
                           data-unit-weight="<%= Number(item.weight_kg) || 0 %>">
                        <div>
                          <label class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= t('Pallets') %></label>
                          <input name="slip_pallets" type="number" min="0" step="0.001" value="<%= packValues.pallets %>" class="form-input text-right" aria-label="<%= t('Pallets') %>">
                        </div>
                        <div>
                          <label class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= t('Boxes') %></label>
                          <input name="slip_boxes" type="number" min="0" step="0.001" value="<%= packValues.boxes %>" class="form-input text-right" aria-label="<%= t('Boxes') %>">
                        </div>
                        <div>
                          <label class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= t('Units') %></label>
                          <input name="slip_units" type="number" min="0" step="0.001" value="<%= packValues.units %>" class="form-input text-right" aria-label="<%= t('Units') %>">
                        </div>
                        <div>
                          <label class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= t('Weight (kg)') %></label>
                          <input name="slip_weight_kg" type="number" min="0" step="0.001" value="<%= packValues.weight %>" class="form-input text-right" aria-label="<%= t('Weight (kg)') %>">
                        </div>
                        <div class="flex items-end">
                          <button type="button" class="btn btn-ghost btn-sm" data-recalculate-packing>
                            <%- include('/partials/icon', { name: 'refresh', className: 'h-4 w-4' }) %>
                            <%= t('Recalculate') %>
                          </button>
                        </div>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <div class="flex flex-col-reverse justify-end gap-3 border-t border-gray-100 px-5 py-4 dark:border-gray-800 sm:flex-row md:px-6">
            <a href="<%= backUrl %>" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
              <%- include('/partials/icon', { name: 'check', className: 'h-4 w-4' }) %>
              <%= mode === 'create' ? t('Create delivery') : t('Save changes') %>
            </button>
          </div>
        </div>
      </form>

      <div class="mt-5 flex items-start gap-3 rounded-xl border border-warning-200 bg-warning-50 px-4 py-3 text-sm text-warning-700 dark:border-warning-500/30 dark:bg-warning-500/10 dark:text-warning-300">
        <%- include('/partials/icon', { name: 'exclamation-triangle', className: 'h-5 w-5 shrink-0' }) %>
        <div>
          <p>Stock is only reduced when the delivery is marked as shipped. The system blocks shipping if any product does not have enough stock.</p>
          <p class="mt-1"><%= t('The ship quantity controls stock. Packing quantities are printed on the packing slip.') %></p>
        </div>
      </div>

      <script>
        (function () {
          const round3 = (value) => Math.round((Number(value) + Number.EPSILON) * 1000) / 1000;
          document.querySelectorAll('[data-recalculate-packing]').forEach((button) => {
            button.addEventListener('click', () => {
              const row = button.closest('[data-packing-row]');
              if (!row) return;
              const qtyInput = document.getElementById(row.dataset.qtyInput);
              const qty = Math.max(0, Number(qtyInput && qtyInput.value) || 0);
              const perPack = Number(row.dataset.unitsPerPack) || 0;
              const perPallet = Number(row.dataset.packsPerPallet) || 0;
              const unitWeight = Number(row.dataset.unitWeight) || 0;
              const boxes = perPack > 0 ? round3(qty / perPack) : 0;
              const pallets = perPack > 0 && perPallet > 0 ? round3(qty / perPack / perPallet) : 0;
              row.querySelector('[name="slip_pallets"]').value = pallets;
              row.querySelector('[name="slip_boxes"]').value = boxes;
              row.querySelector('[name="slip_units"]').value = round3(qty);
              row.querySelector('[name="slip_weight_kg"]').value = round3(qty * unitWeight);
            });
          });
        })();
      </script>

      <script>
        (function () {
          const select = document.getElementById('carrier_id');
          if (!select) return;
          const driverName = document.getElementById('carrier_driver_name');
          const driverId = document.getElementById('carrier_driver_id');
          const licensePlate = document.getElementById('carrier_license_plate');
          const setValue = (input, value) => {
            if (input) input.value = value || '';
          };
          const fillFromSelection = () => {
            const option = select.options[select.selectedIndex];
            setValue(driverName, option && option.dataset.driverName);
            setValue(driverId, option && option.dataset.driverId);
            setValue(licensePlate, option && option.dataset.licensePlate);
          };
          select.addEventListener('change', fillFromSelection);
          if (select.value) {
            const option = select.options[select.selectedIndex];
            if (driverName && !driverName.value) driverName.value = option.dataset.driverName || '';
            if (driverId && !driverId.value) driverId.value = option.dataset.driverId || '';
            if (licensePlate && !licensePlate.value) licensePlate.value = option.dataset.licensePlate || '';
          }
        })();
      </script>
    </div>
  </main>
  <%- include('/layouts/footer') %>
