<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1600px]">

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= t('CAI authorizations') %></h1>
          <p class="page-subtitle"><%= t('Manage the government-issued CAI ranges used to number packing slips.') %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/deliveries" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'arrow-left', className: 'h-4 w-4' }) %>
            <%= t('Deliveries') %>
          </a>
          <a href="/deliveries/cai/new" class="btn btn-primary btn-sm">
            <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
            <%= t('New CAI authorization') %>
          </a>
        </div>
      </div>

      <div class="mb-5 grid grid-cols-2 gap-4 xl:grid-cols-4">
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <%- include('/partials/icon', { name: 'shield', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Authorizations') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatNumber(stats.total, 0) %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-success-50 text-success-600 dark:bg-success-500/15 dark:text-success-400">
            <%- include('/partials/icon', { name: 'check-circle', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Active') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatNumber(stats.active, 0) %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-blue-light-50 text-blue-light-600 dark:bg-blue-light-500/15 dark:text-blue-light-400">
            <%- include('/partials/icon', { name: 'clipboard-list', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Available packing slips') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatNumber(stats.available, 0) %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-purple-50 text-purple-600 dark:bg-purple-500/15 dark:text-purple-400">
            <%- include('/partials/icon', { name: 'printer', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Issued packing slips') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatNumber(stats.issued, 0) %></p>
          </div>
        </div>
      </div>

      <% if (unassignedDeliveries > 0) { %>
        <div class="mb-5 flex flex-col gap-3 rounded-xl border border-warning-200 bg-warning-50 p-4 text-sm text-warning-700 dark:border-warning-500/30 dark:bg-warning-500/10 dark:text-warning-300 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0"><%- include('/partials/icon', { name: 'exclamation-triangle', className: 'h-5 w-5' }) %></span>
            <div>
              <p class="font-medium"><%= h.pluralize(unassignedDeliveries, 'delivery', 'deliveries') %> <%= t('without a packing slip number') %>.</p>
              <p class="mt-1 text-xs"><%= t('Assigning missing packing slips consumes numbers from the active CAI authorization.') %></p>
            </div>
          </div>
          <% if (currentCai) { %>
            <form method="POST" action="/deliveries/cai/assign-missing" class="shrink-0" data-confirm="<%= t('Assign packing slip numbers to all deliveries that do not have one? This consumes numbers from the active CAI authorization.') %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-secondary btn-sm">
                <%- include('/partials/icon', { name: 'shield', className: 'h-4 w-4' }) %>
                <%= t('Assign missing packing slips') %>
              </button>
            </form>
          <% } %>
        </div>
      <% } %>

      <% if (currentCai) { %>
        <div class="mb-5 flex flex-col gap-2 rounded-xl border border-blue-light-200 bg-blue-light-50 p-4 text-sm text-blue-light-700 dark:border-blue-light-500/30 dark:bg-blue-light-500/10 dark:text-blue-light-300 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0"><%- include('/partials/icon', { name: 'info', className: 'h-5 w-5' }) %></span>
            <p>
              <%= t('Next packing slip') %>:
              <span class="font-mono font-semibold"><%= currentCai.nextSlipLabel %></span>
              · CAI <span class="font-mono font-semibold"><%= currentCai.cai_number %></span>
            </p>
          </div>
          <span class="shrink-0 text-xs"><%= h.pluralize(currentCai.remaining, 'packing slip') %> <%= t('remaining') %></span>
        </div>
      <% } else { %>
        <div class="mb-5 flex items-start gap-3 rounded-xl border border-warning-200 bg-warning-50 p-4 text-sm text-warning-700 dark:border-warning-500/30 dark:bg-warning-500/10 dark:text-warning-300">
          <span class="mt-0.5 shrink-0"><%- include('/partials/icon', { name: 'exclamation-triangle', className: 'h-5 w-5' }) %></span>
          <p><%= t('There is no active CAI authorization with available packing slips. Add one or activate an existing authorization before creating deliveries.') %></p>
        </div>
      <% } %>

      <div class="card">
        <div class="flex flex-col gap-2 border-b border-gray-100 px-5 py-4 dark:border-gray-800 sm:flex-row sm:items-center sm:justify-between">
          <h2 class="card-title"><%= t('Authorizations') %></h2>
          <span class="shrink-0 rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <%= h.pluralize(cais.length, 'authorization') %>
          </span>
        </div>

        <div class="table-wrap">
          <table class="table-base min-w-[1100px]">
            <thead>
              <tr>
                <th class="table-th"><%= t('CAI number') %></th>
                <th class="table-th"><%= t('Authorized range') %></th>
                <th class="table-th"><%= t('Next number') %></th>
                <th class="table-th text-right"><%= t('Issued') %></th>
                <th class="table-th text-right"><%= t('Remaining') %></th>
                <th class="table-th"><%= t('Status') %></th>
                <th class="table-th"><%= t('Created') %></th>
                <th class="table-th text-right"><%= t('Actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% cais.forEach(cai => { %>
                <tr class="table-row">
                  <td class="table-td">
                    <p class="font-mono font-medium text-gray-900 dark:text-white/90"><%= cai.cai_number %></p>
                    <% if (cai.created_by_name) { %><p class="mt-0.5 text-xs text-gray-400"><%= cai.created_by_name %></p><% } %>
                  </td>
                  <td class="table-td">
                    <p class="font-mono text-xs text-gray-700 dark:text-gray-300"><%= cai.rangeStartLabel %> — <%= cai.rangeEndLabel %></p>
                    <p class="mt-0.5 text-xs text-gray-400"><%= t('Prefix') %> <span class="font-mono"><%= cai.prefix %></span> · <%= h.pluralize(cai.range_end - cai.range_start + 1, 'slip') %></p>
                  </td>
                  <td class="table-td font-mono text-xs text-gray-600 dark:text-gray-400"><%= cai.nextSlipLabel || '—' %></td>
                  <td class="table-td text-right font-medium"><%= h.formatNumber(cai.used, 0) %></td>
                  <td class="table-td text-right"><%= h.formatNumber(cai.remaining, 0) %></td>
                  <td class="table-td"><%- statusBadge(cai.status) %></td>
                  <td class="table-td text-gray-500 dark:text-gray-400"><%= h.formatDate(cai.created_at) %></td>
                  <td class="table-td">
                    <div class="flex items-center justify-end gap-1">
                      <a href="/deliveries/cai/<%= cai.id %>/edit" class="btn-icon" title="<%= t('Edit') %>">
                        <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %>
                      </a>
                      <% if (cai.used === 0 && Number(cai.delivery_count) === 0) { %>
                        <form action="/deliveries/cai/<%= cai.id %>/delete" method="POST" class="inline" data-confirm="<%= t('Delete this CAI authorization? This cannot be undone.') %>">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn-icon text-error-500 hover:bg-error-50 hover:text-error-600 dark:text-error-400 dark:hover:bg-error-500/10" title="<%= t('Delete') %>">
                            <%- include('/partials/icon', { name: 'trash', className: 'h-4 w-4' }) %>
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!cais.length) { %>
                <tr>
                  <td colspan="8" class="px-6 py-16 text-center">
                    <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400 dark:bg-gray-800">
                      <%- include('/partials/icon', { name: 'shield', className: 'h-6 w-6' }) %>
                    </span>
                    <p class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= t('No CAI authorizations yet') %></p>
                    <p class="mt-1 text-sm text-gray-400"><%= t('Add a CAI authorization to start issuing valid packing slips.') %></p>
                    <a href="/deliveries/cai/new" class="btn btn-primary btn-sm mt-4"><%= t('New CAI authorization') %></a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
</div>
