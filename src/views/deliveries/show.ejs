<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1400px]">
      <%
        const toneClass = { primary: 'btn-primary', secondary: 'btn-secondary', danger: 'btn-danger', success: 'btn-success' };
        const totalQty = items.reduce((sum, item) => sum + Number(item.quantity), 0);
      %>

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="page-title"><%= delivery.delivery_no %></h1>
            <%- statusBadge(delivery.status) %>
          </div>
          <p class="page-subtitle">
            <%= delivery.customer_name %>
            <% if (delivery.order_no) { %>· <%= t('against') %> <a href="/sales-orders/<%= delivery.sales_order_id %>" class="link"><%= delivery.order_no %></a><% } %>
            · <%= h.formatDate(delivery.delivery_date) %>
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/deliveries" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'arrow-left', className: 'h-4 w-4' }) %> Back
          </a>
          <% actions.forEach(a => { %>
            <% if (a.href) { %>
              <a href="<%= a.href %>" class="btn <%= toneClass[a.tone] || 'btn-secondary' %> btn-sm"><%= a.label %></a>
            <% } else { %>
              <form method="POST" action="/deliveries/<%= delivery.id %>/status" class="inline" <%= a.confirm ? 'data-confirm="Change this delivery status? Stock movements will be posted or reversed."' : '' %>>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="status" value="<%= a.value %>">
                <button type="submit" class="btn <%= toneClass[a.tone] || 'btn-secondary' %> btn-sm"><%= a.label %></button>
              </form>
            <% } %>
          <% }) %>
          <% if (['pending', 'cancelled'].includes(delivery.status)) { %>
            <form method="POST" action="/deliveries/<%= delivery.id %>/delete" data-confirm="<%= t('Delete {number}? This cannot be undone.', { number: delivery.delivery_no }) %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-danger btn-sm">
                <%- include('/partials/icon', { name: 'trash', className: 'h-4 w-4' }) %> Delete
              </button>
            </form>
          <% } %>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5 xl:grid-cols-3">
        <div class="card overflow-hidden xl:col-span-2">
          <div class="flex flex-wrap items-start justify-between gap-4 border-b border-gray-100 px-6 py-5 dark:border-gray-800">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-sm font-bold text-white shadow-theme-sm">
                <%= (settings.company_name || 'W').charAt(0) %>
              </span>
              <div>
                <p class="text-sm font-semibold text-gray-800 dark:text-white/90"><%= settings.company_name %></p>
                <p class="text-xs text-gray-400"><%= settings.company_email %><%= settings.company_phone ? ' · ' + settings.company_phone : '' %></p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400">Packing slip</p>
              <p class="mt-1 text-lg font-semibold text-gray-800 dark:text-white/90"><%= delivery.delivery_no %></p>
              <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Delivery date: <span class="font-medium text-gray-700 dark:text-gray-300"><%= h.formatDate(delivery.delivery_date) %></span></p>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-6 px-6 py-5 sm:grid-cols-2">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Ship to</p>
              <p class="mt-2 text-sm font-semibold text-gray-800 dark:text-gray-200"><%= delivery.customer_name %></p>
              <% if (delivery.warehouse_name) { %>
                <p class="mt-1 text-sm font-medium text-brand-600 dark:text-brand-400"><%= delivery.warehouse_name %><%= delivery.warehouse_code ? ` · ${delivery.warehouse_code}` : '' %></p>
                <% if (delivery.warehouse_contact) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.warehouse_contact %></p><% } %>
                <% if (delivery.warehouse_address) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.warehouse_address %></p><% } %>
                <% if (delivery.warehouse_address2) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.warehouse_address2 %></p><% } %>
                <% if (delivery.warehouse_city) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.warehouse_city %><%= delivery.warehouse_state ? ', ' + delivery.warehouse_state : '' %> <%= delivery.warehouse_postal || '' %></p><% } %>
                <% if (delivery.warehouse_country) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.warehouse_country %></p><% } %>
                <% if (delivery.warehouse_phone) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.warehouse_phone %></p><% } %>
              <% } else { %>
                <% if (delivery.customer_contact) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.customer_contact %></p><% } %>
                <% if (delivery.customer_address) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.customer_address %></p><% } %>
                <% if (delivery.customer_city) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.customer_city %><%= delivery.customer_state ? ', ' + delivery.customer_state : '' %> <%= delivery.customer_postal || '' %></p><% } %>
                <% if (delivery.customer_country) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.customer_country %></p><% } %>
              <% } %>
              <% if (delivery.customer_email) { %><p class="mt-1 text-sm"><a href="mailto:<%= delivery.customer_email %>" class="link"><%= delivery.customer_email %></a></p><% } %>
              <% if (delivery.customer_phone) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.customer_phone %></p><% } %>
            </div>
            <div class="sm:text-right">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Shipment</p>
              <dl class="mt-2 space-y-1 text-sm">
                <div class="flex justify-between gap-4 sm:justify-end"><dt class="text-gray-500 dark:text-gray-400">Carrier</dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= delivery.carrier || '—' %></dd></div>
                <div class="flex justify-between gap-4 sm:justify-end"><dt class="text-gray-500 dark:text-gray-400">Tracking</dt><dd class="font-mono text-xs text-gray-700 dark:text-gray-300"><%= delivery.tracking_number || '—' %></dd></div>
                <div class="flex justify-between gap-4 sm:justify-end"><dt class="text-gray-500 dark:text-gray-400">Lines</dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= items.length %></dd></div>
                <div class="flex justify-between gap-4 sm:justify-end"><dt class="text-gray-500 dark:text-gray-400">Total units</dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= h.formatQty(totalQty) %></dd></div>
                <% if (delivery.order_no) { %>
                  <div class="flex justify-between gap-4 sm:justify-end"><dt class="text-gray-500 dark:text-gray-400">Sales order</dt><dd><a href="/sales-orders/<%= delivery.sales_order_id %>" class="link"><%= delivery.order_no %></a></dd></div>
                <% } %>
                <% if (delivery.customer_order_no) { %>
                  <div class="flex justify-between gap-4 sm:justify-end"><dt class="text-gray-500 dark:text-gray-400"><%= t('Customer order no.') %></dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= delivery.customer_order_no %></dd></div>
                <% } %>
                <% if (delivery.warehouse_name) { %>
                  <div class="flex justify-between gap-4 sm:justify-end"><dt class="text-gray-500 dark:text-gray-400"><%= t('Destination warehouse') %></dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= delivery.warehouse_name %></dd></div>
                <% } %>
                <% if (delivery.docking_station) { %>
                  <div class="flex justify-between gap-4 sm:justify-end"><dt class="text-gray-500 dark:text-gray-400"><%= t('Docking station') %></dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= delivery.docking_station %></dd></div>
                <% } %>
                <% if (delivery.reception_at) { %>
                  <div class="flex justify-between gap-4 sm:justify-end"><dt class="text-gray-500 dark:text-gray-400"><%= t('Reception date & time') %></dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= h.formatDateTime(delivery.reception_at) %></dd></div>
                <% } %>
              </dl>
            </div>
          </div>

          <div class="table-wrap border-t border-gray-100 dark:border-gray-800">
            <table class="table-base min-w-[620px]">
              <thead>
                <tr>
                  <th class="table-th">Item</th>
                  <th class="table-th">Customer code</th>
                  <th class="table-th text-right">Ordered</th>
                  <th class="table-th text-right">Shipped</th>
                  <th class="table-th">Unit</th>
                </tr>
              </thead>
              <tbody>
                <% items.forEach(item => { %>
                  <tr>
                    <td class="table-td">
                      <p class="font-medium text-gray-800 dark:text-gray-200"><%= item.name %></p>
                      <p class="text-xs text-gray-400"><%= item.sku %></p>
                    </td>
                    <td class="table-td font-mono text-xs text-gray-600 dark:text-gray-300"><%= item.customer_code || '—' %></td>
                    <td class="table-td text-right text-gray-500 dark:text-gray-400"><%= item.ordered_qty !== null && item.ordered_qty !== undefined ? h.formatQty(item.ordered_qty) : '—' %></td>
                    <td class="table-td text-right font-medium"><%= h.formatQty(item.quantity) %></td>
                    <td class="table-td text-gray-500 dark:text-gray-400"><%= item.unit %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <% if (delivery.notes) { %>
            <div class="border-t border-gray-100 px-6 py-4 dark:border-gray-800">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Notes</p>
              <p class="mt-1 whitespace-pre-line text-sm text-gray-600 dark:text-gray-400"><%= delivery.notes %></p>
            </div>
          <% } %>
        </div>

        <div class="space-y-5">
          <div class="card p-5 md:p-6">
            <div class="flex items-center justify-between">
              <h2 class="card-title">Delivery status</h2>
              <%- statusBadge(delivery.status) %>
            </div>
            <dl class="mt-4 space-y-3 text-sm">
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Number</dt><dd class="font-mono text-xs text-gray-700 dark:text-gray-300"><%= delivery.delivery_no %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Delivery date</dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= h.formatDate(delivery.delivery_date) %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Stock posted</dt><dd class="font-medium <%= Number(delivery.stock_posted) === 1 ? 'text-success-600 dark:text-success-400' : 'text-gray-700 dark:text-gray-300' %>"><%= Number(delivery.stock_posted) === 1 ? t('Yes') : t('No') %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Created</dt><dd class="text-gray-700 dark:text-gray-300"><%= h.formatDate(delivery.created_at) %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Updated</dt><dd class="text-gray-700 dark:text-gray-300"><%= h.formatDate(delivery.updated_at) %></dd></div>
            </dl>
            <div class="mt-4 grid grid-cols-2 gap-2">
              <a href="/deliveries/<%= delivery.id %>/print" class="btn btn-secondary btn-sm">
                <%- include('/partials/icon', { name: 'printer', className: 'h-4 w-4' }) %> Print
              </a>
              <% if (delivery.status === 'pending') { %>
                <a href="/deliveries/<%= delivery.id %>/edit" class="btn btn-secondary btn-sm">
                  <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %> Edit
                </a>
              <% } %>
            </div>
          </div>

          <div class="card p-5 md:p-6">
            <h2 class="card-title">Customer</h2>
            <p class="mt-3 text-sm font-semibold text-gray-800 dark:text-gray-200"><%= delivery.customer_name %></p>
            <% if (delivery.customer_contact) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.customer_contact %></p><% } %>
            <% if (delivery.customer_email) { %><p class="mt-1 text-sm"><a href="mailto:<%= delivery.customer_email %>" class="link"><%= delivery.customer_email %></a></p><% } %>
            <% if (delivery.customer_phone) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= delivery.customer_phone %></p><% } %>
            <a href="/customers/<%= delivery.customer_id %>" class="btn btn-secondary btn-sm mt-4 w-full">Open customer</a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
