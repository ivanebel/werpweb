<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t('Packing slip {number}', { number: delivery.delivery_no }) %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    @page { size: A4; margin: 14mm; }
    body { background: #fff; color: #1d2939; }
    @media print {
      .no-print { display: none !important; }
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>
<body class="bg-gray-100 font-outfit text-gray-800" data-locale="<%= locale %>">
  <div class="no-print sticky top-0 z-10 flex items-center justify-between border-b border-gray-200 bg-white px-6 py-3">
    <a href="/deliveries/<%= delivery.id %>" class="btn btn-secondary btn-sm">Back to delivery</a>
    <div class="flex items-center gap-2">
      <span class="text-sm text-gray-500"><%= t('Packing slip {number}', { number: delivery.delivery_no }) %></span>
      <button type="button" onclick="window.print()" class="btn btn-primary btn-sm">Print / Save PDF</button>
    </div>
  </div>

  <div class="mx-auto my-6 max-w-[820px] bg-white p-8 shadow-theme-lg print:my-0 print:max-w-none print:p-0 print:shadow-none sm:p-10">
    <div class="flex flex-wrap items-start justify-between gap-6 border-b border-gray-200 pb-6">
      <div>
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500 text-lg font-bold text-white"><%= (settings.company_name || 'W').charAt(0) %></span>
          <div>
            <p class="text-lg font-bold text-gray-900"><%= settings.company_name %></p>
            <p class="text-xs text-gray-500"><%= settings.company_email %><%= settings.company_phone ? ' · ' + settings.company_phone : '' %></p>
          </div>
        </div>
        <div class="mt-4 whitespace-pre-line text-xs leading-relaxed text-gray-500"><%= settings.company_address %></div>
        <% if (settings.company_tax_id) { %><p class="mt-1 text-xs text-gray-500">Tax ID: <%= settings.company_tax_id %></p><% } %>
      </div>
      <div class="text-right">
        <p class="text-2xl font-semibold uppercase tracking-wide text-brand-600">Packing slip</p>
        <p class="mt-1 text-sm font-medium text-gray-700"><%= delivery.delivery_no %></p>
        <div class="mt-3 space-y-0.5 text-xs text-gray-500">
          <p><span class="font-medium text-gray-700">Delivery date:</span> <%= h.formatDate(delivery.delivery_date) %></p>
          <% if (delivery.order_no) { %><p><span class="font-medium text-gray-700">Sales order:</span> <%= delivery.order_no %></p><% } %>
          <% if (delivery.customer_order_no) { %><p><span class="font-medium text-gray-700"><%= t('Customer order no.') %>:</span> <%= delivery.customer_order_no %></p><% } %>
          <% if (delivery.warehouse_name) { %><p><span class="font-medium text-gray-700"><%= t('Destination warehouse') %>:</span> <%= delivery.warehouse_name %><%= delivery.warehouse_code ? ` · ${delivery.warehouse_code}` : '' %></p><% } %>
          <p><span class="font-medium text-gray-700">Status:</span> <%= h.statusInfo(delivery.status).label %></p>
        </div>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-8 sm:grid-cols-2">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-gray-400">Ship to</p>
        <p class="mt-2 text-sm font-semibold text-gray-900"><%= delivery.customer_name %></p>
        <% if (delivery.warehouse_name) { %>
          <p class="mt-1 text-sm font-medium text-brand-600"><%= delivery.warehouse_name %><%= delivery.warehouse_code ? ` · ${delivery.warehouse_code}` : '' %></p>
          <% if (delivery.warehouse_contact) { %><p class="text-sm text-gray-600"><%= delivery.warehouse_contact %></p><% } %>
          <% if (delivery.warehouse_address) { %><p class="text-sm text-gray-600"><%= delivery.warehouse_address %></p><% } %>
          <% if (delivery.warehouse_address2) { %><p class="text-sm text-gray-600"><%= delivery.warehouse_address2 %></p><% } %>
          <% if (delivery.warehouse_city) { %><p class="text-sm text-gray-600"><%= delivery.warehouse_city %><%= delivery.warehouse_state ? ', ' + delivery.warehouse_state : '' %> <%= delivery.warehouse_postal || '' %></p><% } %>
          <% if (delivery.warehouse_country) { %><p class="text-sm text-gray-600"><%= delivery.warehouse_country %></p><% } %>
          <% if (delivery.warehouse_phone) { %><p class="text-sm text-gray-600"><%= delivery.warehouse_phone %></p><% } %>
        <% } else { %>
          <% if (delivery.customer_contact) { %><p class="text-sm text-gray-600"><%= delivery.customer_contact %></p><% } %>
          <% if (delivery.customer_address) { %><p class="text-sm text-gray-600"><%= delivery.customer_address %></p><% } %>
          <% if (delivery.customer_city) { %><p class="text-sm text-gray-600"><%= delivery.customer_city %><%= delivery.customer_state ? ', ' + delivery.customer_state : '' %> <%= delivery.customer_postal || '' %></p><% } %>
          <% if (delivery.customer_country) { %><p class="text-sm text-gray-600"><%= delivery.customer_country %></p><% } %>
        <% } %>
        <% if (delivery.customer_email) { %><p class="mt-1 text-sm text-gray-600"><%= delivery.customer_email %></p><% } %>
        <% if (delivery.customer_phone) { %><p class="text-sm text-gray-600"><%= delivery.customer_phone %></p><% } %>
      </div>
      <div class="sm:text-right">
        <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-gray-400">Shipment details</p>
        <p class="mt-2 text-sm text-gray-600">Carrier: <span class="font-medium text-gray-800"><%= delivery.carrier || '—' %></span></p>
        <p class="text-sm text-gray-600">Tracking: <span class="font-mono text-xs font-medium text-gray-800"><%= delivery.tracking_number || '—' %></span></p>
        <% if (delivery.customer_order_no) { %><p class="text-sm text-gray-600"><%= t('Customer order no.') %>: <span class="font-medium text-gray-800"><%= delivery.customer_order_no %></span></p><% } %>
        <% if (delivery.docking_station) { %><p class="text-sm text-gray-600"><%= t('Docking station') %>: <span class="font-medium text-gray-800"><%= delivery.docking_station %></span></p><% } %>
        <% if (delivery.reception_at) { %><p class="text-sm text-gray-600"><%= t('Reception date & time') %>: <span class="font-medium text-gray-800"><%= h.formatDateTime(delivery.reception_at) %></span></p><% } %>
        <p class="mt-3 text-sm text-gray-600"><%= h.pluralize(items.length, 'line') %></p>
      </div>
    </div>

    <table class="mt-8 w-full border-collapse text-left text-sm">
      <thead>
        <tr class="border-y border-gray-200 bg-gray-50 text-[10px] uppercase tracking-wide text-gray-500">
          <th class="py-2.5 pl-3 pr-2 font-semibold">#</th>
          <th class="px-2 py-2.5 font-semibold">Item</th>
          <th class="px-2 py-2.5 font-semibold">SKU</th>
          <th class="px-2 py-2.5 font-semibold">Customer code</th>
          <th class="py-2.5 pl-2 pr-3 text-right font-semibold">Quantity</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach((item, index) => { %>
          <tr class="border-b border-gray-100">
            <td class="py-3 pl-3 pr-2 text-gray-400"><%= index + 1 %></td>
            <td class="px-2 py-3 font-medium text-gray-800"><%= item.name %></td>
            <td class="px-2 py-3 font-mono text-xs text-gray-500"><%= item.sku %></td>
            <td class="px-2 py-3 font-mono text-xs text-gray-500"><%= item.customer_code || '—' %></td>
            <td class="py-3 pl-2 pr-3 text-right whitespace-nowrap"><%= h.formatQty(item.quantity) %> <span class="text-xs text-gray-400"><%= item.unit %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (delivery.notes) { %>
      <div class="mt-8 border-t border-gray-200 pt-4">
        <p class="text-[10px] font-semibold uppercase tracking-wide text-gray-400">Notes</p>
        <p class="mt-1 whitespace-pre-line text-sm text-gray-600"><%= delivery.notes %></p>
      </div>
    <% } %>

    <div class="mt-14 grid grid-cols-2 gap-10 text-xs text-gray-500">
      <div>
        <div class="border-t border-gray-300 pt-2">Received by (name &amp; signature)</div>
      </div>
      <div>
        <div class="border-t border-gray-300 pt-2">Date received</div>
      </div>
    </div>

    <div class="mt-10 border-t border-gray-200 pt-4 text-center text-xs text-gray-400">
      <%= settings.invoice_footer || t('Thank you for your business.') %>
    </div>
  </div>
</body>
</html>
