<% if (pagination && pagination.total > 0) { %>
<div class="flex flex-col items-start justify-between gap-3 border-t border-gray-100 px-5 py-4 dark:border-gray-800 sm:flex-row sm:items-center md:px-6">
  <p class="text-sm text-gray-500 dark:text-gray-400">
    <%= t('Showing {from}–{to} of {total}', { from: pagination.from, to: pagination.to, total: pagination.total }) %>
  </p>
  <nav class="flex flex-wrap items-center gap-1" aria-label="Pagination">
    <% const qsBase = { ...query }; delete qsBase.page; %>
    <a href="<%= h.buildQuery(basePath, { ...qsBase, page: pagination.page - 1 }) %>"
       class="btn-icon <%= pagination.page <= 1 ? 'pointer-events-none opacity-40' : '' %>" aria-label="Previous page">
      <%- include('/partials/icon', { name: 'chevron-right', className: 'h-4 w-4 rotate-180' }) %>
    </a>
    <% pagination.pages.forEach(p => { %>
      <% if (p.ellipsis) { %>
        <span class="px-2 text-gray-400">…</span>
      <% } else { %>
        <a href="<%= h.buildQuery(basePath, { ...qsBase, page: p.page }) %>"
           class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg px-2 text-sm font-medium transition <%= p.current ? 'bg-brand-500 text-white' : 'border border-gray-200 bg-white text-gray-600 hover:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800' %>">
          <%= p.page %>
        </a>
      <% } %>
    <% }) %>
    <a href="<%= h.buildQuery(basePath, { ...qsBase, page: pagination.page + 1 }) %>"
       class="btn-icon <%= pagination.page >= pagination.totalPages ? 'pointer-events-none opacity-40' : '' %>" aria-label="Next page">
      <%- include('/partials/icon', { name: 'chevron-right', className: 'h-4 w-4' }) %>
    </a>
  </nav>
</div>
<% } %>
