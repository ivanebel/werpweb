            </table>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div>
              <h2 class="card-title"><%= t('Planned cash events') %></h2>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= t('Recurring and one-off events inside the forecast range.') %></p>
            </div>
            <a href="/finance/cash/events" class="btn btn-secondary btn-sm"><%= t('Manage events') %></a>
          </div>
          <div class="table-wrap <%= detailMax %>">
            <table class="table-base min-w-[760px]">
              <thead>
                <tr>
                  <th class="table-th"><%= t('Event') %></th>
                  <th class="table-th"><%= t('Category') %></th>
                  <th class="table-th"><%= t('Direction') %></th>
                  <th class="table-th"><%= t('Date') %></th>
                  <th class="table-th text-right"><%= t('Amount') %></th>
                </tr>
              </thead>
              <tbody>
                <% result.events.forEach((row) => { %>
                  <tr class="table-row">
                    <td class="table-td">
                      <p class="font-medium text-gray-800 dark:text-gray-200"><%= row.name %></p>
                      <p class="text-xs text-gray-400"><%= row.account_name || t('Company-wide') %></p>
                    </td>
                    <td class="table-td"><%= h.humanize(row.category) %></td>
                    <td class="table-td"><span class="badge <%= row.direction === 'inflow' ? 'bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-400' : 'bg-warning-50 text-warning-700 dark:bg-warning-500/15 dark:text-warning-400' %>"><%= row.direction === 'inflow' ? t('In') : t('Out') %></span></td>
