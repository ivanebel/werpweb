      <div class="card mb-5">
        <div class="card-header">
          <div>
            <h2 class="card-title"><%= t('Cash accounts') %></h2>
            <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= t('Active accounts define the opening cash and the actual cash comparison.') %></p>
          </div>
          <a href="/finance/cash/accounts" class="btn btn-secondary btn-sm"><%= t('Manage accounts') %></a>
        </div>
        <div class="table-wrap">
          <table class="table-base">
            <thead>
              <tr>
                <th class="table-th"><%= t('Account') %></th>
                <th class="table-th"><%= t('Type') %></th>
                <th class="table-th"><%= t('Bank') %></th>
                <th class="table-th"><%= t('Opening date') %></th>
                <th class="table-th text-right"><%= t('Opening balance') %></th>
                <th class="table-th"><%= t('Status') %></th>
              </tr>
            </thead>
            <tbody>
              <% result.accounts.forEach((account) => { %>
                <tr class="table-row">
                  <td class="table-td"><a href="/finance/cash/accounts/<%= account.id %>" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= account.name %></a><p class="text-xs text-gray-400"><%= account.account_number || '' %></p></td>
                  <td class="table-td"><%= h.humanize(account.type) %></td>
                  <td class="table-td"><%= account.bank_name || '—' %></td>
                  <td class="table-td whitespace-nowrap"><%= account.opening_date ? h.formatDate(account.opening_date, locale) : '—' %></td>
                  <td class="table-td text-right font-medium"><%= money(account.opening_balance) %></td>
                  <td class="table-td"><%- statusBadge(account.status) %></td>
                </tr>
              <% }) %>
              <% if (!result.accounts.length) { %>
                <tr><td colspan="6" class="px-6 py-12 text-center text-sm text-gray-400"><%= t('No active cash accounts yet.') %></td></tr>
              <% } %>
            </tbody>
            <% if (result.accounts.length) { %>
              <tfoot>
                <tr class="border-t-2 border-gray-200 bg-gray-50 font-semibold dark:border-gray-700 dark:bg-gray-800/60">
                  <td class="px-5 py-3 text-sm" colspan="4"><%= t('Opening cash') %></td>
                  <td class="px-3 py-3 text-right text-sm"><%= money(result.opening_cash) %></td>
                  <td></td>
                </tr>
              </tfoot>
            <% } %>
          </table>
        </div>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-5 text-xs leading-relaxed text-gray-500 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-400">
        <p class="font-semibold text-gray-700 dark:text-gray-300"><%= t('How this forecast is calculated') %></p>
        <p class="mt-2"><%= t('Opening cash is the sum of active cash account balances. Inflows include expected collections, open checks and planned inflows. Outflows include open bills, fixed-cost cash payments, open checks and planned outflows.') %></p>
        <p class="mt-1"><%= t('Collection rates and delays are applied by receivable aging bucket. Credit notes reduce receivables or payables at their due date. Bills are assumed to be paid in full after the supplier delay.') %></p>
        <p class="mt-1"><%= t('Fixed costs are converted from their cost item amount to gross cash using the VAT rate. Non-cash items such as depreciation are excluded. Payments dated before today are not forecast again.') %></p>
        <p class="mt-1"><%= t('Future sales that are not invoiced yet are not forecast automatically. Add planned cash events or use the sales simulator for what-if planning.') %></p>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>

  <script>
  (function () {
    const currency = <%- JSON.stringify(currency || 'USD') %>;
    const locale = document.body.dataset.locale || document.documentElement.lang || 'en-US';
    const labels = <%- JSON.stringify(chartLabels) %>;
    const inflows = <%- JSON.stringify(selected.buckets.map((bucket) => bucket.total_in)) %>;
    const outflows = <%- JSON.stringify(selected.buckets.map((bucket) => bucket.total_out)) %>;
    const closing = <%- JSON.stringify(selected.buckets.map((bucket) => bucket.closing)) %>;
    const bufferLine = <%- JSON.stringify(selected.buckets.map(() => buffer)) %>;
    const chartEl = document.querySelector('#cash-chart');
    if (!chartEl || typeof ApexCharts === 'undefined') return;

    function money(value) {
      try {
        return new Intl.NumberFormat(locale, { style: 'currency', currency, maximumFractionDigits: 0 }).format(Number(value || 0));
      } catch (e) {
        return currency + ' ' + Number(value || 0).toFixed(0);
      }
    }
    const isDark = () => document.documentElement.classList.contains('dark');
    const chart = new ApexCharts(chartEl, {
      chart: { type: 'line', height: 320, toolbar: { show: false }, fontFamily: 'Outfit, sans-serif', foreColor: isDark() ? '#98A2B3' : '#667085' },
      series: [
        { name: <%- JSON.stringify(t('Total in')) %>, type: 'column', data: inflows },
        { name: <%- JSON.stringify(t('Total out')) %>, type: 'column', data: outflows },
        { name: <%- JSON.stringify(t('Closing cash')) %>, type: 'line', data: closing },
        { name: <%- JSON.stringify(t('Minimum buffer')) %>, type: 'line', data: bufferLine }
      ],
      colors: ['#12B76A', '#F04438', '#465FFF', '#F79009'],
      stroke: { curve: 'smooth', width: [0, 0, 3, 2], dashArray: [0, 0, 0, 6] },
      plotOptions: { bar: { columnWidth: '50%', borderRadius: 4 } },
      dataLabels: { enabled: false },
      grid: { borderColor: isDark() ? '#1F2937' : '#F2F4F7', strokeDashArray: 4 },
      xaxis: { categories: labels, axisBorder: { show: false }, axisTicks: { show: false }, labels: { rotate: -35, rotateAlways: labels.length > 8, trim: true } },
      yaxis: { labels: { formatter: money } },
      tooltip: { shared: true, intersect: false, theme: isDark() ? 'dark' : 'light', y: { formatter: money } },
      legend: { position: 'top', horizontalAlign: 'right', markers: { radius: 4 } }
    });
    chart.render();
    document.addEventListener('werp:theme', () => {
      chart.updateOptions({
        chart: { foreColor: isDark() ? '#98A2B3' : '#667085' },
        grid: { borderColor: isDark() ? '#1F2937' : '#F2F4F7' },
        tooltip: { theme: isDark() ? 'dark' : 'light' }
      });
    });
  })();
  </script>
</div>
