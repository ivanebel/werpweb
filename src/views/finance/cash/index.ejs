                  <tr><td colspan="7" class="px-6 py-12 text-center text-sm text-gray-400"><%= t('No open receivables.') %></td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div>
              <h2 class="card-title"><%= t('Open payables') %></h2>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= t('Bills and credit notes with an outstanding balance.') %></p>
            </div>
            <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300"><%= h.pluralize(result.payables.length, 'bill', 'bills', locale) %></span>
          </div>
          <div class="table-wrap <%= detailMax %>">
            <table class="table-base min-w-[950px]">
              <thead>
                <tr>
                  <th class="table-th"><%= t('Bill') %></th>
                  <th class="table-th"><%= t('Supplier') %></th>
                  <th class="table-th"><%= t('Due date') %></th>
                  <th class="table-th text-right"><%= t('Days overdue') %></th>
                  <th class="table-th text-right"><%= t('Open balance') %></th>
                  <th class="table-th text-right"><%= t('Expected date') %></th>
                  <th class="table-th text-right"><%= t('Expected cash') %></th>
                </tr>
              </thead>
              <tbody>
                <% result.payables.forEach((row) => { %>
                  <tr class="table-row">
