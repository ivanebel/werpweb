      <div class="mb-5 grid grid-cols-1 gap-5 xl:grid-cols-2">
        <div class="card">
          <div class="card-header">
            <div>
              <h2 class="card-title"><%= t('Checks in the forecast') %></h2>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= t('Open received and issued checks scheduled by due date.') %></p>
            </div>
            <a href="/checks" class="btn btn-secondary btn-sm"><%= t('All checks') %></a>
          </div>
          <div class="table-wrap <%= detailMax %>">
            <table class="table-base min-w-[720px]">
              <thead>
                <tr>
                  <th class="table-th"><%= t('Check') %></th>
                  <th class="table-th"><%= t('Party') %></th>
                  <th class="table-th"><%= t('Direction') %></th>
                  <th class="table-th"><%= t('Effective date') %></th>
                  <th class="table-th text-right"><%= t('Amount') %></th>
                </tr>
              </thead>
              <tbody>
                <% result.checks.forEach((row) => { %>
                  <tr class="table-row">
                    <td class="table-td whitespace-nowrap"><a href="/checks/<%= row.id %>" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= row.check_no %></a></td>
                    <td class="table-td"><%= row.party_name || '—' %></td>
                    <td class="table-td"><span class="badge <%= row.direction === 'in' ? 'bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-400' : 'bg-warning-50 text-warning-700 dark:bg-warning-500/15 dark:text-warning-400' %>"><%= row.direction === 'in' ? t('In') : t('Out') %></span></td>
                    <td class="table-td whitespace-nowrap"><%= h.formatDate(row.effective_date, locale) %></td>
                    <td class="table-td text-right font-medium"><%= money(row.net_amount) %></td>
                  </tr>
                <% }) %>
                <% if (!result.checks.length) { %>
                  <tr><td colspan="5" class="px-6 py-12 text-center text-sm text-gray-400"><%= t('No open checks.') %></td></tr>
                <% } %>
