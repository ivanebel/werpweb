                      <a href="/purchases/<%= row.id %>" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= row.bill_no %></a>
                      <% if (row.is_credit_note) { %><span class="ml-2 badge bg-blue-light-50 text-blue-light-700 dark:bg-blue-light-500/15 dark:text-blue-light-300"><%= t('Credit note') %></span><% } %>
                    </td>
                    <td class="table-td"><%= row.party_name %></td>
                    <td class="table-td whitespace-nowrap"><%= h.formatDate(row.due_date, locale) %></td>
                    <td class="table-td text-right <%= row.days_overdue > 0 ? 'text-warning-600 dark:text-warning-400' : 'text-gray-400' %>"><%= row.days_overdue %></td>
                    <td class="table-td text-right"><%= money(row.net_amount) %></td>
                    <td class="table-td text-right whitespace-nowrap"><%= h.formatDate(row.expected_date, locale) %></td>
                    <td class="table-td text-right font-medium"><%= money(row.expected_amount) %></td>
                  </tr>
                <% }) %>
                <% if (!result.payables.length) { %>
                  <tr><td colspan="7" class="px-6 py-12 text-center text-sm text-gray-400"><%= t('No open payables.') %></td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
