<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<%
  const typeLabel = (value) => t((withholdingTypes.find((item) => item.value === value) || { label: 'Other' }).label);
  const typeClass = {
    tax: 'bg-blue-light-50 text-blue-light-700 ring-blue-light-600/20 dark:bg-blue-light-500/15 dark:text-blue-light-400',
    commercial: 'bg-brand-50 text-brand-700 ring-brand-600/20 dark:bg-brand-500/15 dark:text-brand-400',
    administrative: 'bg-warning-50 text-warning-700 ring-warning-600/20 dark:bg-warning-500/15 dark:text-warning-400',
    other: 'bg-gray-100 text-gray-600 ring-gray-500/20 dark:bg-gray-800 dark:text-gray-300',
  };
%>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1200px]">
      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= t('Withholdings') %></h1>
          <p class="page-subtitle"><%= t('Manage the deductions customers apply to payments, such as tax withholdings, commercial agreements and administrative charges.') %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/finance/costs" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'arrow-left', className: 'h-4 w-4' }) %> <%= t('Costs & profitability') %>
          </a>
          <a href="/finance/customer-withholdings" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'users', className: 'h-4 w-4' }) %> <%= t('Customer withholdings') %>
          </a>
          <a href="/finance/withholdings/new" class="btn btn-primary btn-sm">
            <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %> <%= t('New withholding') %>
          </a>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <div>
            <h2 class="card-title"><%= t('Withholding registry') %></h2>
            <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= t('Create the concepts first, then assign them to customers with a percentage of gross sales.') %></p>
          </div>
          <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300"><%= t('{count} records', { count: rows.length }) %></span>
        </div>
        <div class="table-wrap">
          <table class="table-base min-w-[900px]">
            <thead>
              <tr>
                <th class="table-th"><%= t('Code') %></th>
                <th class="table-th"><%= t('Withholding') %></th>
                <th class="table-th"><%= t('Type') %></th>
                <th class="table-th"><%= t('Status') %></th>
                <th class="table-th text-right"><%= t('Assigned customers') %></th>
                <th class="table-th text-right"><%= t('Actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach((row) => { %>
                <tr class="table-row">
                  <td class="table-td font-mono text-sm font-medium text-gray-900 dark:text-white/90"><%= row.code %></td>
                  <td class="table-td">
                    <p class="font-medium text-gray-900 dark:text-white/90"><%= row.name %></p>
                    <% if (row.notes) { %><p class="mt-0.5 text-xs text-gray-400"><%= row.notes %></p><% } %>
                  </td>
                  <td class="table-td">
                    <span class="badge <%= typeClass[row.type] || typeClass.other %>"><%= typeLabel(row.type) %></span>
                  </td>
                  <td class="table-td"><%- statusBadge(row.status) %></td>
                  <td class="table-td text-right text-sm text-gray-500 dark:text-gray-400">
                    <% if (Number(row.customer_count)) { %>
                      <a href="/finance/customer-withholdings" class="link"><%= t('{count} customers', { count: row.customer_count }) %></a>
                    <% } else { %>—<% } %>
                  </td>
                  <td class="table-td text-right">
                    <div class="flex justify-end gap-1">
                      <a href="/finance/withholdings/<%= row.id %>/edit" class="btn btn-secondary btn-sm"><%= t('Edit') %></a>
                      <% if (!Number(row.customer_count)) { %>
                        <form method="POST" action="/finance/withholdings/<%= row.id %>/delete" data-confirm="<%= t('Delete this withholding?') %>">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-danger btn-sm"><%= t('Delete') %></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!rows.length) { %>
                <tr>
                  <td colspan="6" class="px-6 py-12 text-center">
                    <p class="text-sm text-gray-500 dark:text-gray-400"><%= t('No withholdings configured yet.') %></p>
                    <a href="/finance/withholdings/new" class="btn btn-primary btn-sm mt-4"><%= t('New withholding') %></a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
</div>
