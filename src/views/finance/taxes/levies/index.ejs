<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<%
  const taxTypeLabel = (value) => (taxTypes.find((item) => item.value === value) || { label: value || 'Other' }).label;
%>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1100px]">
      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= t('Levies and withholdings') %></h1>
          <p class="page-subtitle"><%= t('Manage the levies applied to purchase invoices and the withholdings used on customer payments.') %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/finance/taxes" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'arrow-left', className: 'h-4 w-4' }) %> <%= t('Back to taxes') %>
          </a>
          <a href="/finance/taxes/levies/new" class="btn btn-primary btn-sm">
            <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %> <%= t('New levy or withholding') %>
          </a>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <div>
            <h2 class="card-title"><%= t('Levy and withholding registry') %></h2>
            <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= t('Codes are usually the three-digit code used by the tax authority.') %></p>
          </div>
          <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300"><%= t('{count} records', { count: rows.length }) %></span>
        </div>
        <div class="table-wrap">
          <table class="table-base min-w-[900px]">
            <thead>
              <tr>
                <th class="table-th"><%= t('Code') %></th>
                <th class="table-th"><%= t('Name') %></th>
                <th class="table-th"><%= t('Type') %></th>
                <th class="table-th text-right"><%= t('Default percentage') %></th>
                <th class="table-th"><%= t('Expiry date') %></th>
                <th class="table-th"><%= t('Status') %></th>
                <th class="table-th"><%= t('Used by') %></th>
                <th class="table-th text-right"><%= t('Actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach((row) => { const expired = row.expiry_date && String(row.expiry_date).slice(0, 10) < h.todayISO(); %>
                <tr class="table-row">
                  <td class="table-td font-mono text-sm font-medium text-gray-900 dark:text-white/90"><%= row.code %></td>
                  <td class="table-td">
                    <p class="font-medium text-gray-900 dark:text-white/90"><%= row.name %></p>
                    <p class="mt-0.5 text-xs text-gray-400"><%= taxTypeLabel(row.tax_type) %><% if (row.jurisdiction_name) { %> · <%= row.jurisdiction_name %><% } %></p>
                    <% if (row.notes) { %><p class="mt-0.5 text-xs text-gray-400"><%= row.notes %></p><% } %>
                  </td>
                  <td class="table-td">
                    <% if (row.levy_type === 'withholding') { %>
                      <span class="badge bg-blue-light-50 text-blue-light-700 ring-blue-light-600/20 dark:bg-blue-light-500/15 dark:text-blue-light-400"><%= t('Withholding') %></span>
                    <% } else { %>
                      <span class="badge bg-brand-50 text-brand-700 ring-brand-600/20 dark:bg-brand-500/15 dark:text-brand-400"><%= t('Levy') %></span>
                    <% } %>
                  </td>
                  <td class="table-td text-right font-medium"><%= h.formatNumber(row.default_percentage, 4) %>%</td>
                  <td class="table-td">
                    <% if (row.expiry_date) { %>
                      <span class="<%= expired ? 'text-warning-600 dark:text-warning-400' : 'text-gray-600 dark:text-gray-300' %>"><%= h.formatDate(row.expiry_date) %></span>
                      <% if (expired) { %><span class="ml-1 text-[11px] text-warning-600 dark:text-warning-400"><%= t('Expired') %></span><% } %>
                    <% } else { %>
                      <span class="text-gray-400">—</span>
                    <% } %>
                  </td>
                  <td class="table-td"><%- statusBadge(row.status) %></td>
                  <td class="table-td text-sm text-gray-500 dark:text-gray-400"><%= Number(row.usage_count) ? t('{count} purchase invoices', { count: row.usage_count }) : '—' %></td>
                  <td class="table-td text-right">
                    <div class="flex justify-end gap-1">
                      <a href="/finance/taxes/levies/<%= row.id %>/edit" class="btn btn-secondary btn-sm"><%= t('Edit') %></a>
                      <% if (!Number(row.usage_count)) { %>
                        <form method="POST" action="/finance/taxes/levies/<%= row.id %>/delete" data-confirm="<%= t('Delete this levy or withholding?') %>">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-danger btn-sm"><%= t('Delete') %></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!rows.length) { %>
                <tr><td colspan="8" class="px-6 py-12 text-center text-sm text-gray-400"><%= t('No levies or withholdings configured yet.') %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
</div>
