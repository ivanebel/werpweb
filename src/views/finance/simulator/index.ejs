<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1600px]">

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="page-title"><%= t('Sales simulator') %></h1>
            <span class="badge bg-brand-50 text-brand-700 ring-brand-600/20 dark:bg-brand-500/15 dark:text-brand-400"><%= t('Scenario planning') %></span>
          </div>
          <p class="page-subtitle"><%= t('Build a basket of sales and project revenue, margin, purchases and cash.') %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/finance/costs" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'arrow-left', className: 'h-4 w-4' }) %>
            <%= t('Costs & profitability') %>
          </a>
          <a href="/finance/simulator/new" class="btn btn-primary btn-sm">
            <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
            <%= t('New scenario') %>
          </a>
        </div>
      </div>

      <div class="mb-5 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="card p-5">
          <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Scenarios') %></p>
          <p class="mt-2 text-2xl font-bold text-gray-900 dark:text-white"><%= counts.total %></p>
        </div>
        <div class="card p-5">
          <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Active') %></p>
          <p class="mt-2 text-2xl font-bold text-success-600 dark:text-success-400"><%= counts.active %></p>
        </div>
        <div class="card p-5">
          <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Draft') %></p>
          <p class="mt-2 text-2xl font-bold text-gray-900 dark:text-white"><%= counts.draft %></p>
        </div>
        <div class="card p-5">
          <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Locked') %></p>
          <p class="mt-2 text-2xl font-bold text-warning-600 dark:text-warning-400"><%= counts.locked %></p>
        </div>
      </div>

      <form id="compare-form" method="GET" action="/finance/simulator/compare"></form>

      <div class="card">
        <div class="flex flex-col gap-4 border-b border-gray-100 p-5 dark:border-gray-800 md:flex-row md:items-end md:justify-between">
          <form method="GET" action="/finance/simulator" class="flex flex-1 flex-wrap items-end gap-3">
            <div class="min-w-[220px] flex-1 md:max-w-sm">
              <label for="q" class="form-label"><%= t('Search') %></label>
              <div class="relative">
                <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400">
                  <%- include('/partials/icon', { name: 'search', className: 'h-4 w-4' }) %>
                </span>
                <input id="q" type="search" name="q" value="<%= search %>" class="form-input pl-10" placeholder="<%= t('Search scenarios…') %>">
              </div>
            </div>
            <div class="w-full sm:w-auto">
              <label for="status" class="form-label"><%= t('Status') %></label>
              <select id="status" name="status" class="form-select sm:w-44">
                <option value=""><%= t('All statuses') %></option>
                <% statuses.forEach((value) => { %>
                  <option value="<%= value %>" <%= status === value ? 'selected' : '' %>><%= t(value.charAt(0).toUpperCase() + value.slice(1)) %></option>
                <% }) %>
              </select>
            </div>
            <button type="submit" class="btn btn-secondary"><%= t('Apply') %></button>
            <% if (search || status) { %><a href="/finance/simulator" class="btn btn-ghost"><%= t('Reset') %></a><% } %>
          </form>
          <div class="flex flex-wrap items-center gap-2">
            <button type="submit" form="compare-form" class="btn btn-secondary btn-sm">
              <%- include('/partials/icon', { name: 'chart', className: 'h-4 w-4' }) %>
              <%= t('Compare selected') %>
            </button>
            <span class="shrink-0 rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
              <%= h.pluralize(scenarios.length, 'scenario') %>
            </span>
          </div>
        </div>

        <div class="table-wrap">
          <table class="table-base min-w-[1100px]">
            <thead>
              <tr>
                <th class="table-th w-10"></th>
                <th class="table-th"><%= t('Scenario') %></th>
                <th class="table-th"><%= t('Start month') %></th>
                <th class="table-th text-right"><%= t('Horizon') %></th>
                <th class="table-th text-right"><%= t('Monthly lines') %></th>
                <th class="table-th"><%= t('Status') %></th>
                <th class="table-th"><%= t('Updated') %></th>
                <th class="table-th text-right"><%= t('Actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% scenarios.forEach((scenario) => { %>
                <tr class="table-row">
                  <td class="table-td">
                    <input type="checkbox" name="ids" value="<%= scenario.id %>" form="compare-form" class="form-checkbox" aria-label="<%= t('Compare {name}', { name: scenario.name }) %>">
                  </td>
                  <td class="table-td">
                    <a href="/finance/simulator/<%= scenario.id %>" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= scenario.name %></a>
                    <% if (scenario.description) { %><p class="mt-0.5 max-w-md truncate text-xs text-gray-400"><%= scenario.description %></p><% } %>
                  </td>
                  <td class="table-td text-gray-600 dark:text-gray-300"><%= scenario.start_label %></td>
                  <td class="table-td text-right"><%= t('{count} months', { count: scenario.horizon_months }) %></td>
                  <td class="table-td text-right"><%= h.formatNumber(scenario.line_count || 0, 0) %></td>
                  <td class="table-td"><%- statusBadge(scenario.status) %></td>
                  <td class="table-td text-xs text-gray-500 dark:text-gray-400"><%= h.formatDateTime(scenario.updated_at) %></td>
                  <td class="table-td">
                    <div class="flex items-center justify-end gap-1">
                      <a href="/finance/simulator/<%= scenario.id %>" class="btn-icon" title="<%= t('View results') %>">
                        <%- include('/partials/icon', { name: 'eye', className: 'h-4 w-4' }) %>
                      </a>
                      <% if (!['locked', 'archived'].includes(scenario.status)) { %>
                        <a href="/finance/simulator/<%= scenario.id %>/edit" class="btn-icon" title="<%= t('Edit') %>">
                          <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %>
                        </a>
                      <% } %>
                      <form action="/finance/simulator/<%= scenario.id %>/duplicate" method="POST" class="inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-icon" title="<%= t('Duplicate') %>">
                          <%- include('/partials/icon', { name: 'clipboard', className: 'h-4 w-4' }) %>
                        </button>
                      </form>
                      <form action="/finance/simulator/<%= scenario.id %>/delete" method="POST" class="inline" data-confirm="<%= t('Delete this scenario?') %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-icon text-error-500 hover:bg-error-50 hover:text-error-600 dark:text-error-400 dark:hover:bg-error-500/10" title="<%= t('Delete') %>">
                          <%- include('/partials/icon', { name: 'trash', className: 'h-4 w-4' }) %>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!scenarios.length) { %>
                <tr>
                  <td colspan="8" class="px-6 py-16 text-center">
                    <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400 dark:bg-gray-800">
                      <%- include('/partials/icon', { name: 'chart', className: 'h-6 w-6' }) %>
                    </span>
                    <p class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= t('No scenarios found') %></p>
                    <p class="mt-1 text-sm text-gray-400"><%= t('Create a scenario to simulate a group of sales and its impact on purchases and finances.') %></p>
                    <a href="/finance/simulator/new" class="btn btn-primary btn-sm mt-4"><%= t('New scenario') %></a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
</div>
