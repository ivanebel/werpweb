<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1600px]">
      <%
        const dayLabels = { mon: t('Mon'), tue: t('Tue'), wed: t('Wed'), thu: t('Thu'), fri: t('Fri'), sat: t('Sat'), sun: t('Sun') };
      %>

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= t('Shifts') %></h1>
          <p class="page-subtitle"><%= t('Define working schedules and assign employees. Grace periods absorb small early departures or late arrivals without flagging them.') %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/attendance" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'calendar', className: 'h-4 w-4' }) %>
            <%= t('Attendance') %>
          </a>
          <a href="/shifts/new" class="btn btn-primary btn-sm">
            <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
            <%= t('New shift') %>
          </a>
        </div>
      </div>

      <div class="card">
        <div class="flex flex-col gap-2 border-b border-gray-100 px-5 py-4 dark:border-gray-800 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="card-title"><%= t('Working schedules') %></h2>
            <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= t('Times are stored in UTC, like the rest of the application.') %></p>
          </div>
          <span class="shrink-0 rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <%= h.pluralize(rows.length, 'shift') %>
          </span>
        </div>

        <% if (rows.length) { %>
          <div class="table-wrap">
            <table class="table-base min-w-[1080px]">
              <thead>
                <tr>
                  <th class="table-th"><%= t('Shift') %></th>
                  <th class="table-th"><%= t('Schedule') %></th>
                  <th class="table-th text-right"><%= t('Hours') %></th>
                  <th class="table-th text-right"><%= t('Tardiness grace') %></th>
                  <th class="table-th text-right"><%= t('Early-leave grace') %></th>
                  <th class="table-th text-right"><%= t('Assigned') %></th>
                  <th class="table-th"><%= t('Status') %></th>
                  <th class="table-th text-right"><%= t('Actions') %></th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(shift => { %>
                  <tr class="table-row">
                    <td class="table-td">
                      <a href="/shifts/<%= shift.id %>" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= shift.name %></a>
                      <% if (shift.notes) { %><span class="mt-0.5 block max-w-[260px] truncate text-xs text-gray-400"><%= shift.notes %></span><% } %>
                    </td>
                    <td class="table-td">
                      <div class="flex flex-wrap items-center gap-1">
                        <% shift.days.forEach(day => { %>
                          <span class="rounded-md bg-gray-100 px-1.5 py-0.5 text-[11px] font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300"><%= dayLabels[day] || day %></span>
                        <% }) %>
                      </div>
                      <span class="mt-1 block text-xs text-gray-500 dark:text-gray-400"><%= h.formatTime(shift.start_time) %> – <%= h.formatTime(shift.end_time) %></span>
                    </td>
                    <td class="table-td text-right font-medium"><%= h.formatDuration(shift.duration_minutes) %></td>
                    <td class="table-td text-right">
                      <span class="text-gray-600 dark:text-gray-300"><%= h.formatDuration(shift.grace_minutes) %></span>
                    </td>
                    <td class="table-td text-right">
                      <span class="text-gray-600 dark:text-gray-300"><%= h.formatDuration(shift.early_leave_grace_minutes) %></span>
                    </td>
                    <td class="table-td text-right">
                      <span class="font-medium text-gray-800 dark:text-gray-200"><%= h.formatNumber(shift.active_assignments, 0) %></span>
                      <span class="text-xs text-gray-400"> / <%= h.formatNumber(shift.total_assignments, 0) %></span>
                    </td>
                    <td class="table-td"><%- statusBadge(shift.status) %></td>
                    <td class="table-td">
                      <div class="flex items-center justify-end gap-1">
                        <a href="/shifts/<%= shift.id %>" class="btn-icon" title="<%= t('View') %>">
                          <%- include('/partials/icon', { name: 'eye', className: 'h-4 w-4' }) %>
                        </a>
                        <a href="/shifts/<%= shift.id %>/edit" class="btn-icon" title="<%= t('Edit') %>">
                          <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %>
                        </a>
                        <form action="/shifts/<%= shift.id %>/delete" method="POST" class="inline" data-confirm="<%= t('Delete this shift? This cannot be undone.') %>">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn-icon text-error-500 hover:bg-error-50 hover:text-error-600 dark:text-error-400 dark:hover:bg-error-500/10" title="<%= t('Delete') %>">
                            <%- include('/partials/icon', { name: 'trash', className: 'h-4 w-4' }) %>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="px-6 py-16 text-center">
            <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400 dark:bg-gray-800">
              <%- include('/partials/icon', { name: 'clock', className: 'h-6 w-6' }) %>
            </span>
            <p class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= t('No shifts yet') %></p>
            <p class="mt-1 text-sm text-gray-400"><%= t('Create your first shift to start assigning employees and tracking attendance.') %></p>
            <a href="/shifts/new" class="btn btn-primary btn-sm mt-4"><%= t('New shift') %></a>
          </div>
        <% } %>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
</div>
