<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1400px]">
      <%
        const backUrl = mode === 'edit' ? `/manufacturing/production-orders/${row.id}` : '/manufacturing/production-orders';
        const errorList = [...Object.values(errors || {}), ...(lineErrors || [])];
      %>

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= mode === 'create' ? t('New production order') : t('Edit {number}', { number: row.production_no }) %></h1>
          <p class="page-subtitle"><%= mode === 'create' ? t('Add one or more active BOMs. Each line is a different product with its own quantity, lot and expiry.') : t('Update the schedule, BOM lines or batch details while the order is still planned.') %></p>
        </div>
        <a href="<%= backUrl %>" class="btn btn-secondary btn-sm">
          <%- include('/partials/icon', { name: 'arrow-left', className: 'h-4 w-4' }) %> Back
        </a>
      </div>

      <% if (errorList.length) { %>
        <div class="mb-5 rounded-xl border border-error-200 bg-error-50 p-4 dark:border-error-500/30 dark:bg-error-500/10">
          <div class="flex items-start gap-3">
            <span class="mt-0.5 text-error-500"><%- include('/partials/icon', { name: 'exclamation-triangle', className: 'h-5 w-5' }) %></span>
            <div>
              <p class="text-sm font-semibold text-error-700 dark:text-error-400"><%= t('Please review the production order:') %></p>
              <ul class="mt-1 list-inside list-disc text-sm text-error-600 dark:text-error-400">
                <% errorList.forEach(message => { %><li><%= message %></li><% }) %>
              </ul>
            </div>
          </div>
        </div>
      <% } %>

      <form method="POST" action="<%= action %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="grid grid-cols-1 gap-5 xl:grid-cols-3">
          <div class="xl:col-span-2">
            <div class="card">
              <div class="card-header">
                <h2 class="card-title"><%= t('Order details') %></h2>
                <span class="font-mono text-xs text-gray-400"><%= mode === 'edit' ? row.production_no : t('Number assigned on save') %></span>
              </div>
              <div class="grid grid-cols-1 gap-5 p-5 md:grid-cols-2 md:p-6">
                <div class="md:col-span-2">
                  <label for="sales_order_id" class="form-label"><%= t('Sales order') %></label>
                  <select id="sales_order_id" name="sales_order_id" class="form-select">
                    <option value=""><%= t('No linked sales order') %></option>
                    <% salesOrders.forEach(opt => { %>
                      <option value="<%= opt.id %>" <%= String(row.sales_order_id || '') === String(opt.id) ? 'selected' : '' %>><%= opt.order_no %> — <%= opt.company_name %></option>
                    <% }) %>
                  </select>
                  <p class="form-help"><%= t('Optional link for traceability.') %></p>
                </div>
                <div>
                  <label for="start_date" class="form-label"><%= t('Start date') %> <span class="text-error-500">*</span></label>
                  <input id="start_date" name="start_date" type="date" value="<%= String(row.start_date || '').slice(0, 10) %>" class="form-input <%= errors.start_date ? 'form-input-error' : '' %>" required>
                  <% if (errors.start_date) { %><p class="form-error"><%= errors.start_date %></p><% } %>
                </div>
                <div>
                  <label for="due_date" class="form-label"><%= t('Due date') %></label>
                  <input id="due_date" name="due_date" type="date" value="<%= String(row.due_date || '').slice(0, 10) %>" class="form-input <%= errors.due_date ? 'form-input-error' : '' %>">
                  <% if (errors.due_date) { %><p class="form-error"><%= errors.due_date %></p><% } %>
                </div>
                <div class="md:col-span-2">
                  <label for="notes" class="form-label"><%= t('Order notes') %></label>
                  <textarea id="notes" name="notes" rows="3" class="form-textarea" placeholder="<%= t('Work centre, shift, special instructions…') %>"><%= row.notes || '' %></textarea>
                </div>
              </div>
            </div>
          </div>

          <div class="space-y-5">
            <div class="card p-5 md:p-6">
              <h2 class="card-title"><%= t('How it works') %></h2>
              <ol class="mt-3 space-y-2 text-sm text-gray-500 dark:text-gray-400">
                <li class="flex gap-2"><span class="font-semibold text-gray-400">1.</span> <%= t('Add each BOM you want to manufacture in this run.') %></li>
                <li class="flex gap-2"><span class="font-semibold text-gray-400">2.</span> <%= t('Set the quantity, lot number and expiry date for every line.') %></li>
                <li class="flex gap-2"><span class="font-semibold text-gray-400">3.</span> <%= t('Shared components are merged into one material requirement.') %></li>
                <li class="flex gap-2"><span class="font-semibold text-gray-400">4.</span> <%= t('Completing the order consumes materials and adds every finished product to stock.') %></li>
              </ol>
            </div>

            <div class="card p-5 md:p-6">
              <h2 class="card-title"><%= t('Material availability') %></h2>
              <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= t('Materials are recalculated from all BOM lines when you save the order.') %></p>
            </div>
          </div>
        </div>

        <div class="card mt-5">
          <div class="card-header">
            <div>
              <h2 class="card-title"><%= t('BOM lines') %></h2>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= t('Each BOM line produces one product. Shared materials are combined in the final material list.') %></p>
            </div>
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
                <span id="line-count"><%= lines.length %></span> <%= t('BOM lines') %>
              </span>
              <button type="button" id="add-line" class="btn btn-secondary btn-sm">
                <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
                <%= t('Add BOM line') %>
              </button>
            </div>
          </div>

          <div class="table-wrap">
            <table class="table-base min-w-[820px]">
              <thead>
                <tr>
                  <th class="table-th"><%= t('BOM') %></th>
                  <th class="table-th text-right"><%= t('Quantity') %></th>
                  <th class="table-th"><%= t('Lot number') %></th>
                  <th class="table-th"><%= t('Expiry date') %></th>
                  <th class="table-th"><%= t('Line notes') %></th>
                  <th class="table-th"></th>
                </tr>
              </thead>
              <tbody id="line-rows">
                <% lines.forEach((line, index) => {
                  const lineLot = line.lot_number || '';
                  const autoLot = !lineLot || lineLot === defaultLot;
                %>
                  <tr class="table-row" data-line-row>
                    <td class="table-td align-top">
                      <select name="line_bom_id" class="form-select min-w-[190px]" required>
                        <option value=""><%= t('Select an active BOM…') %></option>
                        <% boms.forEach(opt => { %>
                          <option
                            value="<%= opt.id %>"
                            data-product="<%= opt.product_name %>"
                            data-sku="<%= opt.sku %>"
                            data-unit="<%= opt.unit %>"
                            data-output="<%= opt.output_qty %>"
                            data-version="<%= opt.version %>"
                            <%= String(line.bom_id || '') === String(opt.id) ? 'selected' : '' %>
                          ><%= opt.product_name %> — <%= opt.name %> (<%= opt.version %>)<%= opt.status !== 'active' ? ` · ${t('Inactive')}` : '' %></option>
                        <% }) %>
                      </select>
                      <p class="mt-1 text-xs text-gray-400" data-line-info></p>
                    </td>
                    <td class="table-td align-top">
                      <input name="line_quantity" type="number" min="0.001" step="0.001" value="<%= line.quantity !== undefined && line.quantity !== '' ? line.quantity : 1 %>" class="form-input w-28 text-right" required>
                      <p class="mt-1 text-right text-xs text-gray-400" data-line-unit></p>
                    </td>
                    <td class="table-td align-top">
                      <input name="line_lot_number" type="text" maxlength="60" value="<%= lineLot %>" class="form-input min-w-[100px]" data-auto-lot="<%= autoLot ? 'true' : 'false' %>" required>
                    </td>
                    <td class="table-td align-top">
                      <input name="line_expiry_date" type="date" value="<%= String(line.expiry_date || '').slice(0, 10) %>" class="form-input" required>
                    </td>
                    <td class="table-td align-top">
                      <input name="line_notes" type="text" maxlength="5000" value="<%= line.notes || '' %>" class="form-input min-w-[120px]" placeholder="<%= t('Optional line notes') %>">
                    </td>
                    <td class="table-td align-top text-right">
                      <button type="button" class="btn-icon text-error-500 hover:bg-error-50 hover:text-error-600 dark:text-error-400 dark:hover:bg-error-500/10" data-remove-line title="<%= t('Remove line') %>">
                        <%- include('/partials/icon', { name: 'trash', className: 'h-4 w-4' }) %>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-5 flex flex-col-reverse justify-end gap-3 sm:flex-row">
          <a href="<%= backUrl %>" class="btn btn-secondary"><%= t('Cancel') %></a>
          <button type="submit" class="btn btn-primary">
            <%- include('/partials/icon', { name: 'check', className: 'h-4 w-4' }) %>
            <%= mode === 'create' ? t('Create production order') : t('Save changes') %>
          </button>
        </div>
      </form>
    </div>
  </main>
  <%- include('/layouts/footer') %>

  <script>
    (function () {
      const start = document.getElementById('start_date');
      const body = document.getElementById('line-rows');
      const addButton = document.getElementById('add-line');
      const count = document.getElementById('line-count');
      if (!start || !body || !addButton) return;

      const lotFromISO = (value) => {
        const match = String(value || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
        return match ? `${match[3]}.${match[2]}.${match[1].slice(2)}` : '';
      };

      function updateCount() {
        if (count) count.textContent = String(body.querySelectorAll('[data-line-row]').length);
      }

      function updateLineInfo(row) {
        const select = row.querySelector('select[name="line_bom_id"]');
        const info = row.querySelector('[data-line-info]');
        const unit = row.querySelector('[data-line-unit]');
        if (!select || !info || !unit) return;
        const option = select.options[select.selectedIndex];
        if (!option || !option.value) {
          info.textContent = '';
          unit.textContent = '';
          return;
        }
        const output = option.dataset.output || '1';
        const productUnit = option.dataset.unit || '';
        info.textContent = `${option.dataset.sku || ''} · BOM output: ${output} ${productUnit}`.trim();
        unit.textContent = productUnit ? `(${productUnit})` : '';
      }

      function prepareRow(row) {
        row.querySelectorAll('input').forEach((input) => {
          if (input.name === 'line_quantity') input.value = '1';
          else input.value = '';
        });
        row.querySelectorAll('select').forEach((select) => {
          select.selectedIndex = 0;
        });
        const lot = row.querySelector('input[name="line_lot_number"]');
        if (lot) {
          lot.value = lotFromISO(start.value);
          lot.dataset.autoLot = 'true';
        }
        updateLineInfo(row);
      }

      addButton.addEventListener('click', () => {
        const rows = body.querySelectorAll('[data-line-row]');
        if (!rows.length) return;
        const clone = rows[rows.length - 1].cloneNode(true);
        prepareRow(clone);
        body.appendChild(clone);
        updateCount();
      });

      body.addEventListener('click', (event) => {
        const button = event.target.closest('[data-remove-line]');
        if (!button) return;
        const rows = body.querySelectorAll('[data-line-row]');
        if (rows.length <= 1) return;
        button.closest('[data-line-row]').remove();
        updateCount();
      });

      body.addEventListener('change', (event) => {
        if (event.target.matches('select[name="line_bom_id"]')) {
          updateLineInfo(event.target.closest('[data-line-row]'));
        }
      });

      body.addEventListener('input', (event) => {
        if (event.target.matches('input[name="line_lot_number"]')) {
          event.target.dataset.autoLot = 'false';
        }
      });

      start.addEventListener('change', () => {
        const lot = lotFromISO(start.value);
        body.querySelectorAll('input[name="line_lot_number"]').forEach((input) => {
          if (input.dataset.autoLot === 'true') input.value = lot;
        });
      });

      body.querySelectorAll('[data-line-row]').forEach(updateLineInfo);
      updateCount();
    })();
  </script>
</div>
