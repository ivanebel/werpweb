<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1400px]">
      <%
        const toneClass = { primary: 'btn-primary', secondary: 'btn-secondary', danger: 'btn-danger', success: 'btn-success' };
        const totalCost = materials.reduce((sum, m) => sum + Number(m.line_cost || 0), 0);
        const steps = ['planned', 'released', 'in_progress', 'completed'];
        const currentStep = steps.indexOf(order.status);
        const missingBatch = lines.filter((line) => !line.lot_number || !line.expiry_date);
        const activeOrder = ['planned', 'released', 'in_progress'].includes(order.status);
      %>

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="page-title"><%= order.production_no %></h1>
            <%- statusBadge(order.status) %>
          </div>
          <p class="page-subtitle">
            <%= lines.length %> <%= t('BOM lines') %>
            · <%= t('Start') %> <%= h.formatDate(order.start_date) %>
            · <%= t('Due') %> <%= h.formatDate(order.due_date) %>
            <% if (order.order_no) { %>· <%= t('for') %> <a href="/sales-orders/<%= order.sales_order_id %>" class="link"><%= order.order_no %></a><% } %>
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/manufacturing/production-orders" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'arrow-left', className: 'h-4 w-4' }) %> Back
          </a>
          <% actions.forEach(a => { %>
            <% if (a.href) { %>
              <a href="<%= a.href %>" class="btn <%= toneClass[a.tone] || 'btn-secondary' %> btn-sm"><%= a.label %></a>
            <% } else { %>
              <% const confirmText = a.value === 'completed'
                ? t('Complete this production order? Material stock will be consumed and finished goods added.')
                : t('Change this production order status?'); %>
              <form method="POST" action="/manufacturing/production-orders/<%= order.id %>/status" class="inline"<% if (a.confirm) { %> data-confirm="<%= confirmText %>"<% } %>>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="status" value="<%= a.value %>">
                <button type="submit" class="btn <%= toneClass[a.tone] || 'btn-secondary' %> btn-sm"><%= a.label %></button>
              </form>
            <% } %>
          <% }) %>
          <% if (['planned', 'cancelled'].includes(order.status)) { %>
            <form method="POST" action="/manufacturing/production-orders/<%= order.id %>/delete" data-confirm="<%= t('Delete {number}? This cannot be undone.', { number: order.production_no }) %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-danger btn-sm">
                <%- include('/partials/icon', { name: 'trash', className: 'h-4 w-4' }) %> Delete
              </button>
            </form>
          <% } %>
        </div>
      </div>

      <% if (missingBatch.length && activeOrder) { %>
        <div class="mb-5 flex items-start gap-3 rounded-xl border border-warning-200 bg-warning-50 px-4 py-3 text-sm text-warning-700 dark:border-warning-500/30 dark:bg-warning-500/10 dark:text-warning-300">
          <%- include('/partials/icon', { name: 'exclamation-triangle', className: 'h-5 w-5 shrink-0' }) %>
          <p><%= t('Some BOM lines are missing a lot number or expiry date. Set them in Edit batch details before completing production.') %></p>
        </div>
      <% } %>

      <% if (shortage && activeOrder) { %>
        <div class="mb-5 flex items-start gap-3 rounded-xl border border-warning-200 bg-warning-50 px-4 py-3 text-sm text-warning-700 dark:border-warning-500/30 dark:bg-warning-500/10 dark:text-warning-300">
          <%- include('/partials/icon', { name: 'exclamation-triangle', className: 'h-5 w-5 shrink-0' }) %>
          <p><span class="font-semibold">Material shortage:</span> one or more components do not have enough stock for this order. Purchase or adjust stock before completing production.</p>
        </div>
      <% } %>

      <div class="mb-5 card p-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex flex-1 items-center gap-2">
            <% steps.forEach((step, index) => { %>
              <% const done = currentStep >= index && order.status !== 'cancelled'; %>
              <div class="flex flex-1 items-center gap-2">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold <%= done ? 'bg-brand-500 text-white' : 'bg-gray-100 text-gray-400 dark:bg-gray-800' %>">
                  <%= index + 1 %>
                </span>
                <span class="hidden text-xs font-medium sm:block <%= done ? 'text-gray-700 dark:text-gray-300' : 'text-gray-400' %>"><%= h.statusInfo(step).label %></span>
                <% if (index < steps.length - 1) { %>
                  <span class="h-px flex-1 <%= currentStep > index && order.status !== 'cancelled' ? 'bg-brand-300' : 'bg-gray-200 dark:bg-gray-800' %>"></span>
                <% } %>
              </div>
            <% }) %>
          </div>
          <% if (order.status === 'cancelled') { %>
            <span class="shrink-0 rounded-full bg-error-50 px-3 py-1.5 text-xs font-medium text-error-700 dark:bg-error-500/15 dark:text-error-400">Order cancelled</span>
          <% } %>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5 xl:grid-cols-3">
        <div class="space-y-5 xl:col-span-2">
          <div class="card overflow-hidden">
            <div class="card-header">
              <div>
                <h2 class="card-title"><%= t('Production lines') %></h2>
                <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= t('Each line is a different BOM and manufactured product.') %></p>
              </div>
              <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300"><%= h.pluralize(lines.length, 'BOM line') %></span>
            </div>
            <div class="table-wrap">
              <table class="table-base min-w-[900px]">
                <thead>
                  <tr>
                    <th class="table-th"><%= t('Product') %></th>
                    <th class="table-th"><%= t('BOM') %></th>
                    <th class="table-th text-right"><%= t('Quantity') %></th>
                    <th class="table-th"><%= t('Lot number') %></th>
                    <th class="table-th"><%= t('Expiry date') %></th>
                    <th class="table-th"><%= t('Notes') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% lines.forEach(line => { %>
                    <tr class="table-row">
                      <td class="table-td">
                        <a href="/products/<%= line.product_id %>" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= line.product_name %></a>
                        <span class="mt-0.5 block font-mono text-xs text-gray-400"><%= line.sku %> · <%= line.unit %></span>
                      </td>
                      <td class="table-td">
                        <a href="/manufacturing/boms/<%= line.bom_id %>" class="text-gray-700 hover:text-brand-600 dark:text-gray-300 dark:hover:text-brand-400"><%= line.bom_name %></a>
                        <span class="mt-0.5 block text-xs text-gray-400"><%= line.version %> · <%= t('output') %> <%= h.formatQty(line.output_qty) %></span>
                      </td>
                      <td class="table-td text-right font-medium"><%= h.formatQty(line.quantity) %> <span class="text-xs font-normal text-gray-400"><%= line.unit %></span></td>
                      <td class="table-td">
                        <span class="font-mono text-xs text-gray-700 dark:text-gray-300"><%= line.lot_number || '—' %></span>
                        <% if (line.lot_number) { %>
                          <a href="/manufacturing/scale-records?lot=<%= encodeURIComponent(line.lot_number) %>" class="mt-0.5 block text-[11px] text-brand-600 hover:underline dark:text-brand-400"><%= t('View scale records') %></a>
                        <% } %>
                      </td>
                      <td class="table-td text-gray-500 dark:text-gray-400"><%= line.expiry_date ? h.formatDate(line.expiry_date) : '—' %></td>
                      <td class="table-td text-gray-500 dark:text-gray-400"><%= line.notes ? h.truncate(line.notes, 80) : '—' %></td>
                    </tr>
                  <% }) %>
                  <% if (!lines.length) { %>
                    <tr>
                      <td colspan="6" class="px-6 py-12 text-center text-sm text-gray-400"><%= t('No BOM lines have been added to this order.') %></td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

                    <div class="card overflow-hidden">
            <div class="card-header">
              <div>
                <h2 class="card-title"><%= t('Material requirements') %></h2>
                <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= t('Aggregated from {count} BOM lines. Material classes are allocated across their members.', { count: lines.length }) %></p>
              </div>
              <div class="flex items-center gap-2">
                <% if (activeOrder) { %>
                  <form method="POST" action="/manufacturing/production-orders/<%= order.id %>/reallocate" class="inline" data-confirm="<%= t('Replace the current allocation with the priority and current stock allocation?') %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-secondary btn-sm"><%= t('Recalculate') %></button>
                  </form>
                  <a href="/manufacturing/production-orders/<%= order.id %>/materials" class="btn btn-secondary btn-sm"><%= t('Edit allocation') %></a>
                <% } %>
                <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300"><%= h.pluralize(requirements.length, 'requirement') %></span>
              </div>
            </div>
            <div class="table-wrap">
              <table class="table-base min-w-[950px]">
                <thead>
                  <tr>
                    <th class="table-th"><%= t('Material / class') %></th>
                    <th class="table-th text-right"><%= t('Required') %></th>
                    <th class="table-th text-right"><%= t('Allocated') %></th>
                    <th class="table-th text-right"><%= t('Shortage') %></th>
                    <th class="table-th"><%= t('Unit') %></th>
                    <th class="table-th text-right"><%= t('BOM lines') %></th>
                    <th class="table-th"><%= t('Availability') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% requirements.forEach((requirement) => { const short = Number(requirement.shortage_qty) > 0.0005; %>
                    <tr class="table-row">
                      <td class="table-td">
                        <% if (requirement.material_class_id) { %>
                          <p class="font-medium text-gray-900 dark:text-white/90"><%= requirement.class_name %></p>
                          <p class="mt-0.5 flex flex-wrap items-center gap-2 text-xs text-gray-400"><span class="font-mono"><%= requirement.class_code %></span><span class="rounded-full bg-purple-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-purple-700 dark:bg-purple-500/15 dark:text-purple-400"><%= t('Material class') %></span></p>
                        <% } else { %>
                          <a href="/products/<%= requirement.component_id %>" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= requirement.component_name %></a>
                          <p class="mt-0.5 font-mono text-xs text-gray-400"><%= requirement.component_sku %></p>
                        <% } %>
                      </td>
                      <td class="table-td text-right font-medium"><%= h.formatQty(requirement.quantity_required) %></td>
                      <td class="table-td text-right"><%= h.formatQty(requirement.quantity_allocated) %></td>
                      <td class="table-td text-right font-semibold <%= short ? 'text-warning-600 dark:text-warning-400' : 'text-gray-400' %>"><%= h.formatQty(requirement.shortage_qty) %></td>
                      <td class="table-td"><%= requirement.unit %></td>
                      <td class="table-td text-right"><%= requirement.source_count %></td>
                      <td class="table-td">
                        <% if (short) { %>
                          <span class="badge bg-warning-50 text-warning-700 dark:bg-warning-500/15 dark:text-warning-400"><%= t('Short') %></span>
                        <% } else { %>
                          <span class="badge bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-400"><%= t('Covered') %></span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (!requirements.length) { %>
                    <tr><td colspan="7" class="px-6 py-12 text-center text-sm text-gray-400"><%= t('No material requirements snapped for this order.') %></td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="card overflow-hidden">
            <div class="card-header">
              <div>
                <h2 class="card-title"><%= t('Material allocations') %></h2>
                <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= t('Actual member products selected for each requirement.') %></p>
              </div>
              <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300"><%= h.pluralize(materials.length, 'allocation') %></span>
            </div>
            <div class="table-wrap">
              <table class="table-base min-w-[1050px]">
                <thead>
                  <tr>
                    <th class="table-th"><%= t('Member') %></th>
                    <th class="table-th"><%= t('Class') %></th>
                    <th class="table-th text-right"><%= t('Priority') %></th>
                    <th class="table-th text-right"><%= t('Allocated') %></th>
                    <th class="table-th text-right"><%= t('Consumed') %></th>
                    <th class="table-th text-right"><%= t('On hand') %></th>
                    <th class="table-th text-right"><%= t('Reserved elsewhere') %></th>
                    <th class="table-th text-right"><%= t('Unit cost') %></th>
                    <th class="table-th text-right"><%= t('Line cost') %></th>
                    <th class="table-th"><%= t('Status') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% materials.forEach((m) => {
                    const short = Number(m.track_stock) === 1 && Number(m.stock_qty) < Number(m.quantity_required);
                  %>
                    <tr class="table-row">
                      <td class="table-td">
                        <a href="/products/<%= m.component_id %>" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= m.name %></a>
                        <span class="mt-0.5 block font-mono text-xs text-gray-400"><%= m.sku %> · <%= m.unit %></span>
                      </td>
                      <td class="table-td">
                        <% if (m.material_class_id) { %>
                          <span class="text-gray-700 dark:text-gray-300"><%= m.class_name %></span>
                          <span class="mt-0.5 block font-mono text-xs text-gray-400"><%= m.class_code %></span>
                        <% } else { %>
                          <span class="text-gray-400">—</span>
                        <% } %>
                      </td>
                      <td class="table-td text-right"><%= Number(m.priority) || '—' %></td>
                      <td class="table-td text-right font-medium"><%= h.formatQty(m.quantity_required) %></td>
                      <td class="table-td text-right text-gray-500 dark:text-gray-400"><%= h.formatQty(m.quantity_consumed) %></td>
                      <td class="table-td text-right"><%= h.formatQty(m.stock_qty) %></td>
                      <td class="table-td text-right text-gray-500 dark:text-gray-400"><%= h.formatQty(m.reserved_other || 0) %></td>
                      <td class="table-td text-right"><%= money(m.unit_cost || m.cost_price) %></td>
                      <td class="table-td text-right font-medium"><%= money(m.line_cost) %></td>
                      <td class="table-td">
                        <% if (Number(m.track_stock) !== 1) { %>
                          <span class="text-xs text-gray-400"><%= t('Not tracked') %></span>
                        <% } else if (short) { %>
                          <span class="badge bg-warning-50 text-warning-700 ring-warning-600/20 dark:bg-warning-500/15 dark:text-warning-400"><%= t('Short') %></span>
                        <% } else { %>
                          <span class="badge bg-success-50 text-success-700 ring-success-600/20 dark:bg-success-500/15 dark:text-success-400"><%= t('Available') %></span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (!materials.length) { %>
                    <tr><td colspan="10" class="px-6 py-12 text-center text-sm text-gray-400"><%= t('No material allocations for this order.') %></td></tr>
                  <% } %>
                </tbody>
                <tfoot>
                  <tr class="bg-gray-50 dark:bg-white/[0.02]">
                    <td class="table-td font-semibold text-gray-800 dark:text-gray-200" colspan="8"><%= t('Estimated material cost') %></td>
                    <td class="table-td text-right font-semibold text-gray-900 dark:text-white"><%= money(totalCost) %></td>
                    <td class="table-td"></td>
                  </tr>
                </tfoot>
              </table>
            </div>
            <% if (order.notes) { %>
              <div class="border-t border-gray-100 px-6 py-4 dark:border-gray-800">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-400"><%= t('Order notes') %></p>
                <p class="mt-1 whitespace-pre-line text-sm text-gray-600 dark:text-gray-400"><%= order.notes %></p>
              </div>
            <% } %>
          </div>
        </div>

        <div class="space-y-5">
          <div class="card p-5 md:p-6">
            <div class="flex items-center justify-between">
              <h2 class="card-title"><%= t('Order status') %></h2>
              <%- statusBadge(order.status) %>
            </div>
            <dl class="mt-4 space-y-3 text-sm">
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Production no.</dt><dd class="font-mono text-xs text-gray-700 dark:text-gray-300"><%= order.production_no %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('BOM lines') %></dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= lines.length %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('Start date') %></dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= h.formatDate(order.start_date) %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('Due date') %></dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= h.formatDate(order.due_date) %></dd></div>
              <% if (order.order_no) { %>
                <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('Sales order') %></dt><dd><a href="/sales-orders/<%= order.sales_order_id %>" class="link"><%= order.order_no %></a></dd></div>
              <% } %>
              <% if (order.completed_at) { %>
                <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('Completed') %></dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= h.formatDateTime(order.completed_at) %></dd></div>
              <% } %>
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Created</dt><dd class="text-gray-700 dark:text-gray-300"><%= h.formatDate(order.created_at) %></dd></div>
            </dl>
            <% if (order.status === 'planned') { %>
              <a href="/manufacturing/production-orders/<%= order.id %>/edit" class="btn btn-secondary btn-sm mt-4 w-full">
                <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %> <%= t('Edit order') %>
              </a>
            <% } %>
            <% if (activeOrder) { %>
              <a href="/manufacturing/production-orders/<%= order.id %>/batches" class="btn btn-secondary btn-sm mt-2 w-full">
                <%- include('/partials/icon', { name: 'calendar', className: 'h-4 w-4' }) %> <%= t('Edit batch details') %>
              </a>
            <% } %>
          </div>

          <% if (order.customer_name) { %>
            <div class="card p-5 md:p-6">
              <h2 class="card-title">Customer</h2>
              <p class="mt-2 text-sm font-semibold text-gray-800 dark:text-gray-200"><%= order.customer_name %></p>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">This production run is linked to a sales order for this customer.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
</div>
