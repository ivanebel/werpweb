<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1500px]">

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= t('Machines') %></h1>
          <p class="page-subtitle"><%= t('Keep the machines used in production identified and organized by type.') %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <% if (currentUser && ['admin', 'manager'].includes(currentUser.role)) { %>
            <a href="/manufacturing/machines/new" class="btn btn-primary btn-sm">
              <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
              <%= t('New machine') %>
            </a>
          <% } %>
        </div>
      </div>

      <div class="mb-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">
            <%- include('/partials/icon', { name: 'cog', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Machines') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatNumber(counts.total, 0) %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-success-50 text-success-600 dark:bg-success-500/15 dark:text-success-400">
            <%- include('/partials/icon', { name: 'check-circle', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Active') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatNumber(counts.active, 0) %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-gray-100 text-gray-500 dark:bg-gray-800 dark:text-gray-400">
            <%- include('/partials/icon', { name: 'cog', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Inactive') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatNumber(counts.inactive, 0) %></p>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="flex flex-col gap-4 border-b border-gray-100 p-5 dark:border-gray-800 md:flex-row md:items-end md:justify-between">
          <form method="GET" action="/manufacturing/machines" class="flex flex-1 flex-wrap items-end gap-3">
            <div class="min-w-[240px] flex-1 md:max-w-md">
              <label for="q" class="form-label"><%= t('Search') %></label>
              <div class="relative">
                <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                  <%- include('/partials/icon', { name: 'search', className: 'h-4 w-4' }) %>
                </span>
                <input id="q" name="q" type="search" value="<%= search %>" class="form-input pl-9" placeholder="<%= t('Name, model or serial number…') %>">
              </div>
            </div>
            <div class="w-full sm:w-44">
              <label for="type" class="form-label"><%= t('Type') %></label>
              <select id="type" name="type" class="form-select">
                <option value=""><%= t('All types') %></option>
                <% machineTypes.forEach((type) => { %>
                  <option value="<%= type.value %>" <%= typeFilter === type.value ? 'selected' : '' %>><%= type.label %></option>
                <% }) %>
              </select>
            </div>
            <div class="w-full sm:w-40">
              <label for="status" class="form-label"><%= t('Status') %></label>
              <select id="status" name="status" class="form-select">
                <option value=""><%= t('All statuses') %></option>
                <option value="active" <%= statusFilter === 'active' ? 'selected' : '' %>><%= t('Active') %></option>
                <option value="inactive" <%= statusFilter === 'inactive' ? 'selected' : '' %>><%= t('Inactive') %></option>
              </select>
            </div>
            <button type="submit" class="btn btn-secondary btn-sm"><%= t('Apply') %></button>
            <% if (search || statusFilter || typeFilter) { %>
              <a href="/manufacturing/machines" class="btn btn-ghost btn-sm"><%= t('Clear') %></a>
            <% } %>
          </form>
          <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <%= h.pluralize(rows.length, 'machine', 'machines', locale) %>
          </span>
        </div>

        <div class="table-wrap">
          <table class="table-base min-w-[1100px]">
            <thead>
              <tr>
                <th class="table-th"><%= t('ID') %></th>
                <th class="table-th"><%= t('Short name') %></th>
                <th class="table-th"><%= t('Complete name / brand / model') %></th>
                <th class="table-th"><%= t('Type') %></th>
                <th class="table-th"><%= t('Serial number') %></th>
                <th class="table-th"><%= t('Status') %></th>
                <th class="table-th text-right"><%= t('Actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach((row) => { %>
                <tr class="table-row">
                  <td class="table-td font-mono text-xs text-gray-500 dark:text-gray-400">M-<%= String(row.id).padStart(4, '0') %></td>
                  <td class="table-td">
                    <% if (currentUser && ['admin', 'manager'].includes(currentUser.role)) { %>
                      <a href="/manufacturing/machines/<%= row.id %>/edit" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= row.name %></a>
                    <% } else { %>
                      <span class="font-medium text-gray-900 dark:text-white/90"><%= row.name %></span>
                    <% } %>
                  </td>
                  <td class="table-td text-gray-600 dark:text-gray-300"><%= row.full_name %></td>
                  <td class="table-td">
                    <span class="badge bg-brand-50 text-brand-700 ring-brand-600/20 dark:bg-brand-500/15 dark:text-brand-400"><%= machineTypeLabel(row.machine_type) %></span>
                  </td>
                  <td class="table-td font-mono text-xs text-gray-500 dark:text-gray-400"><%= row.serial_number || '—' %></td>
                  <td class="table-td"><%- statusBadge(row.status) %></td>
                  <td class="table-td text-right">
                    <div class="flex items-center justify-end gap-1">
                      <% if (currentUser && ['admin', 'manager'].includes(currentUser.role)) { %>
                        <a href="/manufacturing/machines/<%= row.id %>/edit" class="btn-icon" title="<%= t('Edit') %>">
                          <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %>
                        </a>
                        <form action="/manufacturing/machines/<%= row.id %>/status" method="POST" class="inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-ghost btn-sm" title="<%= row.status === 'active' ? t('Deactivate') : t('Activate') %>">
                            <%= row.status === 'active' ? t('Deactivate') : t('Activate') %>
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!rows.length) { %>
                <tr>
                  <td colspan="7" class="px-6 py-12 text-center text-sm text-gray-400">
                    <%= t('No machines yet. Add the machines used in production to keep them identified.') %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
</div>
