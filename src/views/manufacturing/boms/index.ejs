<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1600px]">

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title">Bills of materials</h1>
          <p class="page-subtitle">Define fixed components or material classes, quantities and scrap for every manufactured product.</p>
        </div>
        <a href="/manufacturing/boms/new" class="btn btn-primary btn-sm">
          <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
          New BOM
        </a>
      </div>

      <div class="card">
        <div class="flex flex-col gap-4 border-b border-gray-100 p-5 dark:border-gray-800 md:flex-row md:items-end md:justify-between">
          <form method="GET" action="/manufacturing/boms" class="flex flex-1 flex-wrap items-end gap-3">
            <div class="min-w-[240px] flex-1 md:max-w-md">
              <label for="q" class="form-label">Search</label>
              <div class="relative">
                <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400">
                  <%- include('/partials/icon', { name: 'search', className: 'h-4 w-4' }) %>
                </span>
                <input id="q" type="search" name="q" value="<%= search %>" class="form-input pl-10" placeholder="Product, SKU, BOM name or version…">
              </div>
            </div>
            <div class="w-full sm:w-auto">
              <label for="status" class="form-label">Status</label>
              <select id="status" name="status" class="form-select sm:w-44">
                <option value="">All statuses</option>
                <% ['draft', 'active', 'archived'].forEach(status => { %>
                  <option value="<%= status %>" <%= activeStatus === status ? 'selected' : '' %>><%= h.statusInfo(status).label %></option>
                <% }) %>
              </select>
            </div>
            <button type="submit" class="btn btn-secondary">Apply</button>
            <% if (search || activeStatus) { %><a href="/manufacturing/boms" class="btn btn-ghost">Reset</a><% } %>
          </form>
          <span class="shrink-0 rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <%= h.pluralize(pagination.total, 'BOM') %>
          </span>
        </div>

        <div class="table-wrap">
          <table class="table-base">
            <thead>
              <tr>
                <th class="table-th">Product</th>
                <th class="table-th">BOM</th>
                <th class="table-th text-right">Output</th>
                <th class="table-th text-right">Material lines</th>
                <th class="table-th text-right">Unit cost</th>
                <th class="table-th text-right">Sale price</th>
                <th class="table-th">Status</th>
                <th class="table-th text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(row => { %>
                <tr class="table-row">
                  <td class="table-td">
                    <a href="/manufacturing/boms/<%= row.id %>" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= row.product_name %></a>
                    <span class="mt-0.5 block font-mono text-xs text-gray-400"><%= row.product_sku %></span>
                  </td>
                  <td class="table-td">
                    <span class="text-gray-700 dark:text-gray-300"><%= row.name %></span>
                    <span class="mt-0.5 block text-xs text-gray-400"><%= row.version %></span>
                  </td>
                  <td class="table-td text-right"><%= h.formatQty(row.output_qty) %></td>
                  <td class="table-td text-right">
                    <%= h.formatNumber(row.component_count, 0) %>
                    <% if (Number(row.class_count) > 0) { %>
                      <span class="mt-0.5 block text-[10px] text-purple-600 dark:text-purple-400"><%= t('{count} class lines', { count: row.class_count }) %></span>
                    <% } %>
                  </td>
                  <td class="table-td text-right font-medium"><%= money(row.unit_cost) %></td>
                  <td class="table-td text-right"><%= money(row.sale_price) %></td>
                  <td class="table-td"><%- statusBadge(row.status) %></td>
                  <td class="table-td">
                    <div class="flex items-center justify-end gap-1">
                      <a href="/manufacturing/boms/<%= row.id %>" class="btn-icon" title="View">
                        <%- include('/partials/icon', { name: 'eye', className: 'h-4 w-4' }) %>
                      </a>
                      <a href="/manufacturing/boms/<%= row.id %>/edit" class="btn-icon" title="Edit">
                        <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %>
                      </a>
                      <a href="/manufacturing/production-orders/new?bom_id=<%= row.id %>" class="btn-icon" title="Create production order">
                        <%- include('/partials/icon', { name: 'factory', className: 'h-4 w-4' }) %>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!rows.length) { %>
                <tr>
                  <td colspan="8" class="px-6 py-16 text-center">
                    <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400 dark:bg-gray-800">
                      <%- include('/partials/icon', { name: 'list', className: 'h-6 w-6' }) %>
                    </span>
                    <p class="text-sm font-medium text-gray-700 dark:text-gray-300">No bills of materials found</p>
                    <p class="mt-1 text-sm text-gray-400">Create a BOM to start manufacturing a finished product.</p>
                    <a href="/manufacturing/boms/new" class="btn btn-primary btn-sm mt-4">New BOM</a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <%- include('/partials/pagination', { pagination, basePath: '/manufacturing/boms', query }) %>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
