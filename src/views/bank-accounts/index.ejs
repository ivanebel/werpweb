<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1500px]">

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= t('Bank accounts') %></h1>
          <p class="page-subtitle"><%= t('Store our own bank accounts and the accounts of customers and suppliers.') %></p>
        </div>
        <a href="/bank-accounts/new" class="btn btn-primary btn-sm">
          <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
          <%= t('New bank account') %>
        </a>
      </div>

      <div class="card">
        <div class="flex flex-col gap-4 border-b border-gray-100 p-5 dark:border-gray-800 md:flex-row md:items-end md:justify-between">
          <form method="GET" action="/bank-accounts" class="flex flex-1 flex-wrap items-end gap-3">
            <div class="min-w-[240px] flex-1 md:max-w-md">
              <label for="q" class="form-label"><%= t('Search') %></label>
              <div class="relative">
                <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400">
                  <%- include('/partials/icon', { name: 'search', className: 'h-4 w-4' }) %>
                </span>
                <input id="q" type="search" name="q" value="<%= search %>" class="form-input pl-10" placeholder="<%= t('Search bank accounts…') %>">
              </div>
            </div>
            <div class="w-full sm:w-auto">
              <label for="owner_type" class="form-label"><%= t('Owner type') %></label>
              <select id="owner_type" name="owner_type" class="form-select sm:w-44">
                <option value=""><%= t('All owners') %></option>
                <option value="company" <%= ownerType === 'company' ? 'selected' : '' %>><%= t('Our company') %></option>
                <option value="customer" <%= ownerType === 'customer' ? 'selected' : '' %>><%= t('Customers') %></option>
                <option value="supplier" <%= ownerType === 'supplier' ? 'selected' : '' %>><%= t('Suppliers') %></option>
              </select>
            </div>
            <button type="submit" class="btn btn-secondary"><%= t('Apply') %></button>
            <% if (search || ownerType) { %><a href="/bank-accounts" class="btn btn-ghost"><%= t('Reset') %></a><% } %>
          </form>
          <span class="shrink-0 rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <%= h.pluralize(pagination.total, 'bank account') %>
          </span>
        </div>

        <div class="table-wrap">
          <table class="table-base min-w-[1050px]">
            <thead>
              <tr>
                <th class="table-th"><%= t('Owner') %></th>
                <th class="table-th"><%= t('Bank') %></th>
                <th class="table-th"><%= t('Account number') %></th>
                <th class="table-th"><%= t('CBU') %></th>
                <th class="table-th"><%= t('Alias') %></th>
                <th class="table-th"><%= t('Notes') %></th>
                <th class="table-th text-right"><%= t('Actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(row => {
                const ownerName = row.owner_type === 'company'
                  ? (settings.company_name || t('Our company'))
                  : (row.owner_name || t('Unknown owner'));
                const ownerKind = row.owner_type === 'company'
                  ? t('Our company')
                  : (row.owner_type === 'customer' ? t('Customer') : t('Supplier'));
              %>
                <tr class="table-row">
                  <td class="table-td">
                    <p class="font-medium text-gray-900 dark:text-white/90"><%= ownerName %></p>
                    <p class="mt-0.5 text-xs text-gray-400"><%= ownerKind %></p>
                  </td>
                  <td class="table-td font-medium text-gray-700 dark:text-gray-300"><%= row.bank_name %></td>
                  <td class="table-td font-mono text-xs text-gray-600 dark:text-gray-400"><%= row.account_number || '—' %></td>
                  <td class="table-td font-mono text-xs text-gray-600 dark:text-gray-400"><%= row.cbu || '—' %></td>
                  <td class="table-td font-mono text-xs text-gray-600 dark:text-gray-400"><%= row.alias || '—' %></td>
                  <td class="table-td text-gray-500 dark:text-gray-400"><%= row.notes ? h.truncate(row.notes, 60) : '—' %></td>
                  <td class="table-td">
                    <div class="flex items-center justify-end gap-1">
                      <a href="/bank-accounts/<%= row.id %>/edit" class="btn-icon" title="<%= t('Edit') %>">
                        <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %>
                      </a>
                      <form action="/bank-accounts/<%= row.id %>/delete" method="POST" class="inline" data-confirm="<%= t('Delete this bank account? This cannot be undone.') %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-icon text-error-500 hover:bg-error-50 hover:text-error-600 dark:text-error-400 dark:hover:bg-error-500/10" title="<%= t('Delete') %>">
                          <%- include('/partials/icon', { name: 'trash', className: 'h-4 w-4' }) %>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!rows.length) { %>
                <tr>
                  <td colspan="7" class="px-6 py-16 text-center">
                    <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400 dark:bg-gray-800">
                      <%- include('/partials/icon', { name: 'banknotes', className: 'h-6 w-6' }) %>
                    </span>
                    <p class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= t('No bank accounts yet') %></p>
                    <p class="mt-1 text-sm text-gray-400"><%= t('Add a bank account to keep transfer details in one place.') %></p>
                    <a href="/bank-accounts/new" class="btn btn-primary btn-sm mt-4"><%= t('New bank account') %></a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <%- include('/partials/pagination', { pagination, basePath: '/bank-accounts', query }) %>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
</div>
