<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1800px]">
      <%
        const weekdayShort = [t('Sun'), t('Mon'), t('Tue'), t('Wed'), t('Thu'), t('Fri'), t('Sat')];
        const cellTone = (punctuality) => {
          const tone = punctuality ? h.statusInfo(punctuality).tone : '';
          return {
            success: 'border-success-200 bg-success-50/70 dark:border-success-500/30 dark:bg-success-500/10',
            error: 'border-error-200 bg-error-50/70 dark:border-error-500/30 dark:bg-error-500/10',
            warning: 'border-warning-200 bg-warning-50/70 dark:border-warning-500/30 dark:bg-warning-500/10',
            info: 'border-blue-light-200 bg-blue-light-50/70 dark:border-blue-light-500/30 dark:bg-blue-light-500/10',
            gray: 'border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-white/[0.02]',
          }[tone] || 'border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900';
        };
        const isCurrentWeek = weekStart === thisWeek;
        const filterQuery = employeeFilterId ? { employee_id: employeeFilterId } : {};
        const punchPairs = (record) => {
          const punches = Array.isArray(record.punches) && record.punches.length
            ? record.punches
            : [record.clock_in, record.clock_out].filter(Boolean);
          const pairs = [];
          for (let index = 0; index < punches.length; index += 2) {
            pairs.push([punches[index], punches[index + 1] || null]);
          }
          return pairs;
        };
      %>

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
        <div>
          <h1 class="page-title"><%= t('Attendance') %></h1>
          <p class="page-subtitle"><%= t('Weekly clock-in and clock-out register with punctuality, worked hours and absences.') %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/shifts" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'clock', className: 'h-4 w-4' }) %>
            <%= t('Shifts') %>
          </a>
          <a href="/attendance/import" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'upload', className: 'h-4 w-4' }) %>
            <%= t('Import JSON') %>
          </a>
          <a href="/attendance/new<%= employeeFilterId ? '?employee_id=' + employeeFilterId : '' %>" class="btn btn-primary btn-sm">
            <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
            <%= t('Record time') %>
          </a>
        </div>
      </div>

      <div class="card mb-5">
        <div class="flex flex-col gap-4 p-4 lg:flex-row lg:items-end lg:justify-between">
          <div class="flex flex-wrap items-center gap-2">
            <a href="<%= h.buildQuery('/attendance', { ...filterQuery, week: prevWeek }) %>" class="btn btn-secondary btn-sm" title="<%= t('Previous week') %>">
              <%- include('/partials/icon', { name: 'arrow-left', className: 'h-4 w-4' }) %>
              <span class="hidden sm:inline"><%= t('Previous week') %></span>
            </a>
            <div class="px-2 text-center">
              <p class="text-sm font-semibold text-gray-900 dark:text-white"><%= h.formatDate(weekStart) %> – <%= h.formatDate(weekEnd) %></p>
              <p class="text-xs text-gray-400">
                <% if (isCurrentWeek) { %><%= t('Current week') %><% } else { %><%= t('Week starting {date}', { date: h.formatDate(weekStart) }) %><% } %>
              </p>
            </div>
            <a href="<%= h.buildQuery('/attendance', { ...filterQuery, week: nextWeek }) %>" class="btn btn-secondary btn-sm" title="<%= t('Next week') %>">
              <span class="hidden sm:inline"><%= t('Next week') %></span>
              <%- include('/partials/icon', { name: 'arrow-right', className: 'h-4 w-4' }) %>
            </a>
            <% if (!isCurrentWeek) { %>
              <a href="<%= h.buildQuery('/attendance', filterQuery) %>" class="btn btn-ghost btn-sm"><%= t('This week') %></a>
            <% } %>
          </div>

          <form method="GET" action="/attendance" class="flex flex-wrap items-end gap-2">
            <input type="hidden" name="week" value="<%= weekStart %>">
            <div class="w-full sm:w-auto">
              <label for="employee_id" class="form-label"><%= t('Employee') %></label>
              <select id="employee_id" name="employee_id" class="form-select sm:w-72">
                <option value=""><%= t('All employees') %></option>
                <% employeeChoices.forEach(employee => { %>
                  <option value="<%= employee.id %>" <%= String(employeeFilterId || '') === String(employee.id) ? 'selected' : '' %>><%= employee.last_name %>, <%= employee.first_name %> · <%= employee.employee_no %></option>
                <% }) %>
              </select>
            </div>
            <button type="submit" class="btn btn-secondary"><%= t('Apply') %></button>
            <% if (employeeFilterId) { %><a href="<%= h.buildQuery('/attendance', { week: weekStart }) %>" class="btn btn-ghost"><%= t('Reset') %></a><% } %>
          </form>
        </div>
      </div>

      <div class="mb-5 grid grid-cols-2 gap-4 xl:grid-cols-4">
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">
            <%- include('/partials/icon', { name: 'user-group', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Employees') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatNumber(metrics.headcount, 0) %></p>
            <p class="text-xs text-gray-400"><%= employeeFilterName || t('In this week') %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-blue-light-50 text-blue-light-600 dark:bg-blue-light-500/15 dark:text-blue-light-400">
            <%- include('/partials/icon', { name: 'clock', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Worked hours') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatDuration(metrics.workedMinutes) %></p>
            <p class="text-xs text-gray-400"><%= t('Recorded this week') %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-success-50 text-success-600 dark:bg-success-500/15 dark:text-success-400">
            <%- include('/partials/icon', { name: 'check-circle', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Punctuality') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= metrics.scheduledCount ? h.formatNumber(metrics.onTimeRate, 1) + '%' : '—' %></p>
            <p class="text-xs text-gray-400"><%= t('{count} on time', { count: metrics.onTimeCount }) %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-error-50 text-error-600 dark:bg-error-500/15 dark:text-error-400">
            <%- include('/partials/icon', { name: 'exclamation-triangle', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Late arrivals') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatNumber(metrics.lateCount, 0) %></p>
            <p class="text-xs text-gray-400"><%= h.formatDuration(metrics.lateMinutes) %> <%= t('beyond grace') %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-warning-50 text-warning-600 dark:bg-warning-500/15 dark:text-warning-400">
            <%- include('/partials/icon', { name: 'arrow-left', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Early leaves') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatNumber(metrics.earlyLeaveCount, 0) %></p>
            <p class="text-xs text-gray-400"><%= h.formatDuration(metrics.earlyLeaveMinutes) %> <%= t('beyond grace') %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-purple-50 text-purple-600 dark:bg-purple-500/15 dark:text-purple-400">
            <%- include('/partials/icon', { name: 'chart', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Overtime') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatDuration(metrics.overtimeMinutes) %></p>
            <p class="text-xs text-gray-400"><%= t('Beyond the scheduled end') %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <%- include('/partials/icon', { name: 'user-circle', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Absences') %></p>
            <p class="mt-1 text-2xl font-bold <%= metrics.absentCount ? 'text-error-600 dark:text-error-400' : 'text-gray-900 dark:text-white' %>"><%= h.formatNumber(metrics.absentCount, 0) %></p>
            <p class="text-xs text-gray-400"><%= t('Scheduled days without a record') %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-blue-light-50 text-blue-light-600 dark:bg-blue-light-500/15 dark:text-blue-light-400">
            <%- include('/partials/icon', { name: 'info', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Incomplete records') %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatNumber(metrics.incompleteCount, 0) %></p>
            <p class="text-xs text-gray-400"><%= t('Missing punches or no records') %></p>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="flex flex-col gap-3 border-b border-gray-100 px-5 py-4 dark:border-gray-800 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <h2 class="card-title"><%= t('Weekly register') %></h2>
            <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= t('Click a cell to add or edit the attendance record for that day.') %></p>
          </div>
          <div class="flex flex-wrap items-center gap-3 text-[11px] font-medium text-gray-500 dark:text-gray-400">
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-success-500"></span><%= t('On time') %></span>
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-error-500"></span><%= t('Late / absent') %></span>
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-warning-500"></span><%= t('Early leave') %></span>
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-blue-light-500"></span><%= t('Incomplete') %></span>
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-gray-400"></span><%= t('Day off / unscheduled') %></span>
          </div>
        </div>

        <% if (employees.length) { %>
          <div class="table-wrap">
            <table class="table-base min-w-[1280px]">
              <thead>
                <tr>
                  <th class="table-th sticky left-0 z-10 min-w-[220px] bg-white dark:bg-gray-900"><%= t('Employee') %></th>
                  <% weekDays.forEach(date => { const dayIndex = new Date(`${date}T00:00:00Z`).getUTCDay(); const isToday = date === today; %>
                    <th class="table-th min-w-[160px] <%= isToday ? 'bg-brand-50 dark:bg-brand-500/10' : '' %>">
                      <span class="block text-xs font-semibold uppercase tracking-wide <%= isToday ? 'text-brand-600 dark:text-brand-400' : 'text-gray-500 dark:text-gray-400' %>"><%= weekdayShort[dayIndex] %></span>
                      <span class="block text-[11px] font-normal text-gray-400"><%= h.formatDate(date) %></span>
                      <% if (isToday) { %><span class="mt-0.5 inline-block rounded-full bg-brand-100 px-2 py-0.5 text-[10px] font-semibold text-brand-700 dark:bg-brand-500/20 dark:text-brand-300"><%= t('Today') %></span><% } %>
                    </th>
                  <% }) %>
                </tr>
              </thead>
              <tbody>
                <% employees.forEach(employee => { %>
                  <%
                    const firstAssignment = employee.days.find(day => day.assignment)?.assignment;
                    const distinctShifts = new Set(employee.days.filter(day => day.assignment).map(day => day.assignment.shift_id || day.assignment.shift_name));
                    const employeeWorked = employee.days.reduce((sum, day) => sum + Number((day.record && day.record.worked_minutes) || 0), 0);
                  %>
                  <tr class="table-row">
                    <td class="table-td sticky left-0 z-10 bg-white dark:bg-gray-900">
                      <a href="/employees/<%= employee.id %>" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= employee.first_name %> <%= employee.last_name %></a>
                      <span class="mt-0.5 block text-xs text-gray-400"><%= employee.employee_no %><%= employee.department ? ' · ' + employee.department : '' %></span>
                      <% if (firstAssignment) { %>
                        <span class="mt-1 block text-[11px] text-gray-400">
                          <%= distinctShifts.size > 1 ? t('Multiple shifts') : firstAssignment.shift_name %>
                          · <%= h.formatDuration(employeeWorked) %> <%= t('worked') %>
                        </span>
                      <% } %>
                    </td>
                    <% employee.days.forEach(day => { const record = day.record; %>
                      <td class="p-1 align-top <%= day.isToday ? 'bg-brand-50/40 dark:bg-brand-500/[0.06]' : '' %>">
                        <% if (record) { %>
                          <% const pairs = punchPairs(record); const shownPairs = pairs.slice(0, 3); %>
                          <div class="min-h-[92px] rounded-lg border p-2 <%= cellTone(record.punctuality) %>">
                            <div class="flex items-start justify-between gap-1">
                              <div class="min-w-0 space-y-0.5">
                                <% if (pairs.length) { %>
                                  <% shownPairs.forEach(pair => { %>
                                    <p class="font-mono text-[11px] font-semibold text-gray-800 dark:text-gray-200"><%= h.formatTime(pair[0]) %> → <%= pair[1] ? h.formatTime(pair[1]) : '—' %></p>
                                  <% }) %>
                                  <% if (pairs.length > shownPairs.length) { %>
                                    <p class="text-[10px] text-gray-400"><%= t('+{count} more', { count: pairs.length - shownPairs.length }) %></p>
                                  <% } %>
                                <% } else { %>
                                  <p class="text-[11px] font-semibold text-gray-600 dark:text-gray-300"><%= t('No records') %></p>
                                <% } %>
                                <% if (record.worked_minutes !== null) { %>
                                  <p class="mt-0.5 text-[11px] text-gray-500 dark:text-gray-400"><%= h.formatDuration(record.worked_minutes) %></p>
                                <% } %>
                              </div>
                              <a href="/attendance/<%= record.id %>/edit" class="shrink-0 rounded-md p-1 text-gray-400 hover:bg-white/60 hover:text-gray-700 dark:hover:bg-white/10 dark:hover:text-gray-200" title="<%= t('Edit attendance') %>">
                                <%- include('/partials/icon', { name: 'pencil', className: 'h-3.5 w-3.5' }) %>
                              </a>
                            </div>
                            <div class="mt-1.5 flex flex-wrap items-center gap-1">
                              <span class="inline-flex items-center gap-1 rounded-full bg-white/70 px-1.5 py-0.5 text-[10px] font-semibold text-gray-600 ring-1 ring-inset ring-black/5 dark:bg-gray-900/40 dark:text-gray-300 dark:ring-white/10">
                                <span class="h-1.5 w-1.5 rounded-full <%= h.statusDot(record.punctuality) %>"></span>
                                <%= h.statusInfo(record.punctuality).label %>
                              </span>
                              <% if (Number(record.late_minutes) > Number(record.grace_minutes)) { %>
                                <span class="rounded-full bg-error-100 px-1.5 py-0.5 text-[10px] font-semibold text-error-700 dark:bg-error-500/20 dark:text-error-300">+<%= h.formatDuration(record.late_minutes) %></span>
                              <% } %>
                              <% if (Number(record.early_leave_minutes) > Number(record.early_leave_grace_minutes)) { %>
                                <span class="rounded-full bg-warning-100 px-1.5 py-0.5 text-[10px] font-semibold text-warning-700 dark:bg-warning-500/20 dark:text-warning-300">−<%= h.formatDuration(record.early_leave_minutes) %></span>
                              <% } %>
                              <% if (Number(record.overtime_minutes) > 0) { %>
                                <span class="rounded-full bg-purple-100 px-1.5 py-0.5 text-[10px] font-semibold text-purple-700 dark:bg-purple-500/20 dark:text-purple-300"><%= t('OT') %> +<%= h.formatDuration(record.overtime_minutes) %></span>
                              <% } %>
                            </div>
                          </div>
                        <% } else if (day.onLeave) { %>
                          <div class="flex min-h-[92px] flex-col rounded-lg border border-blue-light-200 bg-blue-light-50/60 p-2 dark:border-blue-light-500/30 dark:bg-blue-light-500/10">
                            <span class="rounded-full bg-blue-light-100 px-1.5 py-0.5 text-[10px] font-semibold text-blue-light-700 dark:bg-blue-light-500/20 dark:text-blue-light-300"><%= t('On leave') %></span>
                            <% if (day.assignment) { %><span class="mt-auto block text-[10px] text-gray-400"><%= h.formatTime(day.assignment.start_time) %> – <%= h.formatTime(day.assignment.end_time) %></span><% } %>
                          </div>
                        <% } else if (day.absent) { %>
                          <a href="/attendance/new?employee_id=<%= employee.id %>&date=<%= day.date %>" class="flex min-h-[92px] flex-col rounded-lg border border-error-200 bg-error-50/60 p-2 hover:bg-error-50 dark:border-error-500/30 dark:bg-error-500/10">
                            <span class="rounded-full bg-error-100 px-1.5 py-0.5 text-[10px] font-semibold text-error-700 dark:bg-error-500/20 dark:text-error-300"><%= t('Absent') %></span>
                            <span class="mt-1 block text-[11px] text-error-600/80 dark:text-error-400/80"><%= t('Add record') %></span>
                            <% if (day.assignment) { %><span class="mt-auto block text-[10px] text-gray-400"><%= h.formatTime(day.assignment.start_time) %> – <%= h.formatTime(day.assignment.end_time) %></span><% } %>
                          </a>
                        <% } else if (day.off) { %>
                          <div class="flex min-h-[92px] flex-col rounded-lg border border-gray-200 bg-gray-50 p-2 dark:border-gray-700 dark:bg-white/[0.02]">
                            <span class="rounded-full bg-gray-200 px-1.5 py-0.5 text-[10px] font-semibold text-gray-600 dark:bg-gray-700 dark:text-gray-300"><%= t('Day off') %></span>
                          </div>
                        <% } else if (day.scheduled) { %>
                          <a href="/attendance/new?employee_id=<%= employee.id %>&date=<%= day.date %>" class="flex min-h-[92px] flex-col rounded-lg border border-dashed border-gray-300 p-2 hover:border-brand-400 hover:bg-brand-50/50 dark:border-gray-700 dark:hover:border-brand-500/50 dark:hover:bg-brand-500/5">
                            <span class="text-[11px] font-medium text-gray-500 dark:text-gray-400"><%= t('Scheduled') %></span>
                            <span class="mt-0.5 block text-[10px] text-gray-400"><%= h.formatTime(day.assignment.start_time) %> – <%= h.formatTime(day.assignment.end_time) %></span>
                            <span class="mt-auto block text-[10px] font-medium text-brand-600 dark:text-brand-400"><%= t('Add record') %></span>
                          </a>
                        <% } else { %>
                          <div class="flex min-h-[92px] items-center justify-center rounded-lg border border-dashed border-gray-200 text-[11px] text-gray-300 dark:border-gray-800 dark:text-gray-600">
                            <%= t('—') %>
                          </div>
                        <% } %>
                      </td>
                    <% }) %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="px-6 py-16 text-center">
            <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400 dark:bg-gray-800">
              <%- include('/partials/icon', { name: 'calendar', className: 'h-6 w-6' }) %>
            </span>
            <p class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= t('No employees to show') %></p>
            <p class="mt-1 text-sm text-gray-400"><%= employeeFilterId ? t('The selected employee is inactive or no longer exists.') : t('Add active employees to start recording attendance.') %></p>
            <div class="mt-4 flex flex-wrap justify-center gap-2">
              <% if (employeeFilterId) { %><a href="/attendance" class="btn btn-secondary btn-sm"><%= t('All employees') %></a><% } %>
              <a href="/employees/new" class="btn btn-primary btn-sm"><%= t('New employee') %></a>
            </div>
          </div>
        <% } %>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-2 text-xs text-gray-400">
        <p>
          <% if (weekStart > today) { %>
            <%= t('Future days are shown for planning; absences are only counted for scheduled days before today.') %>
          <% } else { %>
            <%= t('Absences are counted for scheduled work days before today. Days without a shift assignment show as unscheduled.') %>
          <% } %>
        </p>
        <p><%= t('Times are stored in UTC.') %></p>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
</div>
