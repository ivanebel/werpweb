<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1600px]">

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= resource.title %></h1>
          <p class="page-subtitle"><%= resource.indexSubtitle %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <% if (resource.key === 'products') { %>
            <a href="/brands" class="btn btn-secondary btn-sm">
              <%- include('/partials/icon', { name: 'tag', className: 'h-4 w-4' }) %>
              Brands
            </a>
            <a href="/product-categories" class="btn btn-secondary btn-sm">
              <%- include('/partials/icon', { name: 'tag', className: 'h-4 w-4' }) %>
              Categories
            </a>
          <% } %>
          <% if (resource.key === 'employees') { %>
            <a href="/shifts" class="btn btn-secondary btn-sm">
              <%- include('/partials/icon', { name: 'clock', className: 'h-4 w-4' }) %>
              <%= t('Shifts') %>
            </a>
            <a href="/attendance" class="btn btn-secondary btn-sm">
              <%- include('/partials/icon', { name: 'calendar', className: 'h-4 w-4' }) %>
              <%= t('Attendance') %>
            </a>
          <% } %>
          <a href="<%= resource.basePath %>/new" class="btn btn-primary btn-sm">
            <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
            <%= resource.newLabel %>
          </a>
        </div>
      </div>

      <% if (resource.key === 'checks' && counts && counts.total_count !== undefined) { %>
        <div class="mb-5 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
          <div class="card flex items-center gap-4 p-5">
            <span class="kpi-icon bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">
              <%- include('/partials/icon', { name: 'banknotes', className: 'h-6 w-6' }) %>
            </span>
            <div>
              <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Open check value') %></p>
              <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= money(counts.open_amount) %></p>
              <p class="text-xs text-gray-400"><%= t('Available, deposited and endorsed') %></p>
            </div>
          </div>
          <div class="card flex items-center gap-4 p-5">
            <span class="kpi-icon bg-blue-light-50 text-blue-light-600 dark:bg-blue-light-500/15 dark:text-blue-light-400">
              <%- include('/partials/icon', { name: 'check-circle', className: 'h-6 w-6' }) %>
            </span>
            <div>
              <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Available') %></p>
              <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= money(counts.available_amount) %></p>
              <p class="text-xs text-gray-400"><%= h.pluralize(counts.available_count, 'check') %></p>
            </div>
          </div>
          <div class="card flex items-center gap-4 p-5">
            <span class="kpi-icon bg-warning-50 text-warning-600 dark:bg-warning-500/15 dark:text-warning-400">
              <%- include('/partials/icon', { name: 'building', className: 'h-6 w-6' }) %>
            </span>
            <div>
              <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Deposited') %></p>
              <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= money(counts.deposited_amount) %></p>
              <p class="text-xs text-gray-400"><%= h.pluralize(counts.deposited_count, 'check') %></p>
            </div>
          </div>
          <div class="card flex items-center gap-4 p-5">
            <span class="kpi-icon bg-purple-50 text-purple-600 dark:bg-purple-500/15 dark:text-purple-400">
              <%- include('/partials/icon', { name: 'truck', className: 'h-6 w-6' }) %>
            </span>
            <div>
              <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Endorsed') %></p>
              <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= money(counts.endorsed_amount) %></p>
              <p class="text-xs text-gray-400"><%= h.pluralize(counts.endorsed_count, 'check') %></p>
            </div>
          </div>
        </div>
      <% } %>

      <div class="card">
        <div class="flex flex-col gap-4 border-b border-gray-100 p-5 dark:border-gray-800 md:flex-row md:items-end md:justify-between">
          <form method="GET" action="<%= resource.basePath %>" class="flex flex-1 flex-wrap items-end gap-3">
            <div class="min-w-[220px] flex-1 md:max-w-sm">
              <label for="q" class="form-label">Search</label>
              <div class="relative">
                <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400">
                  <%- include('/partials/icon', { name: 'search', className: 'h-4 w-4' }) %>
                </span>
                <input id="q" type="search" name="q" value="<%= search %>" class="form-input pl-10" placeholder="<%= t('Search {items}…', { items: resource.titleLower }) %>">
              </div>
            </div>
            <% filters.forEach(filter => { %>
              <div class="w-full sm:w-auto">
                <label for="filter-<%= filter.name %>" class="form-label"><%= filter.label %></label>
                <select id="filter-<%= filter.name %>" name="<%= filter.name %>" class="form-select sm:w-44">
                  <option value=""><%= filter.allLabel %></option>
                  <% filter.options.forEach(opt => { %>
                    <option value="<%= opt.value %>" <%= String(query[filter.name] || '') === String(opt.value) ? 'selected' : '' %>><%= opt.label %></option>
                  <% }) %>
                </select>
              </div>
            <% }) %>
            <button type="submit" class="btn btn-secondary">Apply</button>
            <% if (search || filters.some(f => query[f.name])) { %>
              <a href="<%= resource.basePath %>" class="btn btn-ghost">Reset</a>
            <% } %>
          </form>
          <span class="shrink-0 rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <%= h.pluralize(rowCount, resource.singular.toLowerCase(), resource.title) %>
          </span>
        </div>

        <div class="table-wrap">
          <table class="table-base">
            <thead>
              <tr>
                <% resource.columns.forEach(col => { %>
                  <th class="table-th <%= col.align === 'right' ? 'text-right' : '' %>"><%= col.label %></th>
                <% }) %>
                <th class="table-th text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(row => { %>
                <tr class="table-row">
                  <% resource.columns.forEach(col => { const value = row[col.key]; %>
                    <td class="table-td <%= col.align === 'right' ? 'text-right' : '' %>">
                      <% if (col.type === 'primary') { %>
                        <a href="<%= resource.basePath %>/<%= row.id %>" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= value %></a>
                        <% if (col.sub && row[col.sub]) { %>
                          <span class="mt-0.5 block font-mono text-xs text-gray-400"><%= row[col.sub] %></span>
                        <% } %>
                      <% } else if (col.type === 'money') { %>
                        <span class="font-medium text-gray-800 dark:text-gray-200"><%= money(value) %></span>
                      <% } else if (col.type === 'number') { %>
                        <%= h.formatNumber(value, col.decimals !== undefined ? col.decimals : 0) %>
                      <% } else if (col.type === 'date') { %>
                        <span class="text-gray-500 dark:text-gray-400"><%= h.formatDate(value) %></span>
                      <% } else if (col.type === 'datetime') { %>
                        <span class="text-gray-500 dark:text-gray-400"><%= h.formatDateTime(value) %></span>
                      <% } else if (col.type === 'status') { %>
                        <%- statusBadge(value) %>
                      <% } else if (col.type === 'stock') { %>
                        <% const low = Number(row[col.trackKey || 'track_stock']) === 1 && Number(value) <= Number(row[col.reorderKey || 'reorder_level']); %>
                        <div class="flex flex-col items-end gap-1">
                          <span class="font-medium <%= low ? 'text-warning-600 dark:text-warning-400' : 'text-gray-800 dark:text-gray-200' %>">
                            <%= h.formatQty(value) %> <span class="text-xs font-normal text-gray-400"><%= row[col.unitKey || 'unit'] || '' %></span>
                          </span>
                          <% if (low) { %><span class="rounded-full bg-warning-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-warning-700 dark:bg-warning-500/15 dark:text-warning-400">Low</span><% } %>
                        </div>
                      <% } else if (col.type === 'signed') { %>
                        <% const n = Number(value); %>
                        <span class="font-semibold <%= n >= 0 ? 'text-success-600 dark:text-success-400' : 'text-error-600 dark:text-error-400' %>"><%= n > 0 ? '+' : '' %><%= h.formatQty(n) %></span>
                      <% } else if (col.type === 'margin') { %>
                        <%
                          const sale = Number(row[col.saleKey || 'sale_price'] || 0);
                          const cost = Number(row[col.costKey || 'cost_price'] || 0);
                          const pct = sale > 0 ? ((sale - cost) / sale) * 100 : null;
                          const tone = pct === null
                            ? 'text-gray-400'
                            : pct < 20
                              ? 'text-error-600 dark:text-error-400'
                              : pct <= 35
                                ? 'text-warning-600 dark:text-warning-400'
                                : 'text-success-600 dark:text-success-400';
                        %>
                        <span class="font-semibold <%= tone %>"><%= pct === null ? '—' : `${h.formatNumber(pct, 1)}%` %></span>
                      <% } else { %>
                        <span class="text-gray-600 dark:text-gray-300"><%= value || '—' %></span>
                      <% } %>
                    </td>
                  <% }) %>
                  <td class="table-td">
                    <div class="flex items-center justify-end gap-1">
                      <a href="<%= resource.basePath %>/<%= row.id %>" class="btn-icon" title="View">
                        <%- include('/partials/icon', { name: 'eye', className: 'h-4 w-4' }) %>
                      </a>
                      <a href="<%= resource.basePath %>/<%= row.id %>/edit" class="btn-icon" title="Edit">
                        <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %>
                      </a>
                      <form action="<%= resource.basePath %>/<%= row.id %>/delete" method="POST" class="inline" data-confirm="<%= t('Delete {item}? This cannot be undone.', { item: resource.singularLower }) %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-icon text-error-500 hover:bg-error-50 hover:text-error-600 dark:text-error-400 dark:hover:bg-error-500/10" title="Delete">
                          <%- include('/partials/icon', { name: 'trash', className: 'h-4 w-4' }) %>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!rows.length) { %>
                <tr>
                  <td colspan="<%= resource.columns.length + 1 %>" class="px-6 py-16 text-center">
                    <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400 dark:bg-gray-800">
                      <%- include('/partials/icon', { name: 'search', className: 'h-6 w-6' }) %>
                    </span>
                    <p class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= t('No {items} found', { items: resource.titleLower }) %></p>
                    <p class="mt-1 text-sm text-gray-400"><%= t('Try adjusting your search or add a new {item}.', { item: resource.singularLower }) %></p>
                    <a href="<%= resource.basePath %>/new" class="btn btn-primary btn-sm mt-4"><%= t('Add {item}', { item: resource.singularLower }) %></a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <%- include('/partials/pagination', { pagination, basePath: resource.basePath, query }) %>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
