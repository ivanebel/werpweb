<%- include('/layouts/head', { includeApex: true }) %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1600px]">

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= t(new Date().getHours() < 12 ? 'Good morning' : new Date().getHours() < 18 ? 'Good afternoon' : 'Good evening') %>, <%= greetingName %></h1>
          <p class="page-subtitle"><%= t('Here is what is happening across {company} today.', { company: settings.company_name }) %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/deliveries/new" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'truck', className: 'h-4 w-4' }) %>
            New delivery
          </a>
          <a href="/sales-orders/new" class="btn btn-primary btn-sm">
            <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
            New sales order
          </a>
        </div>
      </div>

      <!-- KPI cards -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="card p-5 md:p-6">
          <div class="flex items-start justify-between">
            <span class="kpi-icon bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">
              <%- include('/partials/icon', { name: 'chart', className: 'h-6 w-6' }) %>
            </span>
            <span class="inline-flex items-center gap-1 rounded-full px-2 py-1 text-xs font-medium <%= stats.revenueDelta >= 0 ? 'bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-400' : 'bg-error-50 text-error-700 dark:bg-error-500/15 dark:text-error-400' %>">
              <%- include('/partials/icon', { name: stats.revenueDelta >= 0 ? 'arrow-up' : 'arrow-down', className: 'h-3 w-3' }) %>
              <%= Math.abs(stats.revenueDelta).toFixed(1) %>%
            </span>
          </div>
          <p class="mt-5 stat-label">Revenue this month</p>
          <p class="mt-1 stat-value"><%= money(stats.revenue) %></p>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400"><%= t('{count} invoices · vs last month', { count: stats.revenueCount }) %></p>
        </div>

        <div class="card p-5 md:p-6">
          <div class="flex items-start justify-between">
            <span class="kpi-icon bg-blue-light-50 text-blue-light-600 dark:bg-blue-light-500/15 dark:text-blue-light-400">
              <%- include('/partials/icon', { name: 'clipboard-list', className: 'h-6 w-6' }) %>
            </span>
            <a href="/sales-orders" class="text-xs font-medium text-gray-400 hover:text-brand-500">View all</a>
          </div>
          <p class="mt-5 stat-label">Open sales orders</p>
          <p class="mt-1 stat-value"><%= h.formatNumber(stats.openOrders, 0) %></p>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400"><%= t('{amount} in the pipeline', { amount: money(stats.openOrderValue) }) %></p>
        </div>

        <div class="card p-5 md:p-6">
          <div class="flex items-start justify-between">
            <span class="kpi-icon bg-purple-50 text-purple-600 dark:bg-purple-500/15 dark:text-purple-400">
              <%- include('/partials/icon', { name: 'factory', className: 'h-6 w-6' }) %>
            </span>
            <a href="/manufacturing/production-orders" class="text-xs font-medium text-gray-400 hover:text-brand-500">View all</a>
          </div>
          <p class="mt-5 stat-label">Active production</p>
          <p class="mt-1 stat-value"><%= h.formatNumber(stats.activeProduction, 0) %></p>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400"><%= t('{count} deliveries waiting to ship', { count: stats.pendingDeliveries }) %></p>
        </div>

        <div class="card p-5 md:p-6">
          <div class="flex items-start justify-between">
            <span class="kpi-icon bg-warning-50 text-warning-600 dark:bg-warning-500/15 dark:text-warning-400">
              <%- include('/partials/icon', { name: 'exclamation-triangle', className: 'h-6 w-6' }) %>
            </span>
            <a href="/products" class="text-xs font-medium text-gray-400 hover:text-brand-500">Review</a>
          </div>
          <p class="mt-5 stat-label">Low stock items</p>
          <p class="mt-1 stat-value"><%= h.formatNumber(stats.lowStock, 0) %></p>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400"><%= t('{amount} stock on hand', { amount: money(stats.stockValue) }) %></p>
        </div>
      </div>

      <!-- Charts -->
      <div class="mt-5 grid grid-cols-1 gap-5 xl:grid-cols-12">
        <div class="card xl:col-span-8">
          <div class="card-header">
            <div>
              <h2 class="card-title">Revenue vs purchases</h2>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">Invoiced sales and supplier bills, last 6 months</p>
            </div>
            <span class="rounded-lg bg-gray-50 px-3 py-1.5 text-xs font-medium text-gray-500 dark:bg-white/[0.04] dark:text-gray-400">6 months</span>
          </div>
          <div class="px-2 pb-2 pt-4">
            <div id="revenue-chart" class="min-h-[320px]"></div>
          </div>
          <div class="grid grid-cols-3 border-t border-gray-100 dark:border-gray-800">
            <div class="px-5 py-4">
              <p class="text-xs text-gray-500 dark:text-gray-400">Sales (6 mo.)</p>
              <p class="mt-1 text-lg font-semibold text-gray-800 dark:text-white"><%= money(charts.revenue.reduce((a, b) => a + b, 0)) %></p>
            </div>
            <div class="border-l border-gray-100 px-5 py-4 dark:border-gray-800">
              <p class="text-xs text-gray-500 dark:text-gray-400">Purchases (6 mo.)</p>
              <p class="mt-1 text-lg font-semibold text-gray-800 dark:text-white"><%= money(charts.purchases.reduce((a, b) => a + b, 0)) %></p>
            </div>
            <div class="border-l border-gray-100 px-5 py-4 dark:border-gray-800">
              <p class="text-xs text-gray-500 dark:text-gray-400">Gross contribution</p>
              <p class="mt-1 text-lg font-semibold <%= stats.grossProfit >= 0 ? 'text-success-600 dark:text-success-400' : 'text-error-600 dark:text-error-400' %>"><%= money(stats.grossProfit) %></p>
            </div>
          </div>
        </div>

        <div class="card xl:col-span-4">
          <div class="card-header">
            <div>
              <h2 class="card-title">Sales by category</h2>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">Last 90 days</p>
            </div>
          </div>
          <div class="flex flex-col items-center px-4 py-4">
            <div id="category-chart" class="w-full"></div>
            <ul class="mt-2 w-full space-y-2">
              <% charts.categories.labels.forEach((label, i) => { %>
                <li class="flex items-center justify-between text-sm">
                  <span class="flex items-center gap-2 text-gray-600 dark:text-gray-300">
                    <span class="h-2.5 w-2.5 rounded-full" data-chart-dot="<%= i %>"></span><%= label %>
                  </span>
                  <span class="font-medium text-gray-800 dark:text-gray-200"><%= money(charts.categories.values[i]) %></span>
                </li>
              <% }) %>
              <% if (!charts.categories.labels.length) { %>
                <li class="py-6 text-center text-sm text-gray-400">No invoiced sales yet.</li>
              <% } %>
            </ul>
          </div>
        </div>
      </div>

      <!-- Recent orders + low stock -->
      <div class="mt-5 grid grid-cols-1 gap-5 xl:grid-cols-12">
        <div class="card xl:col-span-8">
          <div class="card-header">
            <div>
              <h2 class="card-title">Recent sales orders</h2>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">Latest activity from your customers</p>
            </div>
            <a href="/sales-orders" class="btn btn-secondary btn-sm">View all</a>
          </div>
          <div class="table-wrap">
            <table class="table-base min-w-[600px]">
              <thead>
                <tr>
                  <th class="table-th">Order</th>
                  <th class="table-th">Customer</th>
                  <th class="table-th">Date</th>
                  <th class="table-th">Status</th>
                  <th class="table-th text-right">Total</th>
                </tr>
              </thead>
              <tbody>
                <% recentOrders.forEach(o => { %>
                  <tr class="table-row">
                    <td class="table-td font-medium"><a href="/sales-orders/<%= o.id %>" class="link"><%= o.order_no %></a></td>
                    <td class="table-td"><%= o.company_name %></td>
                    <td class="table-td text-gray-500 dark:text-gray-400"><%= h.formatDate(o.order_date) %></td>
                    <td class="table-td"><%- statusBadge(o.status) %></td>
                    <td class="table-td text-right font-medium"><%= money(o.total) %></td>
                  </tr>
                <% }) %>
                <% if (!recentOrders.length) { %>
                  <tr><td colspan="5" class="px-5 py-10 text-center text-sm text-gray-400">No sales orders yet.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card xl:col-span-4">
          <div class="card-header">
            <div>
              <h2 class="card-title">Stock alerts</h2>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">At or below reorder level</p>
            </div>
            <a href="/products" class="btn btn-secondary btn-sm">Products</a>
          </div>
          <div class="divide-y divide-gray-100 dark:divide-gray-800">
            <% lowStock.forEach(p => { %>
              <a href="/products/<%= p.id %>" class="flex items-center justify-between gap-4 px-5 py-4 transition hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-gray-800 dark:text-gray-200"><%= p.name %></p>
                  <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400"><%= p.sku %> · <%= t('reorder at {qty}', { qty: h.formatQty(p.reorder_level) }) %></p>
                </div>
                <span class="shrink-0 rounded-full bg-warning-50 px-2.5 py-1 text-xs font-semibold text-warning-700 dark:bg-warning-500/15 dark:text-warning-400">
                  <%= h.formatQty(p.stock_qty) %> <%= p.unit %>
                </span>
              </a>
            <% }) %>
            <% if (!lowStock.length) { %>
              <div class="px-5 py-10 text-center">
                <span class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-full bg-success-50 text-success-600 dark:bg-success-500/15 dark:text-success-400">
                  <%- include('/partials/icon', { name: 'check', className: 'h-5 w-5' }) %>
                </span>
                <p class="text-sm text-gray-500 dark:text-gray-400">Everything is above its reorder level.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Top products + production + activity -->
      <div class="mt-5 grid grid-cols-1 gap-5 xl:grid-cols-12">
        <div class="card xl:col-span-5">
          <div class="card-header">
            <div>
              <h2 class="card-title">Top products</h2>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">By invoiced revenue, last 90 days</p>
            </div>
          </div>
          <div class="space-y-4 p-5">
            <% charts.topProducts.forEach((p, i) => { const max = Math.max(...charts.topProducts.map(x => x.revenue), 1); %>
              <div>
                <div class="flex items-center justify-between gap-3">
                  <div class="flex min-w-0 items-center gap-3">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-xs font-semibold text-gray-500 dark:bg-gray-800 dark:text-gray-400"><%= i + 1 %></span>
                    <div class="min-w-0">
                      <p class="truncate text-sm font-medium text-gray-800 dark:text-gray-200"><%= p.name %></p>
                      <p class="text-xs text-gray-400"><%= p.sku %> · <%= t('{qty} sold', { qty: h.formatQty(p.qty) }) %></p>
                    </div>
                  </div>
                  <span class="text-sm font-semibold text-gray-800 dark:text-gray-200"><%= money(p.revenue) %></span>
                </div>
                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800">
                  <div class="h-full rounded-full bg-brand-500" style="width: <%= Math.max(4, (p.revenue / max) * 100) %>%"></div>
                </div>
              </div>
            <% }) %>
            <% if (!charts.topProducts.length) { %>
              <p class="py-8 text-center text-sm text-gray-400">No product sales in this period.</p>
            <% } %>
          </div>
        </div>

        <div class="card xl:col-span-3">
          <div class="card-header">
            <div>
              <h2 class="card-title">Production</h2>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">Orders by status</p>
            </div>
          </div>
          <div class="p-5">
            <div id="production-chart" class="min-h-[200px]"></div>
            <a href="/manufacturing/production-orders" class="btn btn-secondary btn-sm mt-2 w-full">Open production</a>
          </div>
        </div>

        <div class="card xl:col-span-4">
          <div class="card-header">
            <div>
              <h2 class="card-title">Recent stock activity</h2>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">Latest movements</p>
            </div>
          </div>
          <div class="divide-y divide-gray-100 dark:divide-gray-800">
            <% activity.forEach(a => { const incoming = Number(a.quantity) >= 0; %>
              <div class="flex items-center justify-between gap-3 px-5 py-3.5">
                <div class="flex min-w-0 items-center gap-3">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg <%= incoming ? 'bg-success-50 text-success-600 dark:bg-success-500/15 dark:text-success-400' : 'bg-error-50 text-error-600 dark:bg-error-500/15 dark:text-error-400' %>">
                    <%- include('/partials/icon', { name: incoming ? 'arrow-down' : 'arrow-up', className: 'h-4 w-4' }) %>
                  </span>
                  <div class="min-w-0">
                    <p class="truncate text-sm font-medium text-gray-800 dark:text-gray-200"><%= a.name %></p>
                    <p class="truncate text-xs text-gray-400"><%= a.notes ? h.localizeStockNote(a.notes) : h.t(h.humanize(a.movement_type)) %></p>
                  </div>
                </div>
                <div class="shrink-0 text-right">
                  <p class="text-sm font-semibold <%= incoming ? 'text-success-600 dark:text-success-400' : 'text-error-600 dark:text-error-400' %>">
                    <%= incoming ? '+' : '' %><%= h.formatQty(a.quantity) %>
                  </p>
                  <p class="text-[11px] text-gray-400"><%= h.relativeDate(a.created_at) %></p>
                </div>
              </div>
            <% }) %>
            <% if (!activity.length) { %>
              <p class="px-5 py-10 text-center text-sm text-gray-400">No stock movements yet.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>

<script>
(function () {
  const currency = <%- JSON.stringify(currency) %>;
  const locale = document.body.dataset.locale || document.documentElement.lang || 'en-US';
  const messages = <%- JSON.stringify(jsMessages || {}) %>;
  const charts = <%- JSON.stringify(charts) %>;
  const isDark = () => document.documentElement.classList.contains('dark');
  const palette = ['#465FFF', '#12B76A', '#F79009', '#0BA5EC', '#7A5AF8', '#F04438'];

  function money(v) {
    try { return new Intl.NumberFormat(locale, { style: 'currency', currency, maximumFractionDigits: 0 }).format(Number(v || 0)); }
    catch (e) { return currency + ' ' + Number(v || 0).toFixed(0); }
  }
  function themeAxis() {
    return {
      foreColor: isDark() ? '#98A2B3' : '#667085',
      grid: isDark() ? '#1F2937' : '#F2F4F7',
      tooltipTheme: isDark() ? 'dark' : 'light',
    };
  }

  const categoryDots = document.querySelectorAll('[data-chart-dot]');
  categoryDots.forEach((dot, i) => { dot.style.backgroundColor = palette[i % palette.length]; });

  const revenueEl = document.querySelector('#revenue-chart');
  if (revenueEl) {
    const t = themeAxis();
    const revenue = new ApexCharts(revenueEl, {
      chart: { type: 'area', height: 330, toolbar: { show: false }, fontFamily: 'Outfit, sans-serif', foreColor: t.foreColor },
      series: [
        { name: messages.revenue || 'Revenue', data: charts.revenue },
        { name: messages.purchases || 'Purchases', data: charts.purchases }
      ],
      colors: ['#465FFF', '#9CB9FF'],
      stroke: { curve: 'smooth', width: 3 },
      fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.28, opacityTo: 0.02, stops: [0, 95] } },
      dataLabels: { enabled: false },
      grid: { borderColor: t.grid, strokeDashArray: 4, padding: { left: 8, right: 8 } },
      xaxis: { categories: charts.months, axisBorder: { show: false }, axisTicks: { show: false } },
      yaxis: { labels: { formatter: money } },
      tooltip: { theme: t.tooltipTheme, y: { formatter: money } },
      legend: { position: 'top', horizontalAlign: 'right', markers: { radius: 4 }, itemMargin: { horizontal: 10 } },
      markers: { size: 0, hover: { size: 5 } }
    });
    revenue.render();
    document.addEventListener('werp:theme', () => {
      const nt = themeAxis();
      revenue.updateOptions({ chart: { foreColor: nt.foreColor }, grid: { borderColor: nt.grid }, tooltip: { theme: nt.tooltipTheme } });
    });
  }

  const categoryEl = document.querySelector('#category-chart');
  if (categoryEl) {
    const hasData = charts.categories.values.some(v => v > 0);
    const category = new ApexCharts(categoryEl, {
      chart: { type: 'donut', height: 240, fontFamily: 'Outfit, sans-serif', foreColor: themeAxis().foreColor },
      series: hasData ? charts.categories.values : [1],
      labels: hasData ? charts.categories.labels : [messages.noData || 'No data'],
      colors: hasData ? palette : ['#E4E7EC'],
      stroke: { width: 0 },
      legend: { show: false },
      dataLabels: { enabled: false },
      plotOptions: { pie: { donut: { size: '72%', labels: {
        show: true,
        name: { show: false },
        value: { show: true, fontSize: '20px', fontWeight: 600, color: isDark() ? '#F9FAFB' : '#1D2939', formatter: (v) => money(v) },
        total: { show: true, showAlways: true, label: messages.sales90 || '90-day sales', fontSize: '12px', color: '#98A2B3', formatter: () => money(charts.categories.values.reduce((a, b) => a + b, 0)) }
      } } } },
      tooltip: { theme: themeAxis().tooltipTheme, y: { formatter: money } }
    });
    category.render();
    document.addEventListener('werp:theme', () => {
      const nt = themeAxis();
      category.updateOptions({ chart: { foreColor: nt.foreColor }, tooltip: { theme: nt.tooltipTheme } });
    });
  }

  const productionEl = document.querySelector('#production-chart');
  if (productionEl) {
    const production = new ApexCharts(productionEl, {
      chart: { type: 'bar', height: 200, toolbar: { show: false }, fontFamily: 'Outfit, sans-serif', foreColor: themeAxis().foreColor },
      series: [{ name: messages.orders || 'Orders', data: charts.production.values }],
      colors: ['#465FFF'],
      plotOptions: { bar: { horizontal: true, borderRadius: 6, barHeight: '55%' } },
      dataLabels: { enabled: true, style: { fontSize: '11px', fontWeight: 600 }, offsetX: 4 },
      grid: { show: false, padding: { left: 0, right: 12 } },
      xaxis: { categories: charts.production.labels, axisBorder: { show: false }, axisTicks: { show: false }, labels: { show: false } },
      yaxis: { labels: { style: { fontSize: '12px' } } },
      tooltip: { theme: themeAxis().tooltipTheme },
      legend: { show: false }
    });
    production.render();
    document.addEventListener('werp:theme', () => {
      const nt = themeAxis();
      production.updateOptions({ chart: { foreColor: nt.foreColor }, tooltip: { theme: nt.tooltipTheme } });
    });
  }
})();
</script>
