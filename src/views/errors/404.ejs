<%- include('/layouts/head') %>
<main class="flex min-h-screen items-center justify-center bg-gray-50 px-4 dark:bg-gray-950">
  <div class="w-full max-w-lg text-center">
    <a href="/dashboard" class="mb-8 inline-flex items-center gap-3">
      <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-lg font-bold text-white shadow-theme-md">W</span>
      <span class="text-left">
        <span class="block text-lg font-bold leading-tight text-gray-900 dark:text-white">WerpWeb</span>
        <span class="block text-[10px] font-semibold uppercase tracking-[0.18em] text-gray-400">ERP Suite</span>
      </span>
    </a>

    <div class="card overflow-hidden p-8 md:p-10">
      <p class="text-[80px] font-bold leading-none text-brand-500/20 dark:text-brand-500/30">404</p>
      <h1 class="mt-2 text-2xl font-semibold text-gray-900 dark:text-white">Page not found</h1>
      <p class="mx-auto mt-2 max-w-sm text-sm text-gray-500 dark:text-gray-400">
        The page you are looking for does not exist, was moved, or you may not have access to it.
      </p>
      <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/dashboard" class="btn btn-primary">
          <%- include('/partials/icon', { name: 'dashboard', className: 'h-4 w-4' }) %>
          Go to dashboard
        </a>
        <a href="/search" class="btn btn-secondary">
          <%- include('/partials/icon', { name: 'search', className: 'h-4 w-4' }) %>
          Search
        </a>
      </div>
    </div>

    <p class="mt-6 text-xs text-gray-400">&copy; <%= new Date().getFullYear() %> <%= settings.company_name %> · WerpWeb ERP</p>
  </div>
</main>
</body>
</html>
