<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<%
  const employee = report.employee;
  const employmentLabels = {
    full_time: t('Full time'),
    part_time: t('Part time'),
    contract: t('Contract'),
    intern: t('Intern'),
  };
  const statusLabels = {
    active: t('Active'),
    on_leave: t('On leave'),
    inactive: t('Inactive'),
  };
  const workedPct = report.expectedMinutes > 0
    ? Math.round((report.workedMinutes / report.expectedMinutes) * 100)
    : 0;
  const barPct = Math.min(100, Math.max(0, workedPct));
%>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1400px]">

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= t('Attendance report') %></h1>
          <p class="page-subtitle"><%= employee.full_name %> · <%= employee.employee_no %> · <%= h.formatDate(report.from) %> – <%= h.formatDate(report.to) %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/employees/<%= employee.id %>" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'arrow-left', className: 'h-4 w-4' }) %> <%= t('Back to employee') %>
          </a>
          <a href="<%= printUrl %>" target="_blank" rel="noopener" class="btn btn-primary btn-sm">
            <%- include('/partials/icon', { name: 'printer', className: 'h-4 w-4' }) %> <%= t('Print / Save PDF') %>
          </a>
        </div>
      </div>

      <div class="card mb-5 p-5">
        <form method="GET" action="/employees/<%= employee.id %>/report" class="flex flex-wrap items-end gap-3">
          <div>
            <label for="report-from" class="form-label"><%= t('From') %></label>
            <input id="report-from" type="date" name="from" value="<%= from %>" class="form-input">
          </div>
          <div>
            <label for="report-to" class="form-label"><%= t('To') %></label>
            <input id="report-to" type="date" name="to" value="<%= to %>" class="form-input">
          </div>
          <button type="submit" class="btn btn-primary"><%= t('Apply') %></button>
          <a href="/employees/<%= employee.id %>/report" class="btn btn-secondary"><%= t('Reset') %></a>
        </form>
      </div>

      <div class="card mb-5">
        <div class="card-header">
          <h2 class="card-title"><%= t('Employee information') %></h2>
          <span class="text-sm text-gray-400"><%= t('Report period') %>: <%= h.formatDate(report.from) %> – <%= h.formatDate(report.to) %></span>
        </div>
        <dl class="grid grid-cols-1 gap-x-8 gap-y-5 p-5 sm:grid-cols-2 md:grid-cols-4 md:p-6">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Employee no.') %></dt>
            <dd class="mt-1 font-mono text-sm text-gray-800 dark:text-gray-200"><%= employee.employee_no %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Clock ID') %></dt>
            <dd class="mt-1 text-sm text-gray-800 dark:text-gray-200"><%= employee.clock_id || '—' %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Job title') %></dt>
            <dd class="mt-1 text-sm text-gray-800 dark:text-gray-200"><%= employee.job_title || '—' %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Department') %></dt>
            <dd class="mt-1 text-sm text-gray-800 dark:text-gray-200"><%= employee.department || '—' %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Employment type') %></dt>
            <dd class="mt-1 text-sm text-gray-800 dark:text-gray-200"><%= employmentLabels[employee.employment_type] || h.humanize(employee.employment_type) %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Hire date') %></dt>
            <dd class="mt-1 text-sm text-gray-800 dark:text-gray-200"><%= employee.hire_date ? h.formatDate(employee.hire_date) : '—' %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Status') %></dt>
            <dd class="mt-1"><%= statusLabels[employee.status] || h.statusInfo(employee.status).label %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Email') %></dt>
            <dd class="mt-1 text-sm text-gray-800 dark:text-gray-200"><%= employee.email || '—' %></dd>
          </div>
        </dl>
      </div>

      <div class="mb-5 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
        <div class="card p-5">
          <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Hours worked') %></p>
          <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatDuration(report.workedMinutes) %></p>
          <p class="mt-1 text-xs text-gray-400"><%= t('of {hours} scheduled', { hours: h.formatDuration(report.expectedMinutes) }) %></p>
          <% if (report.expectedMinutes > 0) { %>
            <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800">
              <div class="h-full rounded-full <%= workedPct >= 100 ? 'bg-success-500' : workedPct >= 80 ? 'bg-brand-500' : 'bg-warning-500' %>" style="width: <%= barPct %>%"></div>
            </div>
          <% } %>
        </div>
        <div class="card p-5">
          <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Days registered') %></p>
          <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= report.daysRegistered %> <span class="text-base font-medium text-gray-400">/ <%= report.scheduledDays %></span></p>
          <p class="mt-1 text-xs text-gray-400"><%= t('scheduled days') %> · <%= report.calendarDays %> <%= t('calendar days') %></p>
        </div>
        <div class="card p-5">
          <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Tardiness') %></p>
          <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatDuration(report.lateMinutes) %></p>
          <p class="mt-1 text-xs text-gray-400"><%= report.lateCount %> <%= t('late arrivals') %></p>
        </div>
        <div class="card p-5">
          <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('Absences') %></p>
          <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= report.absentDays %></p>
          <p class="mt-1 text-xs text-gray-400"><%= t('Scheduled days without a record') %></p>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h2 class="card-title"><%= t('Attendance detail') %></h2>
          <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <%= report.records.length %> <%= t('records') %>
          </span>
        </div>
        <% if (report.records.length) { %>
          <div class="max-h-[70vh] overflow-auto">
            <table class="table-base min-w-[760px]">
              <thead class="sticky top-0 z-10 bg-white dark:bg-gray-900">
                <tr>
                  <th class="table-th"><%= t('Date') %></th>
                  <th class="table-th"><%= t('Clock in') %></th>
                  <th class="table-th"><%= t('Clock out') %></th>
                  <th class="table-th text-right"><%= t('Hours worked') %></th>
                  <th class="table-th"><%= t('Punctuality') %></th>
                </tr>
              </thead>
              <tbody>
                <% report.records.forEach((record) => { %>
                  <tr class="table-row">
                    <td class="table-td whitespace-nowrap"><%= h.formatDate(record.work_date) %></td>
                    <td class="table-td font-mono text-sm"><%= h.formatTime(record.clock_in) || '—' %></td>
                    <td class="table-td font-mono text-sm"><%= record.clock_out ? h.formatTime(record.clock_out) : '—' %></td>
                    <td class="table-td text-right font-medium"><%= record.worked_minutes !== null ? h.formatDuration(record.worked_minutes) : '—' %></td>
                    <td class="table-td">
                      <div class="flex flex-wrap items-center gap-1.5">
                        <%- statusBadge(record.punctuality) %>
                        <% if (Number(record.late_minutes) > Number(record.grace_minutes)) { %>
                          <span class="rounded-full bg-error-100 px-1.5 py-0.5 text-[10px] font-semibold text-error-700 dark:bg-error-500/20 dark:text-error-300">+<%= h.formatDuration(record.late_minutes) %></span>
                        <% } %>
                        <% if (Number(record.early_leave_minutes) > Number(record.early_leave_grace_minutes)) { %>
                          <span class="rounded-full bg-warning-100 px-1.5 py-0.5 text-[10px] font-semibold text-warning-700 dark:bg-warning-500/20 dark:text-warning-300">-<%= h.formatDuration(record.early_leave_minutes) %></span>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="px-6 py-12 text-center text-sm text-gray-400"><%= t('No attendance records in this period.') %></p>
        <% } %>
      </div>

      <p class="mt-4 text-xs text-gray-400"><%= t('Expected hours come from the shift assignments for scheduled work days in the period. Absences count scheduled days before today without a record.') %></p>
    </div>
  </main>
  <%- include('/layouts/footer') %>
</div>
