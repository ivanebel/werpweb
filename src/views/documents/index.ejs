<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1600px]">

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title"><%= doc.title %></h1>
          <p class="page-subtitle"><%= doc.indexSubtitle %></p>
        </div>
        <a href="<%= doc.basePath %>/new" class="btn btn-primary btn-sm">
          <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
          <%= doc.newLabel %>
        </a>
      </div>

      <div class="mb-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">
            <%- include('/partials/icon', { name: 'clipboard-list', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= stats.openLabel %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= h.formatNumber(stats.openCount, 0) %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-success-50 text-success-600 dark:bg-success-500/15 dark:text-success-400">
            <%- include('/partials/icon', { name: 'banknotes', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= stats.label %></p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= money(stats.openValue) %></p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <span class="kpi-icon bg-purple-50 text-purple-600 dark:bg-purple-500/15 dark:text-purple-400">
            <%- include('/partials/icon', { name: 'chart', className: 'h-6 w-6' }) %>
          </span>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400">Total (non-draft)</p>
            <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= money(stats.totalValue) %></p>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="flex flex-col gap-4 border-b border-gray-100 p-5 dark:border-gray-800 md:flex-row md:items-end md:justify-between">
          <form method="GET" action="<%= doc.basePath %>" class="flex flex-1 flex-wrap items-end gap-3">
            <div class="min-w-[240px] flex-1 md:max-w-md">
              <label for="q" class="form-label">Search</label>
              <div class="relative">
                <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400">
                  <%- include('/partials/icon', { name: 'search', className: 'h-4 w-4' }) %>
                </span>
                <input id="q" type="search" name="q" value="<%= search %>" class="form-input pl-10" placeholder="<%= t('Number, {party} or notes…', { party: doc.party.label.toLowerCase() }) %>">
              </div>
            </div>
            <div class="w-full sm:w-auto">
              <label for="status" class="form-label">Status</label>
              <select id="status" name="status" class="form-select sm:w-48">
                <option value="">All statuses</option>
                <% doc.statuses.forEach(status => { %>
                  <option value="<%= status %>" <%= activeStatus === status ? 'selected' : '' %>><%= h.statusInfo(status).label %></option>
                <% }) %>
              </select>
            </div>
            <button type="submit" class="btn btn-secondary">Apply</button>
            <% if (search || activeStatus) { %><a href="<%= doc.basePath %>" class="btn btn-ghost">Reset</a><% } %>
          </form>
          <span class="shrink-0 rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <%= h.pluralize(pagination.total, doc.singularLower, doc.titleLower) %>
          </span>
        </div>

        <div class="table-wrap">
          <table class="table-base">
            <thead>
              <tr>
                <th class="table-th"><%= doc.kind.includes('invoice') ? (doc.kind === 'purchase_invoice' ? 'Bill no.' : 'Invoice no.') : 'Order no.' %></th>
                <th class="table-th"><%= doc.party.label %></th>
                <th class="table-th"><%= doc.dateLabel %></th>
                <th class="table-th"><%= doc.dueLabel %></th>
                <th class="table-th">Status</th>
                <th class="table-th text-right">Total</th>
                <% if (doc.hasAmountPaid) { %><th class="table-th text-right">Balance</th><% } %>
                <th class="table-th text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(row => {
                const rowCustomerOrderNo = doc.customerOrder ? row.customer_order_no : row.linked_customer_order_no;
                const rowWarehouseName = doc.customerOrder ? row.warehouse_name : row.linked_warehouse_name;
                const rowWarehouseCode = doc.customerOrder ? row.warehouse_code : row.linked_warehouse_code;
              %>
                <tr class="table-row">
                  <td class="table-td">
                    <a href="<%= doc.basePath %>/<%= row.id %>" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= row[doc.numberField] %></a>
                    <% if (row.linked_order_no) { %><span class="mt-0.5 block text-xs text-gray-400"><%= t('Order {number}', { number: row.linked_order_no }) %></span><% } %>
                    <% if (rowCustomerOrderNo) { %><span class="mt-0.5 block text-xs text-gray-400"><%= t('Customer order no.') %>: <%= rowCustomerOrderNo %></span><% } %>
                  </td>
                  <td class="table-td">
                    <%= row.party_name %>
                    <% if (rowWarehouseName) { %><span class="mt-0.5 block text-xs text-gray-400"><%= rowWarehouseName %><%= rowWarehouseCode ? ` · ${rowWarehouseCode}` : '' %></span><% } %>
                  </td>
                  <td class="table-td text-gray-500 dark:text-gray-400"><%= h.formatDate(row[doc.dateField]) %></td>
                  <td class="table-td text-gray-500 dark:text-gray-400"><%= h.formatDate(row[doc.dueField]) %></td>
                  <td class="table-td"><%- statusBadge(row.status) %></td>
                  <td class="table-td text-right font-medium"><%= money(row.total) %></td>
                  <% if (doc.hasAmountPaid) { %>
                    <td class="table-td text-right <%= Number(row.total) - Number(row.amount_paid) > 0 ? 'text-warning-600 dark:text-warning-400' : 'text-success-600 dark:text-success-400' %>"><%= money(Number(row.total) - Number(row.amount_paid)) %></td>
                  <% } %>
                  <td class="table-td">
                    <div class="flex items-center justify-end gap-1">
                      <a href="<%= doc.basePath %>/<%= row.id %>" class="btn-icon" title="View">
                        <%- include('/partials/icon', { name: 'eye', className: 'h-4 w-4' }) %>
                      </a>
                      <a href="<%= doc.basePath %>/<%= row.id %>/edit" class="btn-icon" title="Edit">
                        <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %>
                      </a>
                      <a href="<%= doc.basePath %>/<%= row.id %>/print" class="btn-icon" title="Print">
                        <%- include('/partials/icon', { name: 'printer', className: 'h-4 w-4' }) %>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!rows.length) { %>
                <tr>
                  <td colspan="<%= doc.hasAmountPaid ? 8 : 7 %>" class="px-6 py-16 text-center">
                    <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400 dark:bg-gray-800">
                      <%- include('/partials/icon', { name: 'clipboard-list', className: 'h-6 w-6' }) %>
                    </span>
                    <p class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= t('No {items} found', { items: doc.titleLower }) %></p>
                    <p class="mt-1 text-sm text-gray-400"><%= t('Adjust the filters or create a new {item}.', { item: doc.singularLower }) %></p>
                    <a href="<%= doc.basePath %>/new" class="btn btn-primary btn-sm mt-4"><%= doc.newLabel %></a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <%- include('/partials/pagination', { pagination, basePath: doc.basePath, query }) %>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
