<%
  const labels = {
    sales_order: t('Sales Order'),
    purchase_order: t('Purchase Order'),
    sales_invoice: t('Invoice'),
    purchase_invoice: t('Purchase Invoice')
  };
  const docTitle = labels[doc.kind] || t('Document');
  const isInvoice = doc.kind.includes('invoice');
  const showCustomerCode = doc.party.table === 'customers';
  const balance = Number(row.total) - Number(row.amount_paid || 0);
  const linked = typeof linkedOrder !== 'undefined' ? linkedOrder : null;
  const customerOrder = doc.customerOrder
    ? row
    : (linked && linked.customer_order_no !== undefined ? linked : null);
%>
<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= docTitle %> <%= row[doc.numberField] %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>">
  <style>
    @page { size: A4; margin: 14mm; }
    body { background: #fff; color: #1d2939; }
    @media print {
      .no-print { display: none !important; }
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>
<body class="bg-gray-100 font-outfit text-gray-800" data-locale="<%= locale %>">
  <div class="no-print sticky top-0 z-10 flex items-center justify-between border-b border-gray-200 bg-white px-6 py-3">
    <a href="<%= doc.basePath %>/<%= row.id %>" class="btn btn-secondary btn-sm"><%= t('Back to {item}', { item: docTitle.toLowerCase() }) %></a>
    <div class="flex items-center gap-2">
      <span class="text-sm text-gray-500"><%= docTitle %> <%= row[doc.numberField] %></span>
      <button type="button" onclick="window.print()" class="btn btn-primary btn-sm">Print / Save PDF</button>
    </div>
  </div>

  <div class="mx-auto my-6 max-w-[820px] bg-white p-8 shadow-theme-lg print:my-0 print:max-w-none print:p-0 print:shadow-none sm:p-10">
    <div class="flex flex-wrap items-start justify-between gap-6 border-b border-gray-200 pb-6">
      <div>
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500 text-lg font-bold text-white"><%= (settings.company_name || 'W').charAt(0) %></span>
          <div>
            <p class="text-lg font-bold text-gray-900"><%= settings.company_name %></p>
            <p class="text-xs text-gray-500"><%= settings.company_email %><%= settings.company_phone ? ' · ' + settings.company_phone : '' %></p>
          </div>
        </div>
        <div class="mt-4 whitespace-pre-line text-xs leading-relaxed text-gray-500"><%= settings.company_address %></div>
        <% if (settings.company_tax_id) { %><p class="mt-1 text-xs text-gray-500">Tax ID: <%= settings.company_tax_id %></p><% } %>
      </div>
      <div class="text-right">
        <p class="text-2xl font-semibold uppercase tracking-wide text-brand-600"><%= docTitle %></p>
        <p class="mt-1 text-sm font-medium text-gray-700"><%= row[doc.numberField] %></p>
        <div class="mt-3 space-y-0.5 text-xs text-gray-500">
          <p><span class="font-medium text-gray-700"><%= doc.dateLabel %>:</span> <%= h.formatDate(row[doc.dateField]) %></p>
          <p><span class="font-medium text-gray-700"><%= doc.dueLabel %>:</span> <%= h.formatDate(row[doc.dueField]) %></p>
          <p><span class="font-medium text-gray-700">Status:</span> <%= h.statusInfo(row.status).label %></p>
        </div>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-8 sm:grid-cols-2">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-gray-400"><%= isInvoice && doc.kind === 'purchase_invoice' ? t('Vendor') : isInvoice ? t('Bill to') : doc.party.label %></p>
        <p class="mt-2 text-sm font-semibold text-gray-900"><%= row.party_name %></p>
        <% if (row.party_contact) { %><p class="text-sm text-gray-600"><%= row.party_contact %></p><% } %>
        <% if (row.party_address) { %><p class="text-sm text-gray-600"><%= row.party_address %></p><% } %>
        <% if (row.party_city) { %><p class="text-sm text-gray-600"><%= row.party_city %><%= row.party_state ? ', ' + row.party_state : '' %> <%= row.party_postal %></p><% } %>
        <% if (row.party_country) { %><p class="text-sm text-gray-600"><%= row.party_country %></p><% } %>
        <% if (row.party_email) { %><p class="mt-1 text-sm text-gray-600"><%= row.party_email %></p><% } %>
        <% if (row.party_tax_id) { %><p class="mt-1 text-xs text-gray-500">Tax ID: <%= row.party_tax_id %></p><% } %>

        <% if (customerOrder && customerOrder.warehouse_name) { %>
          <div class="mt-4 border-t border-gray-200 pt-3">
            <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-gray-400"><%= t('Destination warehouse') %></p>
            <p class="mt-1 text-sm font-semibold text-gray-900"><%= customerOrder.warehouse_name %><%= customerOrder.warehouse_code ? ` · ${customerOrder.warehouse_code}` : '' %></p>
            <% if (customerOrder.warehouse_address) { %><p class="text-sm text-gray-600"><%= customerOrder.warehouse_address %></p><% } %>
            <% if (customerOrder.warehouse_city) { %><p class="text-sm text-gray-600"><%= customerOrder.warehouse_city %><%= customerOrder.warehouse_state ? ', ' + customerOrder.warehouse_state : '' %> <%= customerOrder.warehouse_postal || '' %></p><% } %>
            <% if (customerOrder.warehouse_country) { %><p class="text-sm text-gray-600"><%= customerOrder.warehouse_country %></p><% } %>
          </div>
        <% } %>
      </div>
      <div class="sm:text-right">
        <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-gray-400">Summary</p>
        <p class="mt-2 text-sm text-gray-600"><%= h.pluralize(items.length, 'line') %></p>
        <% if (linked && doc.linkOrder) { %>
          <p class="text-sm text-gray-600"><%= t('Against order #') %><%= linked.order_no %></p>
        <% } else if (doc.linkOrder && row[doc.linkOrder.field]) { %>
          <p class="text-sm text-gray-600"><%= t('Against order #') %><%= row[doc.linkOrder.field] %></p>
        <% } %>
        <% if (customerOrder) { %>
          <% if (customerOrder.customer_order_no) { %><p class="text-sm text-gray-600"><%= t('Customer order no.') %>: <span class="font-medium text-gray-800"><%= customerOrder.customer_order_no %></span></p><% } %>
          <% if (customerOrder.docking_station) { %><p class="text-sm text-gray-600"><%= t('Docking station') %>: <span class="font-medium text-gray-800"><%= customerOrder.docking_station %></span></p><% } %>
          <% if (customerOrder.reception_at) { %><p class="text-sm text-gray-600"><%= t('Reception date & time') %>: <span class="font-medium text-gray-800"><%= h.formatDateTime(customerOrder.reception_at) %></span></p><% } %>
        <% } %>
        <% if (isInvoice) { %>
          <p class="mt-3 inline-block rounded-full px-3 py-1 text-xs font-medium <%= balance > 0.005 ? 'bg-warning-50 text-warning-700' : 'bg-success-50 text-success-700' %>">
            <%= balance > 0.005 ? t('Balance due {amount}', { amount: money(balance) }) : t('Paid in full') %>
          </p>
        <% } %>
      </div>
    </div>

    <table class="mt-8 w-full border-collapse text-left text-sm">
      <thead>
        <tr class="border-y border-gray-200 bg-gray-50 text-[10px] uppercase tracking-wide text-gray-500">
          <th class="py-2.5 pl-3 pr-2 font-semibold">Item</th>
          <% if (showCustomerCode) { %><th class="px-2 py-2.5 font-semibold">Customer code</th><% } %>
          <th class="px-2 py-2.5 text-right font-semibold">Qty</th>
          <th class="px-2 py-2.5 text-right font-semibold">Unit price</th>
          <th class="px-2 py-2.5 text-right font-semibold">VAT</th>
          <th class="py-2.5 pl-2 pr-3 text-right font-semibold">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(item => { %>
          <tr class="border-b border-gray-100">
            <td class="py-3 pl-3 pr-2 align-top">
              <p class="font-medium text-gray-800"><%= item.name %></p>
              <p class="text-xs text-gray-500"><%= item.sku %><%= item.description ? ' · ' + item.description : '' %></p>
            </td>
            <% if (showCustomerCode) { %>
              <td class="px-2 py-3 align-top font-mono text-xs text-gray-600"><%= item.customer_code || '—' %></td>
            <% } %>
            <td class="px-2 py-3 text-right align-top whitespace-nowrap"><%= h.formatQty(item.quantity) %> <span class="text-xs text-gray-400"><%= item.unit %></span></td>
            <td class="px-2 py-3 text-right align-top whitespace-nowrap"><%= money(item.unit_price) %></td>
            <td class="px-2 py-3 text-right align-top"><%= h.formatNumber(item.tax_rate, 2) %>%</td>
            <td class="py-3 pl-2 pr-3 text-right align-top font-medium whitespace-nowrap"><%= money(item.line_total) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="mt-5 flex justify-end">
      <div class="w-full max-w-[280px] space-y-1.5 text-sm">
        <div class="flex justify-between"><span class="text-gray-500">Subtotal (incl. VAT)</span><span class="font-medium"><%= money(row.subtotal) %></span></div>
        <% if (Number(row.discount_total) > 0) { %>
          <div class="flex justify-between"><span class="text-gray-500">Discount</span><span class="font-medium">− <%= money(row.discount_total) %></span></div>
        <% } %>
        <div class="flex justify-between"><span class="text-gray-500">VAT included</span><span class="font-medium"><%= money(row.tax_total) %></span></div>
        <div class="flex justify-between border-t border-gray-200 pt-2 text-base font-semibold"><span>Total</span><span><%= money(row.total) %></span></div>
        <p class="text-right text-[10px] text-gray-400">All prices include VAT.</p>
        <% if (isInvoice && Number(row.amount_paid) > 0) { %>
          <div class="flex justify-between text-gray-500"><span>Paid</span><span><%= money(row.amount_paid) %></span></div>
          <div class="flex justify-between font-semibold"><span>Balance due</span><span><%= money(balance) %></span></div>
        <% } %>
      </div>
    </div>

    <% if (row.notes) { %>
      <div class="mt-8 border-t border-gray-200 pt-4">
        <p class="text-[10px] font-semibold uppercase tracking-wide text-gray-400">Notes</p>
        <p class="mt-1 whitespace-pre-line text-sm text-gray-600"><%= row.notes %></p>
      </div>
    <% } %>

    <div class="mt-10 border-t border-gray-200 pt-4 text-center text-xs text-gray-400">
      <%= settings.invoice_footer || t('Thank you for your business.') %>
    </div>
  </div>
</body>
</html>
