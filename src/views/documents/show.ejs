<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1400px]">
      <%
        const isInvoice = doc.kind.includes('invoice');
        const isSalesInvoice = doc.kind === 'sales_invoice';
        const numberLabel = t(doc.kind === 'purchase_invoice' ? 'Bill' : isInvoice ? 'Invoice' : 'Order');
        const showCustomerCode = doc.party.table === 'customers';
        const balance = Number(row.total) - Number(row.amount_paid || 0);
        const caePending = isSalesInvoice && !row.cae;
        const toneClass = { primary: 'btn-primary', secondary: 'btn-secondary', danger: 'btn-danger', success: 'btn-success' };
        const customerOrder = doc.customerOrder
          ? row
          : (linkedOrder && linkedOrder.customer_order_no !== undefined ? linkedOrder : null);
      %>

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="page-title"><%= row[doc.numberField] %></h1>
            <%- statusBadge(row.status) %>
            <% if (isInvoice && row.document_type_name) { %>
              <span class="badge bg-brand-50 text-brand-700 ring-brand-600/20 dark:bg-brand-500/15 dark:text-brand-400"><%= row.document_type_name %></span>
            <% } %>
            <% if (caePending) { %>
              <span class="badge bg-warning-50 text-warning-700 ring-warning-600/20 dark:bg-warning-500/15 dark:text-warning-400"><%= t('CAE pending') %></span>
            <% } %>
          </div>
          <p class="page-subtitle"><%= doc.singular %> · <%= row.party_name %> · <%= h.formatDate(row[doc.dateField]) %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="<%= doc.basePath %>" class="btn btn-secondary btn-sm">
            <%- include('/partials/icon', { name: 'arrow-left', className: 'h-4 w-4' }) %> Back
          </a>
          <% if (!doc.lockedStatuses || !doc.lockedStatuses.includes(row.status)) { %>
            <a href="<%= doc.basePath %>/<%= row.id %>/edit" class="btn btn-secondary btn-sm">
              <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %> Edit
            </a>
          <% } %>
          <% actions.forEach(a => { %>
            <% if (a.href) { %>
              <a href="<%= a.href %>" class="btn <%= toneClass[a.tone] || 'btn-secondary' %> btn-sm"><%= a.label %></a>
            <% } else { %>
              <form method="POST" action="<%= a.action === 'production' ? `${doc.basePath}/${row.id}/production` : `${doc.basePath}/${row.id}/status` %>" class="inline" <%= a.confirm ? `data-confirm="${a.action === 'production' ? 'Generate production orders for manufactured products?' : 'Are you sure you want to continue?'}"` : '' %>>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% if (a.action === 'status') { %><input type="hidden" name="status" value="<%= a.value %>"><% } %>
                <button type="submit" class="btn <%= toneClass[a.tone] || 'btn-secondary' %> btn-sm"><%= a.label %></button>
              </form>
            <% } %>
          <% }) %>
          <% if (['draft', 'cancelled'].includes(row.status)) { %>
            <form method="POST" action="<%= doc.basePath %>/<%= row.id %>/delete" data-confirm="<%= t('Delete {number}? This cannot be undone.', { number: row[doc.numberField] }) %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-danger btn-sm">
                <%- include('/partials/icon', { name: 'trash', className: 'h-4 w-4' }) %> Delete
              </button>
            </form>
          <% } %>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5 xl:grid-cols-3">
        <div class="card overflow-hidden xl:col-span-2">
          <div class="flex flex-wrap items-start justify-between gap-4 border-b border-gray-100 px-6 py-5 dark:border-gray-800">
            <div>
              <div class="flex items-center gap-2.5">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 text-sm font-bold text-white">W</span>
                <div>
                  <p class="text-sm font-semibold text-gray-800 dark:text-white/90"><%= settings.company_name %></p>
                  <p class="text-xs text-gray-400"><%= settings.company_email %></p>
                </div>
              </div>
              <div class="mt-4 whitespace-pre-line text-xs leading-relaxed text-gray-500 dark:text-gray-400"><%= settings.company_address %></div>
            </div>
            <div class="text-right">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400"><%= isInvoice && row.document_type_name ? row.document_type_name : numberLabel %></p>
              <p class="mt-1 text-lg font-semibold text-gray-800 dark:text-white/90"><%= row[doc.numberField] %></p>
              <p class="mt-2 text-xs text-gray-500 dark:text-gray-400"><%= doc.dateLabel %>: <span class="font-medium text-gray-700 dark:text-gray-300"><%= h.formatDate(row[doc.dateField]) %></span></p>
              <p class="text-xs text-gray-500 dark:text-gray-400"><%= doc.dueLabel %>: <span class="font-medium text-gray-700 dark:text-gray-300"><%= h.formatDate(row[doc.dueField]) %></span></p>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-6 px-6 py-5 sm:grid-cols-2">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-400"><%= isInvoice && doc.kind === 'purchase_invoice' ? t('Vendor') : isInvoice ? t('Bill to') : doc.party.label %></p>
              <p class="mt-2 text-sm font-semibold text-gray-800 dark:text-gray-200"><%= row.party_name %></p>
              <% if (row.party_contact) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= row.party_contact %></p><% } %>
              <% if (row.party_address) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= row.party_address %></p><% } %>
              <% if (row.party_city) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= row.party_city %><%= row.party_state ? ', ' + row.party_state : '' %> <%= row.party_postal %></p><% } %>
              <% if (row.party_email) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= row.party_email %></p><% } %>
            </div>
            <div class="sm:text-right">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Reference</p>
              <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= t('Created {date}', { date: h.formatDate(row.created_at) }) %></p>
              <% if (row.party_tax_id) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= t('Tax ID:') %> <%= row.party_tax_id %></p><% } %>
              <% if (linkedOrder) { %>
                <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
                  <%= t('Linked order:') %>
                  <a href="<%= doc.kind === 'sales_invoice' ? '/sales-orders/' : '/purchase-orders/' %><%= linkedOrder.id %>" class="link"><%= linkedOrder.order_no %></a>
                </p>
              <% } %>
              <% if (customerOrder) { %>
                <div class="mt-3 space-y-1 border-t border-gray-100 pt-3 text-sm dark:border-gray-800">
                  <% if (customerOrder.customer_order_no) { %>
                    <p class="text-gray-500 dark:text-gray-400"><%= t('Customer order no.') %>: <span class="font-medium text-gray-700 dark:text-gray-300"><%= customerOrder.customer_order_no %></span></p>
                  <% } %>
                  <% if (customerOrder.warehouse_name) { %>
                    <p class="text-gray-500 dark:text-gray-400"><%= t('Destination warehouse') %>: <span class="font-medium text-gray-700 dark:text-gray-300"><%= customerOrder.warehouse_name %><%= customerOrder.warehouse_code ? ` (${customerOrder.warehouse_code})` : '' %></span></p>
                    <% if (customerOrder.warehouse_address) { %><p class="text-xs text-gray-400"><%= customerOrder.warehouse_address %><%= customerOrder.warehouse_city ? `, ${customerOrder.warehouse_city}` : '' %><%= customerOrder.warehouse_state ? `, ${customerOrder.warehouse_state}` : '' %> <%= customerOrder.warehouse_postal || '' %></p><% } %>
                  <% } %>
                  <% if (customerOrder.docking_station) { %>
                    <p class="text-gray-500 dark:text-gray-400"><%= t('Docking station') %>: <span class="font-medium text-gray-700 dark:text-gray-300"><%= customerOrder.docking_station %></span></p>
                  <% } %>
                  <% if (customerOrder.reception_at) { %>
                    <p class="text-gray-500 dark:text-gray-400"><%= t('Reception date & time') %>: <span class="font-medium text-gray-700 dark:text-gray-300"><%= h.formatDateTime(customerOrder.reception_at) %></span></p>
                  <% } %>
                </div>
              <% } %>
            </div>
          </div>

          <div class="table-wrap border-t border-gray-100 dark:border-gray-800">
            <table class="table-base min-w-[680px]">
              <thead>
                <tr>
                  <th class="table-th">Item</th>
                  <% if (showCustomerCode) { %><th class="table-th">Customer code</th><% } %>
                  <th class="table-th text-right">Qty</th>
                  <% if (doc.showDelivered) { %><th class="table-th text-right"><%= doc.qtyLabel %></th><% } %>
                  <th class="table-th text-right">Unit price</th>
                  <th class="table-th text-right">VAT</th>
                  <th class="table-th text-right">Amount</th>
                </tr>
              </thead>
              <tbody>
                <% items.forEach(item => { %>
                  <tr>
                    <td class="table-td">
                      <p class="font-medium text-gray-800 dark:text-gray-200"><%= item.name %></p>
                      <p class="text-xs text-gray-400"><%= item.sku %><%= item.description ? ' · ' + item.description : '' %></p>
                    </td>
                    <% if (showCustomerCode) { %>
                      <td class="table-td font-mono text-xs text-gray-600 dark:text-gray-300"><%= item.customer_code || '—' %></td>
                    <% } %>
                    <td class="table-td text-right"><%= h.formatQty(item.quantity) %> <span class="text-xs text-gray-400"><%= item.unit %></span></td>
                    <% if (doc.showDelivered) { %><td class="table-td text-right"><%= h.formatQty(item[doc.qtyKey]) %></td><% } %>
                    <td class="table-td text-right"><%= money(item.unit_price) %></td>
                    <td class="table-td text-right"><%= h.formatNumber(item.tax_rate, 2) %>%</td>
                    <td class="table-td text-right font-medium"><%= money(item.line_total) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="flex flex-col items-end gap-2 border-t border-gray-100 px-6 py-5 dark:border-gray-800">
            <div class="w-full max-w-xs space-y-2 text-sm">
              <div class="flex justify-between"><span class="text-gray-500 dark:text-gray-400">Subtotal (incl. VAT)</span><span class="font-medium text-gray-700 dark:text-gray-300"><%= money(row.subtotal) %></span></div>
              <% if (Number(row.discount_total) > 0) { %>
                <div class="flex justify-between"><span class="text-gray-500 dark:text-gray-400">Discount</span><span class="font-medium text-gray-700 dark:text-gray-300">− <%= money(row.discount_total) %></span></div>
              <% } %>
              <div class="flex justify-between"><span class="text-gray-500 dark:text-gray-400">VAT included</span><span class="font-medium text-gray-700 dark:text-gray-300"><%= money(row.tax_total) %></span></div>
              <div class="flex justify-between border-t border-gray-100 pt-2 text-base dark:border-gray-800"><span class="font-semibold text-gray-800 dark:text-gray-200">Total</span><span class="font-bold text-gray-900 dark:text-white"><%= money(row.total) %></span></div>
              <p class="pt-1 text-right text-[11px] text-gray-400">All prices include VAT.</p>
              <% if (doc.hasAmountPaid) { %>
                <div class="flex justify-between"><span class="text-gray-500 dark:text-gray-400">Paid</span><span class="font-medium text-success-600 dark:text-success-400"><%= money(row.amount_paid) %></span></div>
                <div class="flex justify-between"><span class="text-gray-500 dark:text-gray-400">Balance due</span><span class="font-semibold <%= balance > 0.005 ? 'text-warning-600 dark:text-warning-400' : 'text-success-600 dark:text-success-400' %>"><%= money(balance) %></span></div>
              <% } %>
            </div>
          </div>

          <% if (row.notes) { %>
            <div class="border-t border-gray-100 px-6 py-4 dark:border-gray-800">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Notes</p>
              <p class="mt-1 whitespace-pre-line text-sm text-gray-600 dark:text-gray-400"><%= row.notes %></p>
            </div>
          <% } %>
        </div>

        <div class="space-y-5">
          <div class="card p-5 md:p-6">
            <div class="flex items-center justify-between">
              <h2 class="card-title">Document status</h2>
              <%- statusBadge(row.status) %>
            </div>
            <dl class="mt-4 space-y-3 text-sm">
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Number</dt><dd class="font-mono text-xs text-gray-700 dark:text-gray-300"><%= row[doc.numberField] %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= doc.dateLabel %></dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= h.formatDate(row[doc.dateField]) %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= doc.dueLabel %></dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= h.formatDate(row[doc.dueField]) %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('Created by') %></dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= row.created_by ? t('User #') + row.created_by : t('System') %></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400">Last updated</dt><dd class="text-gray-700 dark:text-gray-300"><%= h.formatDate(row.updated_at) %></dd></div>
            </dl>
          </div>

          <% if (isInvoice) { %>
            <div class="card p-5 md:p-6">
              <div class="flex items-center justify-between gap-3">
                <h2 class="card-title"><%= t('Fiscal information') %></h2>
                <% if (caePending) { %><span class="badge bg-warning-50 text-warning-700 ring-warning-600/20 dark:bg-warning-500/15 dark:text-warning-400"><%= t('CAE pending') %></span><% } %>
              </div>
              <dl class="mt-4 space-y-3 text-sm">
                <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('Fiscal document type') %></dt><dd class="text-right font-medium text-gray-700 dark:text-gray-300"><%= row.document_type_name || t('Not set') %></dd></div>
                <% if (isSalesInvoice) { %>
                  <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('CAE number') %></dt><dd class="font-mono text-xs text-gray-700 dark:text-gray-300"><%= row.cae || t('Pending') %></dd></div>
                  <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('CAE expiry date') %></dt><dd class="text-gray-700 dark:text-gray-300"><%= h.formatDate(row.cae_expiry_date) %></dd></div>
                  <% if (row.cbu) { %><div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('CBU number') %></dt><dd class="font-mono text-xs text-gray-700 dark:text-gray-300"><%= row.cbu %></dd></div><% } %>
                  <% if (row.transfer_option) { %><div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('Transfer option') %></dt><dd class="font-medium text-gray-700 dark:text-gray-300"><%= row.transfer_option %></dd></div><% } %>
                  <% if (row.payment_expiry_date) { %><div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('Payment expiry date') %></dt><dd class="text-gray-700 dark:text-gray-300"><%= h.formatDate(row.payment_expiry_date) %></dd></div><% } %>
                <% } else { %>
                  <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-gray-400"><%= t('Supplier remito no.') %></dt><dd class="text-gray-700 dark:text-gray-300"><%= row.packing_slip_no || '—' %></dd></div>
                <% } %>
              </dl>
            </div>
          <% } %>

          <div class="card p-5 md:p-6">
            <h2 class="card-title"><%= doc.party.label %></h2>
            <p class="mt-3 text-sm font-semibold text-gray-800 dark:text-gray-200"><%= row.party_name %></p>
            <% if (row.party_contact) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= row.party_contact %></p><% } %>
            <% if (row.party_email) { %><p class="mt-1 text-sm"><a href="mailto:<%= row.party_email %>" class="link"><%= row.party_email %></a></p><% } %>
            <% if (row.party_phone) { %><p class="text-sm text-gray-500 dark:text-gray-400"><%= row.party_phone %></p><% } %>
            <a href="<%= doc.partyBase %>/<%= row[doc.party.field] %>" class="btn btn-secondary btn-sm mt-4 w-full"><%= t('Open {party}', { party: doc.party.label.toLowerCase() }) %></a>
          </div>

          <% if (linkedDeliveries && linkedDeliveries.length) { %>
            <div class="card">
              <div class="card-header"><h2 class="card-title"><%= t('Packing slips (remitos)') %></h2></div>
              <div class="divide-y divide-gray-100 dark:divide-gray-800">
                <% linkedDeliveries.forEach(delivery => { %>
                  <a href="/deliveries/<%= delivery.id %>" class="flex items-center justify-between gap-3 px-5 py-3.5 hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                    <div>
                      <p class="font-mono text-sm font-medium text-gray-800 dark:text-gray-200"><%= delivery.packing_slip_no || delivery.delivery_no %></p>
                      <p class="text-xs text-gray-400"><%= h.formatDate(delivery.delivery_date) %><% if (delivery.packing_slip_no) { %> · <%= delivery.delivery_no %><% } %></p>
                    </div>
                    <%- statusBadge(delivery.status) %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>

          <% if (relatedInvoices && relatedInvoices.length) { %>
            <div class="card">
              <div class="card-header"><h2 class="card-title"><%= t('Related invoices') %></h2></div>
              <div class="divide-y divide-gray-100 dark:divide-gray-800">
                <% relatedInvoices.forEach(invoice => { %>
                  <a href="<%= doc.basePath %>/<%= invoice.id %>" class="flex items-center justify-between gap-3 px-5 py-3.5 hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                    <div>
                      <p class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= invoice.number %></p>
                      <p class="text-xs text-gray-400"><%= invoice.document_type_name || t('Not set') %> · <%= h.formatDate(invoice.invoice_date) %> · <%= money(invoice.total) %></p>
                    </div>
                    <%- statusBadge(invoice.status) %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>

          <% if (relatedNotes && relatedNotes.length) { %>
            <div class="card">
              <div class="card-header"><h2 class="card-title"><%= t('Credit and debit notes') %></h2></div>
              <div class="divide-y divide-gray-100 dark:divide-gray-800">
                <% relatedNotes.forEach(note => { %>
                  <a href="<%= doc.basePath %>/<%= note.id %>" class="flex items-center justify-between gap-3 px-5 py-3.5 hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                    <div>
                      <p class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= note.number %></p>
                      <p class="text-xs text-gray-400"><%= note.document_type_name || t('Not set') %> · <%= h.formatDate(note.invoice_date) %> · <%= money(note.total) %></p>
                    </div>
                    <%- statusBadge(note.status) %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>

          <% if (doc.kind === 'sales_order' && deliveries.length) { %>
            <div class="card">
              <div class="card-header"><h2 class="card-title">Deliveries</h2></div>
              <div class="divide-y divide-gray-100 dark:divide-gray-800">
                <% deliveries.forEach(d => { %>
                  <a href="/deliveries/<%= d.id %>" class="flex items-center justify-between px-5 py-3.5 hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                    <div>
                      <p class="font-mono text-sm font-medium text-gray-800 dark:text-gray-200"><%= d.packing_slip_no || d.delivery_no %></p>
                      <p class="text-xs text-gray-400"><%= h.formatDate(d.delivery_date) %> · <%= h.pluralize(d.item_count, 'item') %><% if (d.packing_slip_no) { %> · <%= t('Delivery reference') %> <span class="font-mono"><%= d.delivery_no %></span><% } %></p>
                    </div>
                    <%- statusBadge(d.status) %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>

          <% if (doc.kind === 'sales_order' && invoices.length) { %>
            <div class="card">
              <div class="card-header"><h2 class="card-title">Invoices</h2></div>
              <div class="divide-y divide-gray-100 dark:divide-gray-800">
                <% invoices.forEach(inv => { %>
                  <a href="/sales/<%= inv.id %>" class="flex items-center justify-between px-5 py-3.5 hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                    <div>
                      <p class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= inv.invoice_no %></p>
                      <p class="text-xs text-gray-400"><%= h.formatDate(inv.invoice_date) %> · <%= money(inv.total) %></p>
                    </div>
                    <%- statusBadge(inv.status) %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>

          <% if (doc.kind === 'sales_order' && productionOrders.length) { %>
            <div class="card">
              <div class="card-header"><h2 class="card-title">Production</h2></div>
              <div class="divide-y divide-gray-100 dark:divide-gray-800">
                <% productionOrders.forEach(po => { %>
                  <a href="/manufacturing/production-orders/<%= po.id %>" class="flex items-center justify-between px-5 py-3.5 hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                    <div>
                      <p class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= po.production_no %></p>
                      <p class="text-xs text-gray-400">
                        <%= po.first_product_name ? `${po.first_product_name} · ` : '' %><%= h.pluralize(po.line_count, 'BOM line') %> · <%= t('Due') %> <%= h.formatDate(po.due_date) %>
                      </p>
                    </div>
                    <%- statusBadge(po.status) %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>

          <% if (doc.kind === 'purchase_order' && invoices.length) { %>
            <div class="card">
              <div class="card-header"><h2 class="card-title">Bills</h2></div>
              <div class="divide-y divide-gray-100 dark:divide-gray-800">
                <% invoices.forEach(inv => { %>
                  <a href="/purchases/<%= inv.id %>" class="flex items-center justify-between px-5 py-3.5 hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                    <div>
                      <p class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= inv.bill_no %></p>
                      <p class="text-xs text-gray-400"><%= h.formatDate(inv.invoice_date) %> · <%= money(inv.total) %></p>
                    </div>
                    <%- statusBadge(inv.status) %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
