<%- include('/layouts/head') %>
<%- include('/layouts/sidebar') %>
<div class="flex min-h-screen flex-col lg:pl-[290px]">
  <%- include('/layouts/header') %>
  <main class="flex-1 p-4 md:p-6">
    <div class="mx-auto max-w-[1200px]">
      <%
        const roleTone = {
          admin: 'bg-purple-50 text-purple-700 ring-purple-600/20 dark:bg-purple-500/15 dark:text-purple-400',
          manager: 'bg-blue-light-50 text-blue-light-700 ring-blue-light-600/20 dark:bg-blue-light-500/15 dark:text-blue-light-400',
          staff: 'bg-gray-100 text-gray-700 ring-gray-500/20 dark:bg-gray-500/15 dark:text-gray-400'
        };
      %>

      <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="page-title">Users</h1>
          <p class="page-subtitle">Control who can access the ERP and what they are allowed to do.</p>
        </div>
        <a href="/settings/users/new" class="btn btn-primary btn-sm">
          <%- include('/partials/icon', { name: 'plus', className: 'h-4 w-4' }) %>
          New user
        </a>
      </div>

      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Team accounts</h2>
          <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300"><%= h.pluralize(users.length, 'user') %></span>
        </div>
        <div class="table-wrap">
          <table class="table-base">
            <thead>
              <tr>
                <th class="table-th">User</th>
                <th class="table-th">Role</th>
                <th class="table-th">Status</th>
                <th class="table-th">Last login</th>
                <th class="table-th">Created</th>
                <th class="table-th text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(row => { const isSelf = row.id === currentUser.id; %>
                <tr class="table-row">
                  <td class="table-td">
                    <div class="flex items-center gap-3">
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-semibold text-brand-700 dark:bg-brand-500/20 dark:text-brand-300"><%= h.initials(row.name) %></span>
                      <div class="min-w-0">
                        <div class="flex items-center gap-2">
                          <a href="/settings/users/<%= row.id %>/edit" class="font-medium text-gray-900 hover:text-brand-600 dark:text-white/90 dark:hover:text-brand-400"><%= row.name %></a>
                          <% if (isSelf) { %><span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">You</span><% } %>
                        </div>
                        <p class="truncate text-xs text-gray-400"><%= row.email %></p>
                      </div>
                    </div>
                  </td>
                  <td class="table-td">
                    <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium capitalize ring-1 ring-inset <%= roleTone[row.role] || roleTone.staff %>"><%= row.role %></span>
                  </td>
                  <td class="table-td"><%- statusBadge(Number(row.is_active) === 1 ? 'active' : 'inactive') %></td>
                  <td class="table-td text-gray-500 dark:text-gray-400"><%= h.formatDateTime(row.last_login_at) %></td>
                  <td class="table-td text-gray-500 dark:text-gray-400"><%= h.formatDate(row.created_at) %></td>
                  <td class="table-td">
                    <div class="flex items-center justify-end gap-1">
                      <a href="/settings/users/<%= row.id %>/edit" class="btn-icon" title="Edit">
                        <%- include('/partials/icon', { name: 'pencil', className: 'h-4 w-4' }) %>
                      </a>
                      <% if (!isSelf) { %>
                        <form action="/settings/users/<%= row.id %>/delete" method="POST" class="inline" data-confirm="<%= t('Delete {name}? They will lose access immediately.', { name: row.name }) %>">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn-icon text-error-500 hover:bg-error-50 hover:text-error-600 dark:text-error-400 dark:hover:bg-error-500/10" title="Delete">
                            <%- include('/partials/icon', { name: 'trash', className: 'h-4 w-4' }) %>
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (!users.length) { %>
                <tr>
                  <td colspan="6" class="px-6 py-16 text-center">
                    <p class="text-sm font-medium text-gray-700 dark:text-gray-300">No users found</p>
                    <a href="/settings/users/new" class="btn btn-primary btn-sm mt-4">Create a user</a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="card p-5">
          <p class="text-sm font-semibold text-gray-800 dark:text-gray-200">Admin</p>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Full access including users and company settings.</p>
        </div>
        <div class="card p-5">
          <p class="text-sm font-semibold text-gray-800 dark:text-gray-200">Manager</p>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Operational access and company settings, but no user administration.</p>
        </div>
        <div class="card p-5">
          <p class="text-sm font-semibold text-gray-800 dark:text-gray-200">Staff</p>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Day-to-day records, orders, deliveries and production.</p>
        </div>
      </div>
    </div>
  </main>
  <%- include('/layouts/footer') %>
