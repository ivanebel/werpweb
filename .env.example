# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Generate a long random string for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=erp_user
DB_PASSWORD=secret
DB_NAME=werp_erp

# ---------------------------------------------------------------------------
# Optional SSH tunnel (set DB_SSH_ENABLED=true to use it)
# When enabled the app opens a local port and forwards it through SSH to the
# MySQL server, then connects mysql2 to the forwarded port.
# ---------------------------------------------------------------------------
DB_SSH_ENABLED=false
SSH_HOST=your-server.example.com
SSH_PORT=22
SSH_USER=deploy
# Use either a password or a private key file (not both).
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_PRIVATE_KEY_PASSPHRASE=
# Host/port of MySQL as seen *from the SSH server*
DB_REMOTE_HOST=127.0.0.1
DB_REMOTE_PORT=3306

# Set to true if MySQL requires TLS
DB_SSL=false

# ---------------------------------------------------------------------------
# Optional Telegram bot (read-only production queries)
# ---------------------------------------------------------------------------
# Create a bot with @BotFather, then paste the token here.
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_BOT_USERNAME=your_company_bot
# Public URL used in clickable links. It must be reachable from the phones.
# APP_PUBLIC_URL=https://erp.example.com
# TELEGRAM_POLL_TIMEOUT=25

# ---------------------------------------------------------------------------
# Scale / labeling machine legacy database
# ---------------------------------------------------------------------------
# The middleware writes produccion_balanza into the legacy database. The app
# reads it through a separate, read-only connection.
# SCALE_SYNC_ENABLED=true
# SCALE_DB_HOST=127.0.0.1
# SCALE_DB_PORT=3306
# SCALE_DB_USER=readonly_user
# SCALE_DB_PASSWORD=secret
# SCALE_DB_NAME=workingdb
# SCALE_DB_TABLE=produccion_balanza
# SCALE_SYNC_START_AT=2026-11-01 00:00:00
# SCALE_SYNC_INTERVAL_MS=60000
# SCALE_SYNC_BATCH_SIZE=500
# SCALE_SYNC_MAX_BATCHES=20
# SCALE_SYNC_OVERLAP=50

# ---------------------------------------------------------------------------
# Optional price-analysis scraper
# ---------------------------------------------------------------------------
# Python executable. Defaults to "python"/"py" on Windows and
# "python3"/"python" on macOS and Linux.
# PYTHON_BIN=python
# PRICE_SCRAPER_TIMEOUT_MS=90000
# Relative paths are resolved from the project root.
# PRICE_SCRAPER_SCRIPT=scraper/main.py
