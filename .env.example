# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Generate a long random string for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=erp_user
DB_PASSWORD=secret
DB_NAME=werp_erp

# ---------------------------------------------------------------------------
# Optional SSH tunnel (set DB_SSH_ENABLED=true to use it)
# When enabled the app opens a local port and forwards it through SSH to the
# MySQL server, then connects mysql2 to the forwarded port.
# ---------------------------------------------------------------------------
DB_SSH_ENABLED=false
SSH_HOST=your-server.example.com
SSH_PORT=22
SSH_USER=deploy
# Use either a password or a private key file (not both).
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_PRIVATE_KEY_PASSPHRASE=
# Host/port of MySQL as seen *from the SSH server*
DB_REMOTE_HOST=127.0.0.1
DB_REMOTE_PORT=3306

# Set to true if MySQL requires TLS
DB_SSL=false
