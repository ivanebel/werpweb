{
  "name": "werpweb-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight ERP for small manufacturing companies (Node.js + Express + MySQL + Tailwind/TailAdmin UI)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:css": "tailwindcss -i ./src/assets/tailwind.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/assets/tailwind.css -o ./public/css/app.css --watch",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:seed-pos": "node src/db/seedPos.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js",
    "test:checks": "node tests/checks-test.mjs"
  },
  "dependencies": {
    "apexcharts": "^4.5.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.1",
    "method-override": "^3.0.0",
    "mysql2": "^3.12.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
